import TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue.GraphLattices.OrdinaryProducts
import TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue.GraphLattices.FaithfullyFlatMembership
import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# Base change of ordinary product submodules

The ordinary product image generated after coefficient extension is contained
in the scalar span of the image of the corresponding base product submodule.
This is the algebraic comparison required before faithfully-flat descent; it
does not by itself reflect membership to the base.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue

namespace GraphLattices

variable {R S T A : Type*} [CommRing R] [CommRing S]
  [CommRing T] [CommRing A] [Algebra R T] [Algebra R A] [Algebra S A]

/-- The `S`-submodule generated by the image of an `R`-submodule under a
ring map.  The map is packaged as an `R`-algebra homomorphism so that products
and the base unit are preserved. -/
def scalarExtendedSubmodule
    (S : Type*) [CommRing S] [Algebra S A]
    (extension : T →ₐ[R] A) (submodule : Submodule R T) : Submodule S A :=
  Submodule.span S (extension '' (submodule : Set T))

/-- Products of elements in the scalar extensions of a divisor submodule and
a degree-`k` product submodule lie in the scalar extension of the base
degree-`k+1` product submodule. -/
theorem mul_mem_scalarExtended_ordinaryProductSubmodule
    (extension : T →ₐ[R] A) (divisors : Submodule R T) (k : ℕ)
    (divisor lower : A)
    (divisorMember : divisor ∈ scalarExtendedSubmodule S extension divisors)
    (lowerMember : lower ∈ scalarExtendedSubmodule S extension
      (ordinaryProductSubmodule divisors k)) :
    divisor * lower ∈ scalarExtendedSubmodule S extension
      (ordinaryProductSubmodule divisors (k + 1)) := by
  let target := scalarExtendedSubmodule S extension
    (ordinaryProductSubmodule divisors (k + 1))
  change divisor * lower ∈ target
  refine Submodule.span_induction (p := fun candidate _ ↦
      candidate * lower ∈ target) ?_ ?_ ?_ ?_ divisorMember
  · intro extendedDivisor generator
    rcases generator with ⟨baseDivisor, baseDivisorMember, rfl⟩
    refine Submodule.span_induction (p := fun candidate _ ↦
        extension baseDivisor * candidate ∈ target) ?_ ?_ ?_ ?_
      lowerMember
    · intro extendedLower generator
      rcases generator with ⟨baseLower, baseLowerMember, rfl⟩
      apply Submodule.subset_span
      refine ⟨baseDivisor * baseLower,
        mul_mem_ordinaryProductSubmodule_succ divisors
          baseDivisor baseLower k baseDivisorMember baseLowerMember, ?_⟩
      simp
    · simp [target]
    · intro left right _ _ leftMember rightMember
      simpa [mul_add] using target.add_mem leftMember rightMember
    · intro scalar candidate _ candidateMember
      simpa [Algebra.smul_def, mul_assoc, mul_comm, mul_left_comm] using
        target.smul_mem scalar candidateMember
  · simp [target]
  · intro left right _ _ leftMember rightMember
    simpa [add_mul] using target.add_mem leftMember rightMember
  · intro scalar candidate _ candidateMember
    simpa [Algebra.smul_def, mul_assoc, mul_comm, mul_left_comm] using
      target.smul_mem scalar candidateMember

/-- Degree-by-degree base-change containment for ordinary product images. -/
theorem ordinaryProductSubmodule_scalarExtension_le
    (extension : T →ₐ[R] A) (divisors : Submodule R T) (k : ℕ) :
    ordinaryProductSubmodule (scalarExtendedSubmodule S extension divisors) k ≤
      scalarExtendedSubmodule S extension
        (ordinaryProductSubmodule divisors k) := by
  induction k with
  | zero =>
      apply Submodule.span_le.mpr
      intro element generator
      simp only [Set.mem_singleton_iff] at generator
      subst element
      apply Submodule.subset_span
      refine ⟨1, one_mem_ordinaryProductSubmodule_zero divisors, ?_⟩
      simp
  | succ k inductionHypothesis =>
      apply Submodule.span_le.mpr
      intro product generator
      rcases generator with ⟨divisor, divisorMember, lower, lowerMember, rfl⟩
      exact mul_mem_scalarExtended_ordinaryProductSubmodule
        extension divisors k divisor lower divisorMember
        (inductionHypothesis lowerMember)

/-- Membership in the scalar extension inside the canonical algebra tensor
product gives zero in the tensor product of the quotient. -/
theorem tensorQuotient_zero_of_mem_scalarExtendedSubmodule
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T]
    (submodule : Submodule R T) (element : T)
    (extendedMember :
      Algebra.TensorProduct.includeRight element ∈
        scalarExtendedSubmodule S
          (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := T))
          submodule) :
    TensorProduct.mk R S (T ⧸ submodule) 1
        (Submodule.Quotient.mk element) = 0 := by
  let Source := TensorProduct R S T
  let QuotientTarget := TensorProduct R S (T ⧸ submodule)
  let quotientMap : Source →ₗ[S] QuotientTarget :=
    TensorProduct.AlgebraTensorModule.lTensor S S submodule.mkQ
  have killsExtended : ∀ candidate,
      candidate ∈ scalarExtendedSubmodule S
        (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := T))
        submodule → quotientMap candidate = 0 := by
    intro candidate member
    refine Submodule.span_induction (p := fun value _ ↦ quotientMap value = 0)
      ?_ ?_ ?_ ?_ member
    · intro value generator
      rcases generator with ⟨base, baseMember, rfl⟩
      change quotientMap (1 ⊗ₜ[R] base) = 0
      rw [TensorProduct.AlgebraTensorModule.lTensor_tmul]
      have baseZero : submodule.mkQ base = 0 := by
        exact (Submodule.Quotient.mk_eq_zero submodule).mpr baseMember
      rw [baseZero]
      simp
    · exact map_zero quotientMap
    · intro left right _ _ leftZero rightZero
      simp [map_add, leftZero, rightZero]
    · intro scalar value _ valueZero
      simp [map_smul, valueZero]
  have killed :=
    killsExtended (Algebra.TensorProduct.includeRight element) extendedMember
  change quotientMap (1 ⊗ₜ[R] element) = 0 at killed
  rw [TensorProduct.AlgebraTensorModule.lTensor_tmul] at killed
  exact killed

/-- Faithfully flat reflection of membership from the scalar-extended
submodule in the canonical algebra tensor product. -/
theorem mem_submodule_of_mem_scalarExtendedSubmodule
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Module.FaithfullyFlat R S]
    (submodule : Submodule R T) (element : T)
    (extendedMember :
      Algebra.TensorProduct.includeRight element ∈
        scalarExtendedSubmodule S
          (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := T))
          submodule) :
    element ∈ submodule :=
  mem_submodule_of_faithfullyFlat_tensor_quotient_zero submodule element
    (tensorQuotient_zero_of_mem_scalarExtendedSubmodule
      submodule element extendedMember)

/-- The canonical map into an algebra tensor product is injective under a
faithfully flat coefficient extension. -/
theorem tensorProduct_includeRight_injective_of_faithfullyFlat
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Module.FaithfullyFlat R S] :
    Function.Injective
      (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := T)) := by
  intro left right equality
  apply Module.FaithfullyFlat.tensorProduct_mk_injective
    (A := R) (B := S) T
  simpa [Algebra.TensorProduct.includeRight_apply] using equality

end GraphLattices

end TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue
