import TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue.GraphLattices.RankOneGeneration
import Mathlib.LinearAlgebra.Matrix.StdBasis
import Mathlib.Tactic

/-!
# Finite symmetric matrix-of-ideals lattices

This module upgrades the two-coordinate calculation to an arbitrary finite
linearly ordered index type.  It defines the weighted symmetric lattice and
its submodule generated by rank-one forms that already lie in the lattice.
The constructive theorem proves the sufficiency of all pairwise midpoint
inequalities without division by two.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue

namespace GraphLattices

open scoped BigOperators

variable {Index R : Type*} [DecidableEq Index] [CommRing R]

/-- The symmetric rank-one matrix with scalar coefficient `coefficient` and
coordinate vector `vector`. -/
def matrixRankOne (coefficient : R) (vector : Index → R) : Matrix Index Index R :=
  fun row column ↦ coefficient * vector row * vector column

/-- Membership in a symmetric matrix-of-ideals lattice with prescribed
diagonal and cross depths. -/
def MemWeightedMatrix
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (form : Matrix Index Index R) : Prop :=
  form.IsSymm ∧
    (∀ index, uniformizer ^ diagonal index ∣ form index index) ∧
    ∀ row column, row ≠ column →
      uniformizer ^ cross row column ∣ form row column

/-- The symmetric matrix-of-ideals lattice as an actual submodule of the
ambient matrix module. -/
def weightedMatrixSubmodule
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ) :
    Submodule R (Matrix Index Index R) where
  carrier := {form | MemWeightedMatrix uniformizer diagonal cross form}
  zero_mem' := by
    constructor
    · ext row column
      simp [Matrix.transpose_apply]
    constructor
    · intro index
      exact dvd_zero _
    · intro row column _
      exact dvd_zero _
  add_mem' := by
    intro left right leftMember rightMember
    rcases leftMember with ⟨leftSymmetric, leftDiagonal, leftCross⟩
    rcases rightMember with ⟨rightSymmetric, rightDiagonal, rightCross⟩
    constructor
    · ext row column
      simpa [Matrix.transpose_apply] using
        congrArg (fun matrix ↦ matrix row column)
          (congrArg₂ (· + ·) leftSymmetric rightSymmetric)
    constructor
    · intro index
      simpa using (leftDiagonal index).add (rightDiagonal index)
    · intro row column distinct
      simpa using (leftCross row column distinct).add
        (rightCross row column distinct)
  smul_mem' := by
    intro scalar form member
    rcases member with ⟨symmetric, diagonalDivisible, crossDivisible⟩
    constructor
    · ext row column
      simp only [Matrix.transpose_apply, Matrix.smul_apply]
      rw [show form column row = form row column by
        simpa [Matrix.IsSymm, Matrix.transpose_apply] using
          congrFun (congrFun symmetric row) column]
    constructor
    · intro index
      exact (diagonalDivisible index).mul_left scalar
    · intro row column distinct
      exact (crossDivisible row column distinct).mul_left scalar

/-- Rank-one matrices that themselves belong to the weighted lattice. -/
def weightedRankOneSet
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ) :
    Set (Matrix Index Index R) :=
  {form | ∃ coefficient vector,
    form = matrixRankOne coefficient vector ∧
      MemWeightedMatrix uniformizer diagonal cross form}

/-- The submodule generated by rank-one matrices internal to the weighted
lattice. -/
def weightedRankOneSpan
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ) :
    Submodule R (Matrix Index Index R) :=
  Submodule.span R (weightedRankOneSet uniformizer diagonal cross)

omit [DecidableEq Index] in
/-- The span of internal rank-one matrices remains inside the weighted
matrix-of-ideals lattice. -/
theorem weightedRankOneSpan_le_weightedMatrixSubmodule
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ) :
    weightedRankOneSpan uniformizer diagonal cross ≤
      weightedMatrixSubmodule uniformizer diagonal cross := by
  apply Submodule.span_le.mpr
  intro form generator
  rcases generator with ⟨_, _, _, member⟩
  exact member

/-- Exact rank-one generation means equality between the weighted lattice and
the span of the rank-one matrices that already belong to it. -/
def WeightedMatrixRankOneGenerated
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ) : Prop :=
  weightedMatrixSubmodule uniformizer diagonal cross =
    weightedRankOneSpan uniformizer diagonal cross

/-- The coordinate vector supported at one index. -/
def coordinateVector (index : Index) : Index → R :=
  fun position ↦ if position = index then 1 else 0

/-- A symmetric matrix supported on one diagonal entry. -/
def diagonalAtom (index : Index) (coefficient : R) : Matrix Index Index R :=
  fun row column ↦ if row = index ∧ column = index then coefficient else 0

/-- A symmetric matrix supported on the two ordered cross entries belonging to
one unordered pair. -/
def crossAtom (first second : Index) (coefficient : R) : Matrix Index Index R :=
  fun row column ↦
    if (row = first ∧ column = second) ∨
        (row = second ∧ column = first) then coefficient else 0

/-- The cross atom at the prescribed cross depth belongs to the weighted
lattice when the cross-depth function is symmetric. -/
theorem crossAtom_uniformizerPower_mem_weightedMatrix
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (crossSymmetric : ∀ row column, cross row column = cross column row)
    {first second : Index} (distinct : first ≠ second) :
    MemWeightedMatrix uniformizer diagonal cross
      (crossAtom first second (uniformizer ^ cross first second)) := by
  constructor
  · ext row column
    simp only [Matrix.transpose_apply, crossAtom]
    aesop
  constructor
  · intro index
    by_cases index = first <;> by_cases index = second <;>
      simp_all [crossAtom, dvd_zero]
  · intro row column rowNeColumn
    by_cases forward : row = first ∧ column = second
    · rcases forward with ⟨rfl, rfl⟩
      simp [crossAtom]
    · by_cases reverse : row = second ∧ column = first
      · have depthEquality := crossSymmetric second first
        rcases reverse with ⟨rfl, rfl⟩
        rw [depthEquality]
        simp [crossAtom, distinct]
      · simp [crossAtom, forward, reverse, dvd_zero]

/-- A one-coordinate rank-one matrix is exactly the corresponding diagonal
atom. -/
theorem matrixRankOne_coordinateVector
    (index : Index) (coefficient : R) :
    matrixRankOne coefficient (coordinateVector index) =
      diagonalAtom index coefficient := by
  ext row column
  by_cases row = index <;> by_cases column = index <;>
    simp_all [matrixRankOne, coordinateVector, diagonalAtom]

/-- A divisible diagonal atom is an internal rank-one generator. -/
theorem diagonalAtom_mem_weightedRankOneSet
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (index : Index) (coefficient : R)
    (divisible : uniformizer ^ diagonal index ∣ coefficient) :
    diagonalAtom index coefficient ∈
      weightedRankOneSet uniformizer diagonal cross := by
  refine ⟨coefficient, coordinateVector index, (matrixRankOne_coordinateVector _ _).symm, ?_⟩
  constructor
  · ext row column
    by_cases row = index <;> by_cases column = index <;>
      simp_all [Matrix.transpose_apply, diagonalAtom]
  constructor
  · intro position
    by_cases position = index
    · subst position
      simpa [diagonalAtom] using divisible
    · simp [diagonalAtom, *, dvd_zero]
  · intro row column distinct
    by_cases row = index <;> by_cases column = index <;>
      simp_all [diagonalAtom, dvd_zero]

/-- Hence every divisible diagonal atom lies in the internal rank-one span. -/
theorem diagonalAtom_mem_weightedRankOneSpan
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (index : Index) (coefficient : R)
    (divisible : uniformizer ^ diagonal index ∣ coefficient) :
    diagonalAtom index coefficient ∈
      weightedRankOneSpan uniformizer diagonal cross :=
  Submodule.subset_span
    (diagonalAtom_mem_weightedRankOneSet
      uniformizer diagonal cross index coefficient divisible)

/-- The vector supported on a pair with the displayed powered coordinates. -/
def poweredPairVector
    (uniformizer : R) (first second : Index) (firstPower secondPower : ℕ) :
    Index → R :=
  fun position ↦
    if position = first then uniformizer ^ firstPower
    else if position = second then uniformizer ^ secondPower
    else 0

/-- A supported rank-one matrix belongs to the full weighted lattice when the
two diagonal bounds and the one cross bound hold. -/
theorem supportedPair_rankOne_mem
    (uniformizer scalar : R)
    (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (crossSymmetric : ∀ row column, cross row column = cross column row)
    {first second : Index} (distinct : first ≠ second)
    (t firstPower secondPower : ℕ)
    (firstBound : diagonal first ≤ t + 2 * firstPower)
    (secondBound : diagonal second ≤ t + 2 * secondPower)
    (crossBound : cross first second ≤ t + firstPower + secondPower) :
    MemWeightedMatrix uniformizer diagonal cross
      (matrixRankOne (scalar * uniformizer ^ t)
        (poweredPairVector uniformizer first second firstPower secondPower)) := by
  constructor
  · ext row column
    simp only [Matrix.transpose_apply, matrixRankOne]
    ring
  constructor
  · intro position
    by_cases position = first
    · subst position
      have divides := SymmetricPair.pow_dvd_scalar_mul_pow
        uniformizer scalar firstBound
      simpa [matrixRankOne, poweredPairVector, distinct, pow_add, pow_mul, pow_two,
        mul_assoc, mul_left_comm, mul_comm] using divides
    · by_cases position = second
      · subst position
        have divides := SymmetricPair.pow_dvd_scalar_mul_pow
          uniformizer scalar secondBound
        simpa [matrixRankOne, poweredPairVector, distinct, distinct.symm,
          pow_add, pow_mul, pow_two,
          mul_assoc, mul_left_comm, mul_comm] using divides
      · simp [matrixRankOne, poweredPairVector, *, dvd_zero]
  · intro row column rowNeColumn
    by_cases row = first
    · subst row
      by_cases column = second
      · subst column
        have divides := SymmetricPair.pow_dvd_scalar_mul_pow
          uniformizer scalar crossBound
        simpa [matrixRankOne, poweredPairVector, distinct, distinct.symm, pow_add,
          mul_assoc, mul_left_comm, mul_comm] using divides
      · simp [matrixRankOne, poweredPairVector, Ne.symm rowNeColumn, *, dvd_zero]
    · by_cases row = second
      · subst row
        by_cases column = first
        · subst column
          have reverseBound : cross second first ≤ t + firstPower + secondPower := by
            rw [crossSymmetric second first]
            exact crossBound
          have divides := SymmetricPair.pow_dvd_scalar_mul_pow
            uniformizer scalar reverseBound
          simpa [matrixRankOne, poweredPairVector, distinct, distinct.symm, pow_add,
            mul_assoc, mul_left_comm, mul_comm] using divides
        · simp [matrixRankOne, poweredPairVector, Ne.symm rowNeColumn, *, dvd_zero]
      · simp [matrixRankOne, poweredPairVector, *, dvd_zero]

/-- Under the midpoint inequality, every multiple of one cross-ideal
generator lies in the internal rank-one span.  The proof is the same
division-free three-term subtraction as in the two-coordinate calculation,
now embedded into the full matrix. -/
theorem crossAtom_mem_weightedRankOneSpan_of_midpoint
    (uniformizer scalar : R)
    (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (crossSymmetric : ∀ row column, cross row column = cross column row)
    {first second : Index} (distinct : first ≠ second)
    (midpoint : diagonal first + diagonal second ≤ 2 * cross first second) :
    crossAtom first second (scalar * uniformizer ^ cross first second) ∈
      weightedRankOneSpan uniformizer diagonal cross := by
  obtain ⟨t, firstPower, secondPower, firstBound, secondBound, crossExponent⟩ :=
    exists_midpoint_exponents
      (diagonal first) (diagonal second) (cross first second) midpoint
  let vector := poweredPairVector uniformizer first second firstPower secondPower
  let main := matrixRankOne (scalar * uniformizer ^ t) vector
  let firstCorrection :=
    diagonalAtom first
      ((scalar * uniformizer ^ t) * uniformizer ^ firstPower * uniformizer ^ firstPower)
  let secondCorrection :=
    diagonalAtom second
      ((scalar * uniformizer ^ t) * uniformizer ^ secondPower * uniformizer ^ secondPower)
  have mainMember : MemWeightedMatrix uniformizer diagonal cross main := by
    dsimp [main, vector]
    exact supportedPair_rankOne_mem uniformizer scalar diagonal cross crossSymmetric
      distinct t firstPower secondPower firstBound secondBound
      (le_of_eq crossExponent)
  have mainSpan : main ∈ weightedRankOneSpan uniformizer diagonal cross := by
    change main ∈ Submodule.span R (weightedRankOneSet uniformizer diagonal cross)
    apply Submodule.subset_span
    exact ⟨scalar * uniformizer ^ t, vector, rfl, mainMember⟩
  have firstDivisible :
      uniformizer ^ diagonal first ∣
        (scalar * uniformizer ^ t) * uniformizer ^ firstPower *
          uniformizer ^ firstPower := by
    have divides := SymmetricPair.pow_dvd_scalar_mul_pow
      uniformizer scalar firstBound
    simpa [pow_add, pow_mul, pow_two, mul_assoc, mul_left_comm, mul_comm] using divides
  have secondDivisible :
      uniformizer ^ diagonal second ∣
        (scalar * uniformizer ^ t) * uniformizer ^ secondPower *
          uniformizer ^ secondPower := by
    have divides := SymmetricPair.pow_dvd_scalar_mul_pow
      uniformizer scalar secondBound
    simpa [pow_add, pow_mul, pow_two, mul_assoc, mul_left_comm, mul_comm] using divides
  have firstSpan : firstCorrection ∈ weightedRankOneSpan uniformizer diagonal cross := by
    exact diagonalAtom_mem_weightedRankOneSpan uniformizer diagonal cross first _
      firstDivisible
  have secondSpan : secondCorrection ∈ weightedRankOneSpan uniformizer diagonal cross := by
    exact diagonalAtom_mem_weightedRankOneSpan uniformizer diagonal cross second _
      secondDivisible
  have identity :
      main - firstCorrection - secondCorrection =
        crossAtom first second (scalar * uniformizer ^ cross first second) := by
    ext row column
    dsimp [main, firstCorrection, secondCorrection, vector]
    by_cases row = first <;> by_cases row = second <;>
      by_cases column = first <;> by_cases column = second <;>
      simp_all [matrixRankOne, poweredPairVector, diagonalAtom, crossAtom, pow_add]
      <;> ring
  rw [← identity]
  exact Submodule.sub_mem _ (Submodule.sub_mem _ mainSpan firstSpan) secondSpan

section FiniteAssembly

variable [Fintype Index] [LinearOrder Index]

/-- A finite symmetric matrix is the sum of its diagonal atoms and one cross
atom for each strictly ordered pair. -/
theorem symmetric_eq_sum_diagonalAtom_add_sum_crossAtom
    (form : Matrix Index Index R) (symmetric : form.IsSymm) :
    form =
      (∑ index, diagonalAtom index (form index index)) +
        ∑ first, ∑ second ∈ Finset.univ.filter (first < ·),
          crossAtom first second (form first second) := by
  ext row column
  have diagonalOff (different : row ≠ column) :
      (∑ index, diagonalAtom index (form index index)) row column = 0 := by
    rw [Matrix.sum_apply]
    apply Finset.sum_eq_zero
    intro index _
    by_cases row = index <;> by_cases column = index <;>
      simp_all [diagonalAtom]
  have crossAtDiagonal (index : Index) :
      (∑ first, ∑ second ∈ Finset.univ.filter (first < ·),
        crossAtom first second (form first second)) index index = 0 := by
    rw [Matrix.sum_apply]
    apply Finset.sum_eq_zero
    intro first _
    rw [Matrix.sum_apply]
    apply Finset.sum_eq_zero
    intro second membership
    have ordered : first < second := (Finset.mem_filter.mp membership).2
    by_cases index = first <;> by_cases index = second <;>
      simp_all [crossAtom]
  have crossForward {left right : Index} (ordered : left < right) :
      (∑ first, ∑ second ∈ Finset.univ.filter (first < ·),
        crossAtom first second (form first second)) left right = form left right := by
    rw [Matrix.sum_apply, Finset.sum_eq_single left]
    · rw [Matrix.sum_apply, Finset.sum_eq_single right]
      · simp [crossAtom]
      · intro candidate membership candidateNe
        by_cases left = candidate <;> by_cases right = candidate <;>
          simp_all [crossAtom]
      · simp [ordered]
    · intro candidate _ candidateNe
      rw [Matrix.sum_apply]
      apply Finset.sum_eq_zero
      intro second membership
      have candidateBeforeSecond : candidate < second := (Finset.mem_filter.mp membership).2
      simp only [crossAtom]
      split
      · rename_i supported
        rcases supported with forward | reverse
        · exact (candidateNe forward.1.symm).elim
        · rcases reverse with ⟨rfl, rfl⟩
          exact (lt_asymm ordered candidateBeforeSecond).elim
      · rfl
    · simp
  by_cases same : row = column
  · subst column
    rw [Matrix.add_apply, crossAtDiagonal]
    simp only [add_zero]
    rw [Matrix.sum_apply, Finset.sum_eq_single row]
    · simp [diagonalAtom]
    · intro candidate _ candidateNe
      simp [diagonalAtom, Ne.symm candidateNe]
    · simp
  · rcases lt_or_gt_of_ne same with before | after
    · rw [Matrix.add_apply, diagonalOff same, crossForward before, zero_add]
    · have reverse : form column row = form row column := by
        simpa [Matrix.IsSymm, Matrix.transpose_apply] using
          congrFun (congrFun symmetric row) column
      have crossReverse := crossForward (left := column) (right := row) after
      rw [Matrix.add_apply, diagonalOff same, zero_add]
      simpa [crossAtom, Matrix.sum_apply, and_comm, or_comm, reverse] using
        crossReverse.symm

/-- If every pair of depths satisfies the midpoint inequality, every member
of the finite symmetric matrix-of-ideals lattice belongs to the submodule
generated by rank-one forms internal to that same lattice. -/
theorem mem_weightedRankOneSpan_of_pairwise_midpoint
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (crossSymmetric : ∀ row column, cross row column = cross column row)
    (midpoint : ∀ first second, first ≠ second →
      diagonal first + diagonal second ≤ 2 * cross first second)
    (form : Matrix Index Index R)
    (member : MemWeightedMatrix uniformizer diagonal cross form) :
    form ∈ weightedRankOneSpan uniformizer diagonal cross := by
  rcases member with ⟨symmetric, diagonalDivisible, crossDivisible⟩
  rw [symmetric_eq_sum_diagonalAtom_add_sum_crossAtom form symmetric]
  apply Submodule.add_mem
  · apply Submodule.sum_mem
    intro index _
    exact diagonalAtom_mem_weightedRankOneSpan uniformizer diagonal cross
      index (form index index) (diagonalDivisible index)
  · apply Submodule.sum_mem
    intro first _
    apply Submodule.sum_mem
    intro second membership
    have ordered : first < second := (Finset.mem_filter.mp membership).2
    have distinct : first ≠ second := ne_of_lt ordered
    obtain ⟨scalar, coefficientEquality⟩ := crossDivisible first second distinct
    have crossSpan := crossAtom_mem_weightedRankOneSpan_of_midpoint
      uniformizer scalar diagonal cross crossSymmetric distinct
      (midpoint first second distinct)
    simpa [coefficientEquality, mul_comm] using crossSpan

/-- Pairwise midpoint inequalities imply exact equality between the finite
weighted lattice and its internal rank-one span. -/
theorem weightedMatrixRankOneGenerated_of_pairwise_midpoint
    (uniformizer : R) (diagonal : Index → ℕ) (cross : Index → Index → ℕ)
    (crossSymmetric : ∀ row column, cross row column = cross column row)
    (midpoint : ∀ first second, first ≠ second →
      diagonal first + diagonal second ≤ 2 * cross first second) :
    WeightedMatrixRankOneGenerated uniformizer diagonal cross := by
  apply le_antisymm
  · intro form member
    exact mem_weightedRankOneSpan_of_pairwise_midpoint
      uniformizer diagonal cross crossSymmetric midpoint form member
  · exact weightedRankOneSpan_le_weightedMatrixSubmodule
      uniformizer diagonal cross

end FiniteAssembly

end GraphLattices

end TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue
