import Mathlib.Tactic
import Mathlib.LinearAlgebra.Eigenspace.Basic
import TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue.Quantum.QuarticDiscriminantDerivations
import TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue.Quantum.AtomicResidueDiscriminant

/-!
# Spectral data under sign reversal of an endomorphism

The residual endomorphism of the quantum connection in the loop coordinate and
Euler multiplication differ by a sign.  Everything the manuscript reads off one
of them is therefore read off the other after negating eigenvalues, and this
module proves that dictionary as linear algebra over a commutative ring.

For an endomorphism `f` of a module and a scalar `lam`, the kernel of the `k`-th
power of `-f - (-lam)` is the kernel of the `k`-th power of `f - lam`, because
the two operators differ by the sign `(-1) ^ k`; this is the equality of
generalized eigenspaces at `lam` for `f` and at `-lam` for `-f`, for every
exponent, hence also of their dimensions and of the Jordan block sizes they
record.  The eigenvalue set of `-f` is the image of the eigenvalue set of `f`
under negation, so the two sets have the same cardinality.  The submodule
generated by the orbit of a vector is the same for `f` and for `-f`, so a vector
is cyclic for one exactly when it is cyclic for the other, which is regularity
of the endomorphism.

Finally the discriminant of the characteristic polynomial is unchanged.  Every
monomial of the universal quartic discriminant has even total degree in the two
odd characteristic coefficients, and negating the roots of a monic quartic
negates exactly those two coefficients.  In rank two the same holds for the
residue discriminant `(trace R) ^ 2 - 4 * det R`, since sign reversal negates the
trace and fixes the determinant.

Lean constructs no `F`-bundle, no `F`-manifold, and no spectral cover here; the
statements are about an endomorphism of a module and about the coefficients of a
monic quartic.  That the residual endomorphism of the `A`-model connection is
the negative of Euler multiplication is the manuscript's reading of the
connection, and is not proved here.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue

namespace Quantum

section Endomorphism

variable {K V : Type*} [CommRing K] [AddCommGroup V] [Module K V]

/-- Negating an endomorphism does not change the kernel of a power of it: the
`k`-th power of the negated endomorphism is the `k`-th power of the original one
up to the sign `(-1) ^ k`. -/
theorem ker_pow_neg (g : Module.End K V) (k : ℕ) :
    LinearMap.ker ((-g) ^ k) = LinearMap.ker (g ^ k) := by
  rcases Nat.even_or_odd k with hk | hk
  · rw [hk.neg_pow]
  · rw [hk.neg_pow, LinearMap.ker_neg]

/-- Generalized eigenspaces correspond under sign reversal.  For every exponent
`k`, the kernel of the `k`-th power of `-f - (-lam)` is the kernel of the `k`-th
power of `f - lam`: the generalized eigenspace of `-f` at `-lam` and the
generalized eigenspace of `f` at `lam` are the same submodule.  In particular the
two decompositions have the same summand dimensions and the same filtration by
the exponent, which is the equality of Jordan block sizes. -/
theorem generalizedEigenspace_neg (f : Module.End K V) (lam : K) (k : ℕ) :
    LinearMap.ker ((-f - (-lam) • (1 : Module.End K V)) ^ k) =
      LinearMap.ker ((f - lam • (1 : Module.End K V)) ^ k) := by
  have rewriting : -f - (-lam) • (1 : Module.End K V) = -(f - lam • (1 : Module.End K V)) := by
    rw [neg_smul]
    abel
  rw [rewriting, ker_pow_neg]

/-- The eigenvalue set of the negated endomorphism is the image of the eigenvalue
set of the original one under negation. -/
theorem eigenvalues_neg (f : Module.End K V) :
    {mu : K | ∃ v : V, v ≠ 0 ∧ (-f) v = mu • v} =
      Neg.neg '' {lam : K | ∃ v : V, v ≠ 0 ∧ f v = lam • v} := by
  have key : ∀ (mu : K) (v : V), ((-f) v = mu • v ↔ f v = (-mu) • v) := by
    intro mu v
    rw [LinearMap.neg_apply, neg_eq_iff_eq_neg, ← neg_smul]
  ext mu
  simp only [Set.mem_setOf_eq, Set.mem_image]
  constructor
  · rintro ⟨v, hv, hmu⟩
    exact ⟨-mu, ⟨v, hv, (key mu v).mp hmu⟩, neg_neg mu⟩
  · rintro ⟨lam, ⟨v, hv, hlam⟩, rfl⟩
    exact ⟨v, hv, (key (-lam) v).mpr (by rwa [neg_neg])⟩

/-- Sign reversal does not change the number of distinct eigenvalues, because
negation is injective on scalars. -/
theorem eigenvalues_neg_ncard (f : Module.End K V) :
    {mu : K | ∃ v : V, v ≠ 0 ∧ (-f) v = mu • v}.ncard =
      {lam : K | ∃ v : V, v ≠ 0 ∧ f v = lam • v}.ncard := by
  rw [eigenvalues_neg, Set.ncard_image_of_injective _ neg_injective]

/-- One half of the equality of orbit submodules under sign reversal. -/
private theorem span_orbit_neg_le (f : Module.End K V) (v : V) :
    Submodule.span K (Set.range fun k : ℕ => ((-f) ^ k) v) ≤
      Submodule.span K (Set.range fun k : ℕ => (f ^ k) v) := by
  rw [Submodule.span_le]
  rintro _ ⟨k, rfl⟩
  show ((-f) ^ k) v ∈ Submodule.span K (Set.range fun k : ℕ => (f ^ k) v)
  rcases Nat.even_or_odd k with hk | hk
  · rw [hk.neg_pow]
    exact Submodule.subset_span ⟨k, rfl⟩
  · rw [hk.neg_pow, LinearMap.neg_apply]
    exact Submodule.neg_mem _ (Submodule.subset_span ⟨k, rfl⟩)

/-- The submodule generated by the orbit of a vector is the same for an
endomorphism and for its negative.  A vector is therefore cyclic for one exactly
when it is cyclic for the other, so one endomorphism is regular exactly when the
other is. -/
theorem span_orbit_neg (f : Module.End K V) (v : V) :
    Submodule.span K (Set.range fun k : ℕ => ((-f) ^ k) v) =
      Submodule.span K (Set.range fun k : ℕ => (f ^ k) v) := by
  refine le_antisymm (span_orbit_neg_le f v) ?_
  have reversed := span_orbit_neg_le (-f) v
  rwa [neg_neg] at reversed

end Endomorphism

section Discriminant

variable {A : Type*} [CommRing A]

/-- The discriminant of a monic quartic is unchanged when its two odd
characteristic coefficients are negated: every monomial of the universal quartic
discriminant has even total degree in those two coefficients. -/
theorem quarticDiscriminant_neg_odd_coefficients (l₀ l₁ l₂ l₃ : A) :
    quarticDiscriminant l₀ (-l₁) l₂ (-l₃) = quarticDiscriminant l₀ l₁ l₂ l₃ := by
  unfold quarticDiscriminant
  ring

/-- Negating all four roots of a split monic quartic leaves its discriminant
unchanged.  The characteristic coefficients of the negated roots are the signed
elementary symmetric functions displayed on the left, and the two sides are the
squared products of the pairwise differences of the negated and of the original
roots. -/
theorem quarticDiscriminant_neg_roots (r₀ r₁ r₂ r₃ : A) :
    quarticDiscriminant ((-r₀) * (-r₁) * (-r₂) * (-r₃))
        (-((-r₀) * (-r₁) * (-r₂) + (-r₀) * (-r₁) * (-r₃) + (-r₀) * (-r₂) * (-r₃) +
          (-r₁) * (-r₂) * (-r₃)))
        ((-r₀) * (-r₁) + (-r₀) * (-r₂) + (-r₀) * (-r₃) + (-r₁) * (-r₂) + (-r₁) * (-r₃) +
          (-r₂) * (-r₃))
        (-((-r₀) + (-r₁) + (-r₂) + (-r₃))) =
      quarticDiscriminant (r₀ * r₁ * r₂ * r₃)
        (-(r₀ * r₁ * r₂ + r₀ * r₁ * r₃ + r₀ * r₂ * r₃ + r₁ * r₂ * r₃))
        (r₀ * r₁ + r₀ * r₂ + r₀ * r₃ + r₁ * r₂ + r₁ * r₃ + r₂ * r₃)
        (-(r₀ + r₁ + r₂ + r₃)) := by
  rw [quarticDiscriminant_eq_squared_root_differences,
    quarticDiscriminant_eq_squared_root_differences]
  ring

/-- The residue discriminant of a two-by-two residue is unchanged by sign
reversal: the trace changes sign and its square does not, and the determinant of
a two-by-two matrix is unchanged.  The rank-two invariant of the manuscript can
therefore be read from the residual endomorphism of the connection or from Euler
multiplication without distinction. -/
theorem residueDiscriminant_neg (R : Matrix (Fin 2) (Fin 2) A) :
    residueDiscriminant (-R) = residueDiscriminant R := by
  have traceReversed : Matrix.trace (-R) = -Matrix.trace R := by simp
  have determinantUnchanged : (-R).det = R.det := by
    rw [Matrix.det_neg]
    simp
  rw [residueDiscriminant, residueDiscriminant, traceReversed, determinantUnchanged]
  ring

end Discriminant

end Quantum

end TavisRuddFiniteGeom.Papers.CubicStabilizationEpilogue
