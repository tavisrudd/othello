// Primary exact ideal checks for C595.  Tested with Singular 4.4.1.
LIB "primdec.lib";

proc coefficientIdeal()
{
  poly c0=x*d0+y*d1;
  poly c1=x*d1+y*d2;
  poly c2=x*d2+y*d3;
  poly c3=x*d3+y*d4;
  poly c4=x*d4+y*d5;
  ideal V=
    2*c3^3-3*c2*c3*c4+c1*c4^2,
    6*c2*c3^2-9*c2^2*c4+2*c1*c3*c4+c0*c4^2,
    2*c1*c3^2-3*c1*c2*c4+c0*c3*c4,
    c0*c3^2-c1^2*c4,
    2*c1^2*c3-3*c0*c2*c3+c0*c1*c4,
    6*c1^2*c2-9*c0*c2^2+2*c0*c1*c3+c0^2*c4,
    2*c1^3-3*c0*c1*c2+c0^2*c3;
  matrix M=coef(V,x*y);
  ideal F;
  int row_index;
  int column_index;
  for (row_index=2; row_index<=nrows(M); row_index++)
  {
    for (column_index=1; column_index<=ncols(M); column_index++)
    {
      if (M[row_index,column_index]<>0)
      {
        F[size(F)+1]=M[row_index,column_index];
      }
    }
  }
  return(F);
}

proc persistentIdeal()
{
  matrix C[3][4]=d0,d1,d2,d3,d1,d2,d3,d4,d2,d3,d4,d5;
  return(minor(C,3));
}

proc rankOneIdeal()
{
  matrix C[2][5]=d0,d1,d2,d3,d4,d1,d2,d3,d4,d5;
  return(minor(C,2));
}

proc sameIdeal(ideal I, ideal J)
{
  ideal GI=std(I);
  ideal GJ=std(J);
  return(size(reduce(I,GJ))==0 && size(reduce(J,GI))==0);
}

proc characteristicZero()
{
  ring R=0,(x,y,d0,d1,d2,d3,d4,d5),dp;
  ideal F=coefficientIdeal();
  ideal H=persistentIdeal();
  ideal R1=rankOneIdeal();
  if (size(F)<>28) { ERROR("C595: wrong coefficient count over Q"); }
  if (size(reduce(H,std(F)))<>0)
  {
    ERROR("C595: cleared generic containment failed");
  }
  list associated=minAssGTZ(std(F));
  if (size(associated)<>1 || !sameIdeal(associated[1],R1))
  {
    ERROR("C595: generic cyclic Fano prime is not rank one");
  }
}

proc characteristicTwo()
{
  ring R=2,(x,y,d0,d1,d2,d3,d4,d5),dp;
  ideal F=coefficientIdeal();
  ideal H=persistentIdeal();
  ideal modular=d0,d1,d4,d5;
  ideal vertical=
    d3*d4+d2*d5,
    d1*d4+d0*d5,
    d3^2+d1*d5,
    d2*d3+d0*d5,
    d2^2+d0*d4,
    d1*d2+d0*d3;
  list associated=minAssGTZ(std(F));
  if (size(associated)<>2)
  {
    ERROR("C595: wrong number of characteristic-two components");
  }
  int found_modular=0;
  int found_vertical=0;
  int component_index;
  for (component_index=1; component_index<=2; component_index++)
  {
    if (sameIdeal(associated[component_index],modular)) { found_modular=1; }
    if (sameIdeal(associated[component_index],vertical)) { found_vertical=1; }
  }
  if (!found_modular || !found_vertical)
  {
    ERROR("C595: characteristic-two components changed");
  }
  if (size(reduce(H,std(vertical)))<>0)
  {
    ERROR("C595: vertical component escaped the persistent ideal");
  }
  if (size(reduce(ideal(H[1]),std(F)))==0)
  {
    ERROR("C595: the factor 2 is not detected by the first minor");
  }

  // Direct Fano pullback of the true binary cyclic plane c0=c4=0.
  ideal binary_plane=d0,d1,d4,d5;
  if (!sameIdeal(binary_plane,modular))
  {
    ERROR("C595: binary plane regression failed");
  }
}

proc characteristicThree()
{
  ring R=3,(x,y,d0,d1,d2,d3,d4,d5),dp;
  ideal F=coefficientIdeal();
  ideal H=persistentIdeal();
  ideal R1=rankOneIdeal();
  list associated=minAssGTZ(std(F));
  if (size(associated)<>1 || !sameIdeal(associated[1],R1))
  {
    ERROR("C595: characteristic-three wild regression failed");
  }
  if (size(reduce(ideal(H[1]),std(F)))==0)
  {
    ERROR("C595: the factor 3 is not detected by the first minor");
  }
}

proc characteristicFive()
{
  ring R=5,(x,y,d0,d1,d2,d3,d4,d5),dp;
  ideal F=coefficientIdeal();
  ideal R1=rankOneIdeal();
  list associated=minAssGTZ(std(F));
  if (size(associated)<>1 || !sameIdeal(associated[1],R1))
  {
    ERROR("C595: generic-prime control failed");
  }
}

proc rSevenPersistent()
{
  ring R=0,(x,y,a0,a1,a2,a3,a4,a5,a6),dp;
  matrix lower[3][4]=
    x*a0+y*a1,x*a1+y*a2,x*a2+y*a3,x*a3+y*a4,
    x*a1+y*a2,x*a2+y*a3,x*a3+y*a4,x*a4+y*a5,
    x*a2+y*a3,x*a3+y*a4,x*a4+y*a5,x*a5+y*a6;
  ideal pulled=minor(lower,3);
  matrix coefficients=coef(pulled,x*y);
  ideal J;
  int row_index;
  int column_index;
  for (row_index=2; row_index<=nrows(coefficients); row_index++)
  {
    for (column_index=1; column_index<=ncols(coefficients); column_index++)
    {
      if (coefficients[row_index,column_index]<>0)
      {
        J[size(J)+1]=coefficients[row_index,column_index];
      }
    }
  }
  matrix upper[3][5]=
    a0,a1,a2,a3,a4,
    a1,a2,a3,a4,a5,
    a2,a3,a4,a5,a6;
  ideal I=minor(upper,3);
  if (!sameIdeal(I,J))
  {
    ERROR("C595: R7 persistent regression J_6=I_6 failed");
  }
}

proc rSevenBinary()
{
  ring R=2,(x,y,a0,a1,a2,a3,a4,a5,a6),dp;
  // Both consecutive contractions lie in <e2,e3>.
  ideal pullback=a0,a1,a2,a4,a5,a6;
  ideal central=a0,a1,a2,a4,a5,a6;
  if (!sameIdeal(pullback,central))
  {
    ERROR("C595: R7 central-point regression failed");
  }
}

characteristicZero();
characteristicTwo();
characteristicThree();
characteristicFive();
rSevenPersistent();
rSevenBinary();
print("C595 Singular certificate OK: Q/F2/F3/F5 and R6/R7 regressions");
