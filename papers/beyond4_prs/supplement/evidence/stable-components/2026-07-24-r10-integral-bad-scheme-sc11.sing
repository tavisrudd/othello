// Primary exact ideal checks for STABLE_COMPONENT_FIBRES.  Tested with Singular 4.4.1.
LIB "primdec.lib";

proc sameIdeal(ideal I, ideal J)
{
  ideal GI=std(I);
  ideal GJ=std(J);
  return(size(reduce(I,GJ))==0 && size(reduce(J,GI))==0);
}

proc integerBridge()
{
  ring R=integer,(c0,c1,c2,c3,c4),dp;
  poly z0=c2*c4-c3^2;
  poly z1=-(c1*c4-c2*c3);
  poly z2=c1*c3-c2^2;
  poly z3=c0*c4-c1*c3;
  poly z4=-(c0*c3-c1*c2);
  poly z5=c0*c2-c1^2;
  ideal J=
    3*z4^2-9*z2*z5-z3*z5,
    z3*z4-3*z1*z5,
    z3^2-9*z0*z5,
    z2*z3-z1*z4+z0*z5,
    z1*z3-3*z0*z4,
    3*z1^2-9*z0*z2-z0*z3;
  ideal V=
    2*c3^3-3*c2*c3*c4+c1*c4^2,
    6*c2*c3^2-9*c2^2*c4+2*c1*c3*c4+c0*c4^2,
    2*c1*c3^2-3*c1*c2*c4+c0*c3*c4,
    c0*c3^2-c1^2*c4,
    2*c1^2*c3-3*c0*c2*c3+c0*c1*c4,
    6*c1^2*c2-9*c0*c2^2+2*c0*c1*c3+c0^2*c4,
    2*c1^3-3*c0*c1*c2+c0^2*c3;
  matrix H[3][3]=c0,c1,c2,c1,c2,c3,c2,c3,c4;
  poly D=det(H);
  ideal G=std(J);

  if (size(reduce(3*D*V,G))<>0)
  {
    ERROR("STABLE_COMPONENT_FIBRES: minimal integer bridge containment failed");
  }
  if (size(reduce(D*V,G))==0)
  {
    ERROR("STABLE_COMPONENT_FIBRES: bridge unexpectedly lost its factor 3");
  }
}

proc genericBridge()
{
  ring R=0,(c0,c1,c2,c3,c4),dp;
  poly z0=c2*c4-c3^2;
  poly z1=-(c1*c4-c2*c3);
  poly z2=c1*c3-c2^2;
  poly z3=c0*c4-c1*c3;
  poly z4=-(c0*c3-c1*c2);
  poly z5=c0*c2-c1^2;
  ideal J=
    3*z4^2-9*z2*z5-z3*z5,
    z3*z4-3*z1*z5,
    z3^2-9*z0*z5,
    z2*z3-z1*z4+z0*z5,
    z1*z3-3*z0*z4,
    3*z1^2-9*z0*z2-z0*z3;
  ideal V=
    2*c3^3-3*c2*c3*c4+c1*c4^2,
    6*c2*c3^2-9*c2^2*c4+2*c1*c3*c4+c0*c4^2,
    2*c1*c3^2-3*c1*c2*c4+c0*c3*c4,
    c0*c3^2-c1^2*c4,
    2*c1^2*c3-3*c0*c2*c3+c0*c1*c4,
    6*c1^2*c2-9*c0*c2^2+2*c0*c1*c3+c0^2*c4,
    2*c1^3-3*c0*c1*c2+c0^2*c3;
  matrix H[3][3]=c0,c1,c2,c1,c2,c3,c2,c3,c4;
  poly D=det(H);

  if (size(reduce(J,std(V)))<>0)
  {
    ERROR("STABLE_COMPONENT_FIBRES: integral J subset V bridge failed");
  }
  if (size(reduce(3*D*V,std(J)))<>0)
  {
    ERROR("STABLE_COMPONENT_FIBRES: cleared-denominator bridge failed");
  }
  list saturated=sat(J,ideal(D));
  if (!sameIdeal(saturated[1],V))
  {
    ERROR("STABLE_COMPONENT_FIBRES: generic persistent saturation is not cyclic V");
  }
  list associated=minAssGTZ(std(J));
  if (size(associated)<>2)
  {
    ERROR("STABLE_COMPONENT_FIBRES: generic bridge component count changed");
  }
  int found_cyclic=0;
  int found_persistent=0;
  int component_index;
  for (component_index=1; component_index<=2; component_index++)
  {
    if (sameIdeal(associated[component_index],V)) { found_cyclic=1; }
    if (size(reduce(ideal(D),std(associated[component_index])))==0)
    {
      found_persistent=1;
    }
  }
  if (!found_cyclic || !found_persistent)
  {
    ERROR("STABLE_COMPONENT_FIBRES: generic bridge components changed");
  }
}

proc characteristicTwo()
{
  ring R=2,(c0,c1,c2,c3,c4),dp;
  poly z0=c2*c4-c3^2;
  poly z1=-(c1*c4-c2*c3);
  poly z2=c1*c3-c2^2;
  poly z3=c0*c4-c1*c3;
  poly z4=-(c0*c3-c1*c2);
  poly z5=c0*c2-c1^2;
  ideal J=
    3*z4^2-9*z2*z5-z3*z5,
    z3*z4-3*z1*z5,
    z3^2-9*z0*z5,
    z2*z3-z1*z4+z0*z5,
    z1*z3-3*z0*z4,
    3*z1^2-9*z0*z2-z0*z3;
  ideal binary_plane=c0,c4;
  ideal persistent_vertical=
    c2*c3+c1*c4,
    c2^2+c0*c4,
    c1*c2+c0*c3,
    c0*c3^2+c1^2*c4;
  matrix H[3][3]=c0,c1,c2,c1,c2,c3,c2,c3,c4;
  poly D=det(H);
  list associated=minAssGTZ(std(J));
  if (size(associated)<>2)
  {
    ERROR("STABLE_COMPONENT_FIBRES: binary bridge component count changed");
  }
  int found_plane=0;
  int found_persistent=0;
  int component_index;
  for (component_index=1; component_index<=2; component_index++)
  {
    if (sameIdeal(associated[component_index],binary_plane)) { found_plane=1; }
    if (sameIdeal(associated[component_index],persistent_vertical))
    {
      found_persistent=1;
    }
  }
  if (!found_plane || !found_persistent)
  {
    ERROR("STABLE_COMPONENT_FIBRES: binary bridge components changed");
  }
  if (size(reduce(ideal(D),std(persistent_vertical)))<>0)
  {
    ERROR("STABLE_COMPONENT_FIBRES: binary vertical component escaped persistence");
  }
}

proc genericPrimeControl()
{
  ring R=5,(c0,c1,c2,c3,c4),dp;
  poly z0=c2*c4-c3^2;
  poly z1=-(c1*c4-c2*c3);
  poly z2=c1*c3-c2^2;
  poly z3=c0*c4-c1*c3;
  poly z4=-(c0*c3-c1*c2);
  poly z5=c0*c2-c1^2;
  ideal J=
    3*z4^2-9*z2*z5-z3*z5,
    z3*z4-3*z1*z5,
    z3^2-9*z0*z5,
    z2*z3-z1*z4+z0*z5,
    z1*z3-3*z0*z4,
    3*z1^2-9*z0*z2-z0*z3;
  list associated=minAssGTZ(std(J));
  if (size(associated)<>2)
  {
    ERROR("STABLE_COMPONENT_FIBRES: characteristic-five bridge control changed");
  }
}

integerBridge();
genericBridge();
characteristicTwo();
genericPrimeControl();
print("STABLE_COMPONENT_FIBRES Singular certificate OK: minimal integer bridge and F2/F5 fibres");
