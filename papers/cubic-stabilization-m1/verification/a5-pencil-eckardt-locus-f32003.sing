// Eckardt locus and singular locus of the nonstandard A_5-cubic pencil,
// by elimination.  Generated file; do not edit.  Its generator is
// verification/a5_pencil_eckardt_locus.py, which documents the model,
// the two ideals, and the replay commands.
LIB "elim.lib";
LIB "primdec.lib";
ring R = 32003, (y(1..5), b), dp;
poly p3 = y(1)^3+y(2)^3+y(3)^3+y(4)^3+y(5)^3+(-(y(1)+y(2)+y(3)+y(4)+y(5)))^3;
poly T1 = y(1)*y(2)*y(3)+y(1)*y(2)*y(5)+y(1)*y(3)*(-(y(1)+y(2)+y(3)+y(4)+y(5)))+y(1)*y(4)*y(5)+y(1)*y(4)*(-(y(1)+y(2)+y(3)+y(4)+y(5)))+y(2)*y(3)*y(4)+y(2)*y(4)*(-(y(1)+y(2)+y(3)+y(4)+y(5)))+y(2)*y(5)*(-(y(1)+y(2)+y(3)+y(4)+y(5)))+y(3)*y(4)*y(5)+y(3)*y(5)*(-(y(1)+y(2)+y(3)+y(4)+y(5)));
poly F = p3 + b*T1;
"orbit used for T_1:";
"['1.2.3', '1.2.5', '1.3.6', '1.4.5', '1.4.6', '2.3.4', '2.4.6', '2.5.6', '3.4.5', '3.5.6']";
ideal irrel = y(1),y(2),y(3),y(4),y(5);

"=== singular locus of the pencil ===";
ideal Ising = diff(F,y(1)),diff(F,y(2)),diff(F,y(3)),diff(F,y(4)),diff(F,y(5));
"number of generators:"; size(Ising);
list Lsing = sat(Ising, irrel);
ideal Jsing = Lsing[1];
ideal Esing = eliminate(Jsing, y(1)*y(2)*y(3)*y(4)*y(5));
"eliminated ideal:"; Esing;
if (size(Esing) > 0) {
  "factorization:"; factorize(Esing[1]);
}

"=== Eckardt locus of the pencil ===";
matrix H[5][5] = diff(diff(F,y(1)),y(1)),diff(diff(F,y(1)),y(2)),diff(diff(F,y(1)),y(3)),diff(diff(F,y(1)),y(4)),diff(diff(F,y(1)),y(5)),diff(diff(F,y(2)),y(1)),diff(diff(F,y(2)),y(2)),diff(diff(F,y(2)),y(3)),diff(diff(F,y(2)),y(4)),diff(diff(F,y(2)),y(5)),diff(diff(F,y(3)),y(1)),diff(diff(F,y(3)),y(2)),diff(diff(F,y(3)),y(3)),diff(diff(F,y(3)),y(4)),diff(diff(F,y(3)),y(5)),diff(diff(F,y(4)),y(1)),diff(diff(F,y(4)),y(2)),diff(diff(F,y(4)),y(3)),diff(diff(F,y(4)),y(4)),diff(diff(F,y(4)),y(5)),diff(diff(F,y(5)),y(1)),diff(diff(F,y(5)),y(2)),diff(diff(F,y(5)),y(3)),diff(diff(F,y(5)),y(4)),diff(diff(F,y(5)),y(5));
ideal Ieck = F, minor(H, 3);
"number of generators:"; size(Ieck);
list Leck = sat(Ieck, irrel);
ideal Jeck = Leck[1];
ideal Eeck = eliminate(Jeck, y(1)*y(2)*y(3)*y(4)*y(5));
"eliminated ideal:"; Eeck;
if (size(Eeck) > 0) {
  "factorization:"; factorize(Eeck[1]);
}

"=== the omitted member (a:b) = (0:1), the cubic T_1 = 0 ===";
// the two eliminations above run in the chart a = 1, so the single
// pencil point (a:b) = (0:1) is not covered by them and is settled here.
ideal IT = diff(T1,y(1)),diff(T1,y(2)),diff(T1,y(3)),diff(T1,y(4)),diff(T1,y(5));
list LT = sat(IT, irrel);
ideal JT = LT[1];
"dimension of its singular locus (-1 empty, so smooth):";
dim(std(JT)) - 1;
matrix HT[5][5] = diff(diff(T1,y(1)),y(1)),diff(diff(T1,y(1)),y(2)),diff(diff(T1,y(1)),y(3)),diff(diff(T1,y(1)),y(4)),diff(diff(T1,y(1)),y(5)),diff(diff(T1,y(2)),y(1)),diff(diff(T1,y(2)),y(2)),diff(diff(T1,y(2)),y(3)),diff(diff(T1,y(2)),y(4)),diff(diff(T1,y(2)),y(5)),diff(diff(T1,y(3)),y(1)),diff(diff(T1,y(3)),y(2)),diff(diff(T1,y(3)),y(3)),diff(diff(T1,y(3)),y(4)),diff(diff(T1,y(3)),y(5)),diff(diff(T1,y(4)),y(1)),diff(diff(T1,y(4)),y(2)),diff(diff(T1,y(4)),y(3)),diff(diff(T1,y(4)),y(4)),diff(diff(T1,y(4)),y(5)),diff(diff(T1,y(5)),y(1)),diff(diff(T1,y(5)),y(2)),diff(diff(T1,y(5)),y(3)),diff(diff(T1,y(5)),y(4)),diff(diff(T1,y(5)),y(5));
ideal IET = T1, minor(HT, 3);
list LET = sat(IET, irrel);
ideal JET = LET[1];
"dimension of its Eckardt scheme (-1 empty, so no Eckardt point):";
dim(std(JET)) - 1;
quit;
