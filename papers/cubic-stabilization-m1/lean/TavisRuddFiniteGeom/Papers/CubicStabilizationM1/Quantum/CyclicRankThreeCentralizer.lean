import Mathlib.Tactic
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.LinearAlgebra.Matrix.Charpoly.Basic

/-!
# A centered cyclic rank-three matrix and its commutant

The companion matrix with characteristic polynomial `T³-bT-c` is cyclic over
any commutative coefficient ring: its first three cyclic vectors are the
standard basis. Consequently every commuting matrix is a polynomial of degree
at most two, with coefficients read from its first column. The resulting trace
identities put the relevant traces in the ideal generated by `b,c`.

These are finite matrix identities supporting cluster persistence. No formal
bulk connection, differential ideal or persistence theorem is constructed here.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationM1.Quantum

variable {K : Type*} [CommRing K]

/-- A trace-free cyclic companion matrix with parameters `b,c`. -/
def centeredCyclicRankThree (b c : K) : Matrix (Fin 3) (Fin 3) K :=
  !![0, 0, c; 1, 0, b; 0, 1, 0]

/-- Every commuting matrix is a quadratic polynomial in the cyclic matrix.
Its polynomial coefficients are exactly the entries of its first column;
there are no divisions or field hypotheses. -/
theorem centeredCyclicRankThree_commutant {b c : K}
    (comparison : Matrix (Fin 3) (Fin 3) K)
    (commutes : comparison * centeredCyclicRankThree b c =
      centeredCyclicRankThree b c * comparison) :
    comparison = comparison 0 0 • (1 : Matrix (Fin 3) (Fin 3) K) +
      comparison 1 0 • centeredCyclicRankThree b c +
      comparison 2 0 • (centeredCyclicRankThree b c)^2 := by
  have h00 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 0 0) commutes
  have h10 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 1 0) commutes
  have h20 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 2 0) commutes
  have h01 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 0 1) commutes
  have h11 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 1 1) commutes
  have h21 := congrArg (fun m : Matrix (Fin 3) (Fin 3) K => m 2 1) commutes
  simp [centeredCyclicRankThree, Matrix.mul_apply, Fin.sum_univ_succ] at h00 h10 h20 h01 h11 h21
  ext row column
  fin_cases row <;> fin_cases column <;>
    simp [centeredCyclicRankThree, pow_two] <;>
    first | ring | linear_combination h00 | linear_combination h10 |
      linear_combination h20 | linear_combination h01 + c*h20 |
      linear_combination h11 + h00 + b*h20 | linear_combination h21 + h10

/-- Explicit traces of a general quadratic commutant. The last two traces
belong to the parameter ideal `(b,c)`, including over rings with zero divisors. -/
theorem centeredCyclicRankThree_polynomial_traces (b c u v w : K) :
    let e := centeredCyclicRankThree b c
    let a := u • (1 : Matrix (Fin 3) (Fin 3) K) + v • e + w • e^2
    Matrix.trace a = 3*u + 2*b*w ∧
      Matrix.trace (e*a) = 2*b*v + 3*c*w ∧
      Matrix.trace (e^2*a) = 2*b*u + 3*c*v + 2*b^2*w := by
  dsimp
  simp [centeredCyclicRankThree, Matrix.trace, Matrix.diag, pow_two,
    Matrix.mul_apply, Fin.sum_univ_succ]
  constructor
  · ring
  constructor <;> ring

/-- The trace identities for an arbitrary actual commuting matrix, with
coefficients obtained from its first column rather than supplied separately. -/
theorem centeredCyclicRankThree_commuting_traces {b c : K}
    (comparison : Matrix (Fin 3) (Fin 3) K)
    (commutes : comparison * centeredCyclicRankThree b c =
      centeredCyclicRankThree b c * comparison) :
    Matrix.trace comparison = 3*comparison 0 0 + 2*b*comparison 2 0 ∧
      Matrix.trace (centeredCyclicRankThree b c * comparison) =
        2*b*comparison 1 0 + 3*c*comparison 2 0 ∧
      Matrix.trace ((centeredCyclicRankThree b c)^2 * comparison) =
        2*b*comparison 0 0 + 3*c*comparison 1 0 + 2*b^2*comparison 2 0 := by
  have polynomial := centeredCyclicRankThree_commutant comparison commutes
  have traces := centeredCyclicRankThree_polynomial_traces b c
    (comparison 0 0) (comparison 1 0) (comparison 2 0)
  dsimp at traces
  rw [← polynomial] at traces
  exact traces

/-- The characteristic polynomial of the centered cyclic matrix, over an
arbitrary commutative coefficient ring. -/
theorem centeredCyclicRankThree_charpoly (b c : K) :
    (centeredCyclicRankThree b c).charpoly =
      Polynomial.X^3 - Polynomial.C b * Polynomial.X - Polynomial.C c := by
  simp [Matrix.charpoly, Matrix.charmatrix, centeredCyclicRankThree,
    Matrix.det_fin_three, Matrix.scalar, Matrix.diagonal]
  ring

end TavisRuddFiniteGeom.Papers.CubicStabilizationM1.Quantum
