import TavisRuddFiniteGeom.Papers.CubicStabilizationM1.GraphLattices.DividedPowers

/-!
# Ordinary products of a divisor submodule

This module gives a literal integral model of the degree-by-degree ordinary
product image generated by a prescribed divisor submodule.  It then proves
that the labelled squarefree product sum used in the divided-power expansion
belongs to that image whenever every labelled factor is a divisor class.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationM1

namespace GraphLattices

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- The degree-`k` ordinary product submodule generated by `divisors`.
Degree zero is the `R`-span of the unit.  Degree `k+1` is the `R`-span of
products of one divisor with a degree-`k` ordinary product. -/
def ordinaryProductSubmodule (divisors : Submodule R A) : ℕ → Submodule R A
  | 0 => Submodule.span R ({1} : Set A)
  | k + 1 => Submodule.span R
      {product | ∃ divisor ∈ divisors,
        ∃ lower ∈ ordinaryProductSubmodule divisors k,
          product = divisor * lower}

/-- The empty product belongs to the degree-zero ordinary product image. -/
theorem one_mem_ordinaryProductSubmodule_zero (divisors : Submodule R A) :
    1 ∈ ordinaryProductSubmodule divisors 0 := by
  apply Submodule.subset_span
  simp

/-- Multiplying a divisor by a degree-`k` ordinary product gives a
degree-`k+1` ordinary product. -/
theorem mul_mem_ordinaryProductSubmodule_succ
    (divisors : Submodule R A) (divisor lower : A) (k : ℕ)
    (divisorMember : divisor ∈ divisors)
    (lowerMember : lower ∈ ordinaryProductSubmodule divisors k) :
    divisor * lower ∈ ordinaryProductSubmodule divisors (k + 1) := by
  apply Submodule.subset_span
  exact ⟨divisor, divisorMember, lower, lowerMember, rfl⟩

/-- A squarefree product sum of degree `k` is an ordinary degree-`k` product
whenever every labelled factor belongs to the divisor submodule.  Repeated
values at distinct list positions are allowed, matching
`squarefreeProductSum`. -/
theorem squarefreeProductSum_mem_ordinaryProductSubmodule
    (divisors : Submodule R A) (terms : List A)
    (termsMember : ∀ term ∈ terms, term ∈ divisors) (k : ℕ) :
    squarefreeProductSum terms k ∈ ordinaryProductSubmodule divisors k := by
  induction terms generalizing k with
  | nil =>
      cases k with
      | zero => exact one_mem_ordinaryProductSubmodule_zero divisors
      | succ k => simp [squarefreeProductSum]
  | cons head tail inductionHypothesis =>
      have headMember : head ∈ divisors := termsMember head (by simp)
      have tailMember : ∀ term ∈ tail, term ∈ divisors := by
        intro term membership
        exact termsMember term (by simp [membership])
      cases k with
      | zero => exact one_mem_ordinaryProductSubmodule_zero divisors
      | succ k =>
          rw [squarefreeProductSum]
          apply Submodule.add_mem
          · exact inductionHypothesis tailMember (k + 1)
          · exact mul_mem_ordinaryProductSubmodule_succ divisors head
              (squarefreeProductSum tail k) k headMember
              (inductionHypothesis tailMember k)

end GraphLattices

end TavisRuddFiniteGeom.Papers.CubicStabilizationM1
