import TavisRuddFiniteGeom.Papers.CubicStabilizationM1.GraphLattices.SixPointProjectiveSpecialLinearAction

/-!
# Rational fixed lines of the six-point axis stabilizers

The concrete alternating group on five letters acts two-transitively on its
six Sylow-five subgroups.  For each of the six labels, its point stabilizer is
the corresponding ten-element dihedral normalizer.  This module studies that
stabilizer on the rational augmentation representation of the six labels.

Lean proves that the fixed subspace is exactly the line generated by the
vector with coordinate `5` at the chosen label and `-1` at the other five
labels.  In particular, the fixed subspace has dimension one.  This is the
finite linear-algebra statement behind the rank-one axis projector; no
abelian scheme, norm endomorphism, elliptic image, or geometric generic-fibre
identification is constructed here.
-/

namespace TavisRuddFiniteGeom.Papers.CubicStabilizationM1

namespace GraphLattices

/-- Sum of the six coordinates over the rational coefficient field. -/
def sixPointRationalCoordinateSum : (Fin 6 → ℚ) →ₗ[ℚ] ℚ where
  toFun vector := ∑ label, vector label
  map_add' left right := by
    simp [Finset.sum_add_distrib]
  map_smul' scalar vector := by
    simp [Finset.mul_sum]

/-- The rational augmentation representation of the six labels. -/
def SixPointRationalAugmentation : Submodule ℚ (Fin 6 → ℚ) :=
  LinearMap.ker sixPointRationalCoordinateSum

/-- The rank-one axis vector: `5` at the chosen label and `-1` elsewhere. -/
def sixPointRationalAxisVector
    (label : Fin 6) : SixPointRationalAugmentation := by
  classical
  refine ⟨fun other ↦ if other = label then 5 else -1, ?_⟩
  change (∑ other, if other = label then (5 : ℚ) else -1) = 0
  calc
    (∑ other, if other = label then (5 : ℚ) else -1) =
        ∑ other, (-1 + if other = label then (6 : ℚ) else 0) := by
          apply Finset.sum_congr rfl
          intro other _
          by_cases equality : other = label
          · subst other
            norm_num
          · simp [equality]
    _ = 0 := by
      simp [Finset.sum_add_distrib]

/-- Rational augmentation vectors fixed by the point stabilizer of one
six-point label. -/
def sixPointAxisFixedSubspace
    (label : Fin 6) : Submodule ℚ SixPointRationalAugmentation where
  carrier := {vector | ∀ transformation : alternatingGroup (Fin 5),
    transformation ∈ alternatingFiveSixPointStabilizer label →
      ∀ other,
        vector.1 (alternatingFiveSixPointAction transformation other) =
          vector.1 other}
  zero_mem' := by simp
  add_mem' := by
    intro left right leftFixed rightFixed transformation member other
    simp [leftFixed transformation member other,
      rightFixed transformation member other]
  smul_mem' := by
    intro scalar vector fixed transformation member other
    simp [fixed transformation member other]

/-- The displayed axis vector is fixed by the corresponding point
stabilizer. -/
theorem sixPointRationalAxisVector_mem_fixedSubspace (label : Fin 6) :
    sixPointRationalAxisVector label ∈ sixPointAxisFixedSubspace label := by
  intro transformation member other
  have fixesLabel :
      alternatingFiveSixPointAction transformation label = label :=
    (mem_alternatingFiveSixPointStabilizer_iff transformation label).mp member
  by_cases otherIsLabel : other = label
  · subst other
    simp [sixPointRationalAxisVector, fixesLabel]
  · have imageIsNotLabel :
        alternatingFiveSixPointAction transformation other ≠ label := by
      intro imageIsLabel
      apply otherIsLabel
      apply (alternatingFiveSixPointAction transformation).injective
      simpa [fixesLabel] using imageIsLabel
    simp [sixPointRationalAxisVector, otherIsLabel, imageIsNotLabel]

/-- A vector fixed by one point stabilizer has equal coordinates at any two
labels different from the fixed label. -/
theorem sixPointAxisFixedSubspace_eq_of_ne
    (label : Fin 6) (vector : SixPointRationalAugmentation)
    (fixed : vector ∈ sixPointAxisFixedSubspace label)
    {left right : Fin 6} (leftNe : left ≠ label) (rightNe : right ≠ label) :
    vector.1 left = vector.1 right := by
  obtain ⟨transformation, fixesLabel, mapsLeft⟩ :=
    alternatingFiveSixPointAction_two_transitive
      label left label right leftNe.symm rightNe.symm
  have member :
      transformation ∈ alternatingFiveSixPointStabilizer label :=
    (mem_alternatingFiveSixPointStabilizer_iff transformation label).mpr
      fixesLabel
  have fixedCoordinate := fixed transformation member left
  rw [mapsLeft] at fixedCoordinate
  exact fixedCoordinate.symm

/-- Every non-axis coordinate of a fixed augmentation vector is
`-1/5` times its axis coordinate. -/
theorem sixPointAxisFixedSubspace_coordinate
    (label : Fin 6) (vector : SixPointRationalAugmentation)
    (fixed : vector ∈ sixPointAxisFixedSubspace label)
    (other : Fin 6) (otherNe : other ≠ label) :
    vector.1 other = -(vector.1 label) / 5 := by
  classical
  have otherSum :
      (∑ index ∈ Finset.univ.erase label, vector.1 index) =
        5 * vector.1 other := by
    calc
      (∑ index ∈ Finset.univ.erase label, vector.1 index) =
          ∑ _index ∈ Finset.univ.erase label, vector.1 other := by
            apply Finset.sum_congr rfl
            intro index indexMember
            exact sixPointAxisFixedSubspace_eq_of_ne label vector fixed
              (Finset.ne_of_mem_erase indexMember) otherNe
      _ = 5 * vector.1 other := by
        norm_num [Finset.card_erase_of_mem]
  have sumZero : (∑ index, vector.1 index) = 0 := vector.property
  rw [← Finset.add_sum_erase Finset.univ vector.1
    (Finset.mem_univ label), otherSum] at sumZero
  linarith

/-- Every fixed augmentation vector is the scalar multiple of the displayed
axis vector determined by its axis coordinate. -/
theorem sixPointAxisFixedSubspace_eq_smul_axisVector
    (label : Fin 6) (vector : SixPointRationalAugmentation)
    (fixed : vector ∈ sixPointAxisFixedSubspace label) :
    vector = (vector.1 label / 5) • sixPointRationalAxisVector label := by
  apply Subtype.ext
  funext other
  by_cases otherIsLabel : other = label
  · subst other
    norm_num [sixPointRationalAxisVector]
  · rw [sixPointAxisFixedSubspace_coordinate label vector fixed other otherIsLabel]
    simp [sixPointRationalAxisVector, otherIsLabel]
    ring

/-- The stabilizer-fixed augmentation subspace is exactly the axis line. -/
theorem sixPointAxisFixedSubspace_eq_span (label : Fin 6) :
    sixPointAxisFixedSubspace label = ℚ ∙ sixPointRationalAxisVector label := by
  apply le_antisymm
  · intro vector fixed
    exact Submodule.mem_span_singleton.mpr
      ⟨vector.1 label / 5,
        (sixPointAxisFixedSubspace_eq_smul_axisVector label vector fixed).symm⟩
  · rw [Submodule.span_singleton_le_iff_mem]
    exact sixPointRationalAxisVector_mem_fixedSubspace label

/-- The displayed rational axis vector is nonzero. -/
theorem sixPointRationalAxisVector_ne_zero (label : Fin 6) :
    sixPointRationalAxisVector label ≠ 0 := by
  intro equality
  have coordinateEquality := congrArg
    (fun vector : SixPointRationalAugmentation ↦ vector.1 label) equality
  norm_num [sixPointRationalAxisVector] at coordinateEquality

/-- Every six-point axis stabilizer has a one-dimensional fixed subspace in
the rational augmentation representation. -/
theorem sixPointAxisFixedSubspace_finrank (label : Fin 6) :
    Module.finrank ℚ (sixPointAxisFixedSubspace label) = 1 := by
  rw [sixPointAxisFixedSubspace_eq_span]
  exact finrank_span_singleton (sixPointRationalAxisVector_ne_zero label)

/-- Every six-point axis stabilizer is the corresponding ten-element
dihedral normalizer. -/
theorem alternatingFiveSixPointStabilizer_card (label : Fin 6) :
    Nat.card (alternatingFiveSixPointStabilizer label) = 10 := by
  rw [alternatingFiveSixPointStabilizer_eq_normalizer]
  exact sixPointFiveSubgroup_normalizer_card label

end GraphLattices

end TavisRuddFiniteGeom.Papers.CubicStabilizationM1
