/target

# Queens TT checkpoint images (dump/load) — large, generated; never commit.
*.zst
*.zst.tmp
*.zst.prev

# Frozen per-generation queens binaries (large, generated; rebuild from the tagged commit).
/bin/gen/queens-*

# perf analysis scratch output (generated)
/.perf-analysis/

# Projective cap S4 memo dumps / BuRR archives (large, generated; rebuildable).
/s4-dumps/

# Workspace-local uv cache for ad hoc ML scripts.
/.uv-cache/
