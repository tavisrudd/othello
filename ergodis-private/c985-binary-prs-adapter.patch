+trait FieldOps: Copy + Send + Sync {
+    fn add(self, left: u8, right: u8) -> u8;
+    fn mul(self, left: u8, right: u8) -> u8;
+}
+
+impl FieldOps for &Field {
+    #[inline(always)]
+    fn add(self, left: u8, right: u8) -> u8 {
+        self.a(left, right)
+    }
+
+    #[inline(always)]
+    fn mul(self, left: u8, right: u8) -> u8 {
+        self.m(left, right)
+    }
+}
+
+impl<const H: u8> FieldOps for BinarySmallField<'_, H> {
+    #[inline(always)]
