#!/usr/bin/env bash
# Open DuckDB with the Ergodis evidence catalog loaded (C1033).
#
#   analysis/ergodis-sql                          -- interactive shell
#   analysis/ergodis-sql -c "select * from ab_summary"
#
# Runs read-only against the private evidence tree.  DuckDB comes from nixpkgs;
# nothing is installed into the profile.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

exec nix shell nixpkgs#duckdb --command duckdb \
    -init analysis/ergodis_catalog.sql :memory: "$@"
