#!/usr/bin/env bash
# Launch JupyterLab with the Ergodis notebook package importable (C1033).
#
#   analysis/ergodis-notebook                 # open JupyterLab on analysis/notebooks
#   analysis/ergodis-notebook --port 9000     # extra args go to jupyter lab
#   ERGODIS_NB_RUN=1 analysis/ergodis-notebook \
#       nbconvert --to notebook --execute analysis/notebooks/solve-monitor.ipynb
#                                             # run any jupyter subcommand instead
#
# Dependencies come from uv, not the system profile or a nix shell, so the first
# run resolves them into uv's cache and later runs start immediately.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

export PYTHONPATH="$root/python${PYTHONPATH:+:$PYTHONPATH}"

# Run directories hold a search's watcher socket, and Unix socket paths are
# capped at 108 bytes, so the default lives somewhere short rather than under a
# deep working directory.
export ERGODIS_RUN_ROOT="${ERGODIS_RUN_ROOT:-${XDG_RUNTIME_DIR:-/tmp}/ergodis-runs}"
mkdir -p "$ERGODIS_RUN_ROOT"

deps=(
    --with jupyterlab
    --with duckdb
    --with pandas
    --with matplotlib
)

if [[ -n "${ERGODIS_NB_RUN:-}" ]]; then
    exec uv run "${deps[@]}" jupyter "$@"
fi

exec uv run "${deps[@]}" jupyter lab --notebook-dir="$root/analysis/notebooks" "$@"
