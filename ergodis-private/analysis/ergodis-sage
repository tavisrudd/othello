#!/usr/bin/env bash
# Run a Sage oracle script against this repository (C1033).
#
#   analysis/ergodis-sage analysis/sage/check_qldpc_certificate.py
#   analysis/ergodis-sage analysis/sage/check_qldpc_certificate.py \
#       evidence/c1018-qldpc-r1elite01-certificate.json
#
# Sage comes from nixpkgs through `nix shell`; nothing is installed into the
# profile. The closure is large and fetched once, so the first run downloads
# about 1 GiB and later runs start in seconds.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

exec nix shell nixpkgs#sage --command sage -python "$@"
