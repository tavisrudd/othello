+#[inline(always)]
+fn logical_matches<const TARGETED: bool>(logical: &[u64], target: &[u64]) -> bool {
+    if TARGETED {
+        logical == target
+    } else {
+        logical.iter().any(|&word| word != 0)
+    }
+}
+
+#[inline(always)]
+fn xor_logical_matches<const TARGETED: bool>(left: &[u64], right: &[u64], target: &[u64]) -> bool {
+    if TARGETED {
+        left.iter()
+            .zip(right)
+            .zip(target)
+            .all(|((&left, &right), &target)| left ^ right == target)
+    } else {
+        left.iter()
+            .zip(right)
+            .any(|(&left, &right)| left ^ right != 0)
+    }
+}
