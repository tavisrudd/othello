import Mathlib.LinearAlgebra.Matrix.Adjugate

/-!
# Adjugates with one-dimensional left and right kernels

For a singular square matrix over a field, every column of the adjugate lies
in the right kernel and every row lies in the left kernel.  If both kernels
are generated by prescribed vectors, the adjugate is therefore a scalar
multiple of their outer product.  The scalar may vanish; excluding that case
requires an additional rank or nonzero-minor hypothesis.

The theorem is stated directly in terms of kernel-generation properties, so
it applies without choosing bases for quotient spaces or imposing a matrix
size.  Its proof uses only the two adjugate multiplication identities.
-/

namespace RelativeConicArcs.CorankOneAdjugate

/-- The outer product of a column vector and a row vector. -/
def outerProduct {K n : Type*} [Mul K] (w q : n → K) : Matrix n n K :=
  fun i j => w i * q j

/--
If a singular square matrix has prescribed generators for its right and left
kernels, its adjugate is a scalar multiple of their outer product.  The two
generation hypotheses include the zero vector and do not assert that either
kernel generator is nonzero; nonvanishing of the right generator is stated
separately to recover the coefficient row from one matrix row.
-/
theorem adjugate_eq_smul_outerProduct_of_generated_kernels
    {K n : Type*} [Field K] [Fintype n] [DecidableEq n]
    (A : Matrix n n K) (w q : n → K)
    (hdet : A.det = 0)
    (hright : ∀ v : n → K, A.mulVec v = 0 → ∃ c : K, v = c • w)
    (hleft : ∀ v : n → K, A.transpose.mulVec v = 0 → ∃ c : K, v = c • q)
    (hw : ∃ i, w i ≠ 0) :
    ∃ μ : K, A.adjugate = μ • outerProduct w q := by
  classical
  have hmul : A * A.adjugate = 0 := by
    rw [Matrix.mul_adjugate, hdet, zero_smul]
  have hcol (j : n) : A.mulVec (fun i => A.adjugate i j) = 0 := by
    funext i
    have hij := congrFun (congrFun hmul i) j
    simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct] using hij
  choose c hc using fun j => hright (fun i => A.adjugate i j) (hcol j)
  obtain ⟨i₀, hi₀⟩ := hw
  have hadj (i j : n) : A.adjugate i j = c j * w i := by
    exact congrFun (hc j) i
  have hmul' : A.adjugate * A = 0 := by
    rw [Matrix.adjugate_mul, hdet, zero_smul]
  have hc_kernel : A.transpose.mulVec c = 0 := by
    funext j
    have hij := congrFun (congrFun hmul' i₀) j
    have hzero : w i₀ * (A.transpose.mulVec c j) = 0 := by
      rw [Matrix.mulVec, dotProduct]
      simp only [Matrix.transpose_apply]
      rw [Finset.mul_sum]
      simpa [Matrix.mul_apply, hadj, mul_assoc, mul_left_comm, mul_comm] using hij
    exact (mul_eq_zero.mp hzero).resolve_left hi₀
  obtain ⟨μ, hμ⟩ := hleft c hc_kernel
  refine ⟨μ, ?_⟩
  ext i j
  rw [hadj, congrFun hμ j]
  simp [outerProduct]
  ring

end RelativeConicArcs.CorankOneAdjugate
