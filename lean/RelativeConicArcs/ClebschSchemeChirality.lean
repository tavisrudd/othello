/-
# Intrinsic six-block decomposition and unordered Clebsch chirality

The column-neighbor graph at the origin has sixty vertices, parametrized here by a direction and
a nonzero scalar.  Its reflexive adjacency components are proved to be exactly the six scalar
lines.  The induced degree-six action generated by two frozen permutations has precisely two
orbits on the twenty three-subsets, each of size ten.  A checked normalizing involution exchanges
the two orbits, so the resulting chirality is intrinsically an unordered two-sheet object.

All finite equalities below are exhaustive kernel reductions over the displayed domains.  The
identification of these frozen directions and permutations with the unmarked 1,331-vertex
translation scheme is external exact-enumeration evidence.  In particular, this module does not
prove the full color-preserving automorphism group, completeness of a projective frame search,
absence of an outer lift to a scheme automorphism, rank-sixteen eigenmatrix identities, or
minimality of a coherent refinement.
-/
import RelativeConicArcs.ClebschSchemeChiralityData
import RelativeConicArcs.ClebschGateway
import Mathlib.Tactic

namespace RelativeConicArcs
namespace ClebschSchemeChirality

/-- The vector represented by a direction and one of the ten nonzero scalars of `F_11`. -/
def neighborVector (x : NeighborIndex) : SchemeVector :=
  fun j => ⟨((x.2.val + 1) * (direction x.1 j).val) % 11, Nat.mod_lt _ (by decide)⟩

/-- Coordinatewise subtraction modulo eleven on the chosen finite representatives. -/
def vectorSub (u v : SchemeVector) : SchemeVector :=
  fun j => ⟨((u j).val + 11 - (v j).val) % 11, Nat.mod_lt _ (by decide)⟩

/-- Adjacency inherited from the column-direction Cayley graph, restricted to the sixty neighbors
of the origin. -/
def columnAdjacent (x y : NeighborIndex) : Bool :=
  decide (x ≠ y ∧ ∃ z : NeighborIndex,
    vectorSub (neighborVector x) (neighborVector y) = neighborVector z)

/-- Reflexive adjacency inside the origin neighborhood.  For this graph it is the connected-
component relation because every component is a clique. -/
def sameIntrinsicComponent (x y : NeighborIndex) : Bool := decide (x = y) || columnAdjacent x y

/-- The reflexive-adjacency neighborhood of one column neighbor inside the sixty-vertex induced
graph. -/
def intrinsicComponent (x : NeighborIndex) : Finset NeighborIndex :=
  Finset.univ.filter fun y => sameIntrinsicComponent x y = true

/-- One of the six scalar-line blocks in the direction/scalar parametrization. -/
def scalarLineBlock (i : Fin 6) : Finset NeighborIndex :=
  Finset.univ.filter fun x => x.1 = i

/-- The six reflexive-adjacency neighborhoods obtained from one representative on each scalar
line. -/
def intrinsicComponents : Finset (Finset NeighborIndex) :=
  Finset.univ.image fun i : Fin 6 => intrinsicComponent (i, 0)

/-- Intrinsic reflexive adjacency recovers exactly the six scalar-line blocks: the collection of
all reflexive-adjacency neighborhoods is the collection of the six coordinate fibres. -/
theorem intrinsicComponents_eq_scalarLineBlocks :
    intrinsicComponents = Finset.univ.image scalarLineBlock := by
  set_option maxRecDepth 100000 in
    decide

/-- Each recovered scalar-line component has ten vertices. -/
theorem scalarLineBlock_card (i : Fin 6) :
    (scalarLineBlock i).card = 10 := by
  decide +revert

/-- Every frozen triple has exactly three distinct blocks. -/
theorem triple_card (t : Fin 20) : (triple t).card = 3 := by
  decide +revert

/-- The frozen list covers exactly all three-subsets of the six blocks. -/
theorem triple_range_complete :
    Finset.univ.image triple =
      (Finset.univ : Finset (Finset (Fin 6))).filter fun s => s.card = 3 := by
  decide

/-- The twenty frozen triples are pairwise distinct, so the complete enumeration has no
repetitions. -/
theorem triple_list_nodup : (List.ofFn triple).Nodup := by
  decide

/-- The frozen triple action is induced by the corresponding permutation of the six recovered
blocks. -/
theorem generatorTripleAction_semantics (g : Fin 2) (t : Fin 20) :
    triple (generatorTripleAction g t) = (triple t).image (blockGenerator g) := by
  decide +revert

/-- One simultaneous expansion under the two action generators. -/
def orbitStep (s : Finset (Fin 20)) : Finset (Fin 20) :=
  s ∪ s.biUnion fun t => Finset.univ.image fun g : Fin 2 => generatorTripleAction g t

/-- A bounded closure under the two generators.  Ten rounds exceed the diameter of each checked
ten-element orbit. -/
def generatedOrbit (seed : Fin 20) : Finset (Fin 20) :=
  (orbitStep^[10]) {seed}

/-- The first seed generates exactly the first ten triples. -/
theorem positive_generatedOrbit :
    generatedOrbit 0 = Finset.univ.filter fun t : Fin 20 => t.val < 10 := by
  decide

/-- The second seed generates exactly the other ten triples. -/
theorem negative_generatedOrbit :
    generatedOrbit 10 = Finset.univ.filter fun t : Fin 20 => 10 ≤ t.val := by
  decide

/-- Both generator actions preserve the sheet label. -/
theorem generator_preserves_sheet (g : Fin 2) (t : Fin 20) :
    (generatorTripleAction g t).val < 10 ↔ t.val < 10 := by
  decide +revert

/-- The displayed outer normalizer acts on triples through the displayed triple table. -/
theorem sheetExchangeTriple_semantics (t : Fin 20) :
    triple (sheetExchangeTriple t) = (triple t).image sheetExchangeBlock := by
  decide +revert

/-- The displayed normalizing involution exchanges the two ten-element sheets. -/
theorem sheetExchange_swaps_sheets (t : Fin 20) :
    (sheetExchangeTriple t).val < 10 ↔ ¬ t.val < 10 := by
  decide +revert

/-- The displayed sheet-exchanging normalizer element has fourth power equal to the identity on
both blocks and triples. -/
theorem sheetExchange_fourth_power :
    (∀ i, sheetExchangeBlock (sheetExchangeBlock (sheetExchangeBlock (sheetExchangeBlock i))) = i) ∧
      ∀ t, sheetExchangeTriple (sheetExchangeTriple
        (sheetExchangeTriple (sheetExchangeTriple t))) = t := by
  decide

/-- Any two group actions on a two-sheet set agree once their kernels agree.  This specializes the
abstract quotient-character theorem used to compare unordered chirality constructions. -/
theorem unorderedChiralityCharacter_unique {G : Type*} [Group G]
    (chi₁ chi₂ : G →* Equiv.Perm (Fin 2)) (hker : chi₁.ker = chi₂.ker) : chi₁ = chi₂ :=
  ClebschGateway.twoSheetCharacter_eq_of_ker_eq chi₁ chi₂ hker

end ClebschSchemeChirality
end RelativeConicArcs
