import Mathlib

/-!
# Split quadratic pinching

For a commutative ring `S` and `a : S`, the split pinching algebra consists
of pairs `(u,v)` whose difference is divisible by `a`.  When two is
invertible, it is exactly the image of

`(p,q) ↦ (p + a*q, p - a*q)`,

the evaluation map suggested by `S[z]/(z²-a²) → S × S`.  Its conductor in
the product ring is the branch ideal `(a) × (a)`.  If `a` is a unit, every
pair is admitted, so the algebra is already split away from the branch.

These statements use the congruence defining the pinching, rather than a
factor-by-factor coordinate calculation.
-/

namespace RelativeConicArcs.SplitQuadraticPinching

variable {S : Type*} [CommRing S]

/-- Pairs that agree modulo the principal ideal generated by `a`. -/
def splitPinching (a : S) : Subring (S × S) where
  carrier := {x | ∃ q : S, x.1 - x.2 = a * q}
  zero_mem' := ⟨0, by simp⟩
  one_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨p, hp⟩ ⟨q, hq⟩
    refine ⟨p + q, ?_⟩
    dsimp only
    rw [mul_add]
    linear_combination hp + hq
  neg_mem' := by
    rintro x ⟨p, hp⟩
    refine ⟨-p, ?_⟩
    dsimp only
    rw [mul_neg]
    linear_combination -hp
  mul_mem' := by
    rintro x y ⟨p, hp⟩ ⟨q, hq⟩
    refine ⟨x.1 * q + y.2 * p, ?_⟩
    dsimp only
    rw [mul_add]
    calc
      x.1 * y.1 - x.2 * y.2 = x.1 * (y.1 - y.2) + y.2 * (x.1 - x.2) := by ring
      _ = x.1 * (a * q) + y.2 * (a * p) := by rw [hq, hp]
      _ = a * (x.1 * q + y.2 * p) := by ring

@[simp]
theorem mem_splitPinching_iff (a : S) (x : S × S) :
    x ∈ splitPinching a ↔ ∃ q : S, x.1 - x.2 = a * q :=
  Iff.rfl

/-- The two evaluations of the split quadratic expression `p + qz`. -/
def splitEvaluate (a p q : S) : S × S :=
  (p + a * q, p - a * q)

/-- Every split evaluation belongs to the pinching algebra. -/
theorem splitEvaluate_mem (a p q : S) : splitEvaluate a p q ∈ splitPinching a := by
  refine ⟨2 * q, ?_⟩
  simp only [splitEvaluate]
  ring

/-- When two is invertible, every pinched pair is obtained by split
evaluation. -/
theorem exists_splitEvaluate [Invertible (2 : S)] {a : S} {x : S × S}
    (hx : x ∈ splitPinching a) : ∃ p q : S, splitEvaluate a p q = x := by
  obtain ⟨r, hr⟩ := hx
  refine ⟨⅟ (2 : S) * (x.1 + x.2), ⅟ (2 : S) * r, ?_⟩
  apply Prod.ext
  · dsimp only [splitEvaluate]
    have htwo : ⅟ (2 : S) * 2 = 1 := invOf_mul_self (2 : S)
    calc
      ⅟ (2 : S) * (x.1 + x.2) + a * (⅟ (2 : S) * r) =
          ⅟ (2 : S) * ((x.1 + x.2) + a * r) := by ring
      _ = ⅟ (2 : S) * (2 * x.1) := by rw [← hr]; ring
      _ = x.1 := by rw [← mul_assoc, htwo, one_mul]
  · dsimp only [splitEvaluate]
    have htwo : ⅟ (2 : S) * 2 = 1 := invOf_mul_self (2 : S)
    calc
      ⅟ (2 : S) * (x.1 + x.2) - a * (⅟ (2 : S) * r) =
          ⅟ (2 : S) * ((x.1 + x.2) - a * r) := by ring
      _ = ⅟ (2 : S) * (2 * x.2) := by rw [← hr]; ring
      _ = x.2 := by rw [← mul_assoc, htwo, one_mul]

/-- The conductor of a subring in its ambient commutative ring. -/
def subringConductor (R : Subring (S × S)) : Ideal (S × S) where
  carrier := {x | ∀ y : S × S, x * y ∈ R}
  zero_mem' y := by simp
  add_mem' hx hy z := by
    rw [add_mul]
    exact R.add_mem (hx z) (hy z)
  smul_mem' c x hx y := by
    change (c * x) * y ∈ R
    rw [mul_assoc, mul_comm c x, ← mul_assoc]
    exact hx (c * y)

/-- The product of the two principal branch ideals, written intrinsically as
an ideal of `S × S`. -/
def branchIdeal (a : S) : Ideal (S × S) where
  carrier := {x | (∃ p : S, x.1 = a * p) ∧ ∃ q : S, x.2 = a * q}
  zero_mem' := ⟨⟨0, by simp⟩, ⟨0, by simp⟩⟩
  add_mem' := by
    rintro x y ⟨⟨p, hp⟩, ⟨q, hq⟩⟩ ⟨⟨r, hr⟩, ⟨s, hs⟩⟩
    exact ⟨⟨p + r, by simp only; rw [hp, hr, mul_add]⟩,
      ⟨q + s, by simp only; rw [hq, hs, mul_add]⟩⟩
  smul_mem' := by
    rintro c x ⟨⟨p, hp⟩, ⟨q, hq⟩⟩
    exact ⟨⟨c.1 * p, by simp only; rw [hp]; ring⟩,
      ⟨c.2 * q, by simp only; rw [hq]; ring⟩⟩

/-- The conductor of the split pinching algebra is exactly `(a) × (a)`. -/
theorem conductor_eq_branchIdeal (a : S) :
    subringConductor (splitPinching a) = branchIdeal a := by
  apply le_antisymm
  · intro x hx
    have hleft := hx (1, 0)
    have hright := hx (0, 1)
    obtain ⟨p, hp⟩ := hleft
    obtain ⟨q, hq⟩ := hright
    refine ⟨⟨p, ?_⟩, ⟨-q, ?_⟩⟩
    · simpa using hp
    · dsimp only at hq ⊢
      rw [mul_neg]
      linear_combination -hq
  · rintro x ⟨⟨p, hp⟩, ⟨q, hq⟩⟩ y
    refine ⟨p * y.1 - q * y.2, ?_⟩
    dsimp only
    rw [hp, hq]
    ring

/-- A scalar embedded diagonally in the product belongs to every split
pinching algebra. -/
def diagonalElement (a s : S) : splitPinching a :=
  ⟨(s, s), ⟨0, by simp⟩⟩

/-- Every element of the product ring is integral over the split pinching
algebra: `(X-u)(X-v)` annihilates the pair `(u,v)`, with both roots embedded
diagonally as coefficients. -/
theorem product_isIntegral (a : S) (x : S × S) :
    IsIntegral (splitPinching a) x := by
  let p : Polynomial (splitPinching a) :=
    (Polynomial.X - Polynomial.C (diagonalElement a x.1)) *
      (Polynomial.X - Polynomial.C (diagonalElement a x.2))
  refine ⟨p, (Polynomial.monic_X_sub_C _).mul (Polynomial.monic_X_sub_C _), ?_⟩
  simp only [p, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
  apply Prod.ext <;> simp [diagonalElement]

/-- The inclusion of the split pinching algebra into `S × S` is an integral
ring extension. -/
theorem algebra_isIntegral (a : S) :
    Algebra.IsIntegral (splitPinching a) (S × S) :=
  product_isIntegral a

/-- If the branch parameter is a unit, the pinching algebra is the whole
product ring. -/
theorem splitPinching_eq_top_of_isUnit {a : S} (ha : IsUnit a) :
    splitPinching a = ⊤ := by
  apply top_unique
  intro x _
  let u : Sˣ := ha.unit
  refine ⟨((u⁻¹ : Sˣ) : S) * (x.1 - x.2), ?_⟩
  rw [← ha.unit_spec]
  change x.1 - x.2 = (u : S) * (((u⁻¹ : Sˣ) : S) * (x.1 - x.2))
  simp

/-- At branch parameter zero, the pinching algebra is the diagonal. -/
theorem mem_splitPinching_zero_iff (x : S × S) :
    x ∈ splitPinching (0 : S) ↔ x.1 = x.2 := by
  constructor
  · rintro ⟨q, hq⟩
    simpa using sub_eq_zero.mp (by simpa using hq)
  · intro h
    exact ⟨0, by simp [h]⟩

end RelativeConicArcs.SplitQuadraticPinching
