import Mathlib.Algebra.CharP.Basic
import Mathlib.Algebra.Ring.Parity
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.Tactic

/-!
# Alternating-binomial bases for Frobenius-digit root equations

Fix a field `K` of characteristic `p`.  On the weight slice indexed by `h < p`, the positive-root
intertwining equation is the triangular recurrence

`(m + 1) * alpha (m + 1) = -(h - m) * alpha m`.

Its solution space is the line generated by

`alpha m = (-1)^m * choose h m`.

For a list of Frobenius digits, imposing this recurrence in every coordinate gives the tensor
product of the one-digit lines.  The terminal theorem proves directly that every solution is the
scalar multiple of the product of the local alternating-binomial coefficients.  A separate
finite-field interpolation theorem records the degree argument that converts equality on all root
parameters into coefficientwise equality.

This module proves the coefficient calculation.  It does not identify these coefficient blocks
with Hom spaces of algebraic or finite special linear groups, construct divided-power maps, or
invoke a classification of simple modules.
-/

namespace RelativeConicArcs.ClebschLucasCoefficientBasis

open Polynomial

noncomputable section

variable {K : Type*} [Field K]

/-- The alternating-binomial coefficient at position `m` in a weight slice of width `h`. -/
def alternatingBinomialCoefficient (h m : ℕ) : K :=
  (-1 : K) ^ m * (Nat.choose h m : K)

/-- The alternating-binomial coefficients satisfy the one-digit positive-root recurrence. -/
theorem alternatingBinomialCoefficient_recurrence (h m : ℕ) :
    ((m + 1 : ℕ) : K) * alternatingBinomialCoefficient (K := K) h (m + 1) =
      -((h - m : ℕ) : K) * alternatingBinomialCoefficient (K := K) h m := by
  have hchoose := Nat.choose_succ_right_eq h m
  have hchooseK :
      (Nat.choose h (m + 1) : K) * ((m + 1 : ℕ) : K) =
        (Nat.choose h m : K) * ((h - m : ℕ) : K) := by
    have hcast := congrArg (fun n : ℕ => (n : K)) hchoose
    simpa only [Nat.cast_mul] using hcast
  rw [alternatingBinomialCoefficient, alternatingBinomialCoefficient, pow_succ]
  calc
    ((m + 1 : ℕ) : K) *
          (((-1 : K) ^ m * -1) * (Nat.choose h (m + 1) : K)) =
        -((-1 : K) ^ m) *
          ((Nat.choose h (m + 1) : K) * ((m + 1 : ℕ) : K)) := by ring
    _ = -((-1 : K) ^ m) *
          ((Nat.choose h m : K) * ((h - m : ℕ) : K)) := by rw [hchooseK]
    _ = -((h - m : ℕ) : K) *
          ((-1 : K) ^ m * (Nat.choose h m : K)) := by ring

/-- A coefficient family satisfies the one-digit root equation through the slice of width `h`. -/
def SatisfiesOneDigitRecurrence (h : ℕ) (alpha : Fin (h + 1) → K) : Prop :=
  ∀ m : Fin h,
    ((m + 1 : ℕ) : K) * alpha ⟨m + 1, by omega⟩ =
      -((h - m : ℕ) : K) * alpha ⟨m, by omega⟩

/-- In characteristic `p`, every positive integer at most `h < p` has nonzero image in `K`. -/
theorem cast_succ_ne_zero_of_lt_char {p h m : ℕ} [CharP K p]
    (hm : m < h) (hp : h < p) : ((m + 1 : ℕ) : K) ≠ 0 := by
  rw [ne_eq, CharP.cast_eq_zero_iff K p]
  exact Nat.not_dvd_of_pos_of_lt (Nat.succ_pos m) (by omega)

/-- Every solution of the one-digit recurrence is determined by its zeroth coefficient. -/
theorem oneDigitRecurrence_eq_scalar_alternatingBinomial
    {p h : ℕ} [CharP K p] (hp : h < p) (alpha : Fin (h + 1) → K)
    (halpha : SatisfiesOneDigitRecurrence h alpha) :
    ∀ m : Fin (h + 1),
      alpha m = alpha 0 * alternatingBinomialCoefficient (K := K) h m := by
  have claim : ∀ (n : ℕ) (hn : n < h + 1),
      alpha ⟨n, hn⟩ = alpha 0 * alternatingBinomialCoefficient (K := K) h n := by
    intro n hn
    induction n with
    | zero => simp [alternatingBinomialCoefficient]
    | succ m ih =>
      have hm' : m < h := by omega
      let index : Fin h := ⟨m, hm'⟩
      have hrec := halpha index
      have hcanonical := alternatingBinomialCoefficient_recurrence (K := K) h m
      have hnonzero : ((m + 1 : ℕ) : K) ≠ 0 := cast_succ_ne_zero_of_lt_char hm' hp
      apply mul_left_cancel₀ hnonzero
      calc
        ((m + 1 : ℕ) : K) * alpha ⟨m + 1, hn⟩
            = -((h - m : ℕ) : K) * alpha ⟨m, by omega⟩ := hrec
        _ = -((h - m : ℕ) : K) *
              (alpha 0 * alternatingBinomialCoefficient (K := K) h m) := by
                rw [ih (by omega)]
        _ = alpha 0 * (((m + 1 : ℕ) : K) *
              alternatingBinomialCoefficient (K := K) h (m + 1)) := by
                rw [hcanonical]
                ring
        _ = ((m + 1 : ℕ) : K) *
              (alpha 0 * alternatingBinomialCoefficient (K := K) h (m + 1)) := by
                ring
  intro m
  exact claim m m.isLt

/-- Reversing a one-digit weight slice multiplies its alternating-binomial coefficient by
`(-1)^h`. -/
theorem alternatingBinomialCoefficient_reverse (h : ℕ) (m : Fin (h + 1)) :
    alternatingBinomialCoefficient (K := K) h (h - m) =
      (-1 : K) ^ h * alternatingBinomialCoefficient (K := K) h m := by
  have hm : (m : ℕ) ≤ h := by omega
  have hparity : Even (h - (m : ℕ)) ↔ Even (h + (m : ℕ)) :=
    (Nat.even_sub' hm).trans Nat.even_add'.symm
  rw [alternatingBinomialCoefficient, alternatingBinomialCoefficient, Nat.choose_symm hm]
  rw [neg_one_pow_congr (R := K) hparity, pow_add]
  ring

/-- The rectangular index set for a list of digit widths. -/
abbrev DigitBox : List ℕ → Type
  | [] => PUnit
  | h :: hs => Fin (h + 1) × DigitBox hs

/-- The all-zero index in a digit box. -/
def DigitBox.zero : (hs : List ℕ) → DigitBox hs
  | [] => PUnit.unit
  | h :: hs => (⟨0, Nat.zero_lt_succ h⟩, DigitBox.zero hs)

/-- Coordinatewise reversal of a digit box. -/
def DigitBox.reverse : (hs : List ℕ) → DigitBox hs → DigitBox hs
  | [], _ => PUnit.unit
  | h :: hs, (m, tail) =>
      (⟨h - m, Nat.lt_succ_of_le (Nat.sub_le h m)⟩, DigitBox.reverse hs tail)

/-- Product of the alternating-binomial coefficients over all digit coordinates. -/
def digitTensorCoefficient : (hs : List ℕ) → DigitBox hs → K
  | [], _ => 1
  | h :: hs, (m, tail) =>
      alternatingBinomialCoefficient (K := K) h m * digitTensorCoefficient hs tail

/-- The coordinatewise triangular root equations on a Frobenius-digit box. -/
def SatisfiesDigitRecurrences : (hs : List ℕ) → (DigitBox hs → K) → Prop
  | [], _ => True
  | h :: hs, alpha =>
      (∀ tail, SatisfiesOneDigitRecurrence h (fun m => alpha (m, tail))) ∧
      (∀ m, SatisfiesDigitRecurrences hs (fun tail => alpha (m, tail)))

/-- Scaling every coefficient preserves all digit recurrences. -/
theorem satisfiesDigitRecurrences_smul (c : K) :
    ∀ (hs : List ℕ) (alpha : DigitBox hs → K),
      SatisfiesDigitRecurrences hs alpha →
        SatisfiesDigitRecurrences hs (fun index => c * alpha index) := by
  intro hs
  induction hs with
  | nil => intro alpha _; trivial
  | cons h hs ih =>
      intro alpha halpha
      rcases halpha with ⟨hhead, htail⟩
      constructor
      · intro tail m
        calc
          (((m : ℕ) + 1 : ℕ) : K) * (c * alpha (⟨m + 1, by omega⟩, tail)) =
              c * ((((m : ℕ) + 1 : ℕ) : K) * alpha (⟨m + 1, by omega⟩, tail)) := by
                ring
          _ = c * (-((h - (m : ℕ) : ℕ) : K) * alpha (⟨m, by omega⟩, tail)) := by
                rw [hhead tail m]
          _ = -((h - (m : ℕ) : ℕ) : K) * (c * alpha (⟨m, by omega⟩, tail)) := by
                ring
      · intro m
        exact ih (fun tail => alpha (m, tail)) (htail m)

/-- The tensor product of the local alternating-binomial coefficient families satisfies every
digit recurrence. -/
theorem digitTensorCoefficient_satisfies :
    ∀ hs : List ℕ,
      SatisfiesDigitRecurrences (K := K) hs (digitTensorCoefficient (K := K) hs) := by
  intro hs
  induction hs with
  | nil => trivial
  | cons h hs ih =>
      constructor
      · intro tail m
        simp only [digitTensorCoefficient]
        calc
          ((((m : ℕ) + 1 : ℕ) : K) *
              (alternatingBinomialCoefficient (K := K) h ((m : ℕ) + 1) *
                digitTensorCoefficient (K := K) hs tail)) =
              (((m : ℕ) + 1 : ℕ) : K) *
                alternatingBinomialCoefficient (K := K) h ((m : ℕ) + 1) *
                  digitTensorCoefficient (K := K) hs tail := by ring
          _ = (-((h - (m : ℕ) : ℕ) : K) *
                alternatingBinomialCoefficient (K := K) h m) *
                  digitTensorCoefficient (K := K) hs tail := by
                    rw [alternatingBinomialCoefficient_recurrence (K := K) h m]
          _ = -((h - (m : ℕ) : ℕ) : K) *
                (alternatingBinomialCoefficient (K := K) h m *
                  digitTensorCoefficient (K := K) hs tail) := by ring
      · intro m
        exact satisfiesDigitRecurrences_smul
          (K := K) (alternatingBinomialCoefficient (K := K) h m) hs
          (digitTensorCoefficient (K := K) hs) ih

/-- Reversing every digit multiplies the tensor coefficient by `(-1)` to the sum of the digit
widths.  This is the tensor-flip sign of the coefficient block. -/
theorem digitTensorCoefficient_reverse :
    ∀ (hs : List ℕ) (index : DigitBox hs),
      digitTensorCoefficient (K := K) hs (DigitBox.reverse hs index) =
        (-1 : K) ^ hs.sum * digitTensorCoefficient (K := K) hs index := by
  intro hs
  induction hs with
  | nil =>
      intro index
      rcases index with ⟨⟩
      simp [digitTensorCoefficient]
  | cons h hs ih =>
      intro index
      rcases index with ⟨m, tail⟩
      simp only [DigitBox.reverse, digitTensorCoefficient, List.sum_cons, pow_add]
      rw [alternatingBinomialCoefficient_reverse (K := K) h m, ih tail]
      ring

/-- If every digit width is below the characteristic, every solution of the digitwise root
equations is a scalar multiple of the product of the local alternating-binomial coefficients. -/
theorem digitRecurrences_eq_scalar_digitTensorCoefficient
    {p : ℕ} [CharP K p] :
    ∀ (hs : List ℕ), (∀ h ∈ hs, h < p) →
      ∀ (alpha : DigitBox hs → K), SatisfiesDigitRecurrences hs alpha →
        ∀ index,
          alpha index = alpha (DigitBox.zero hs) * digitTensorCoefficient (K := K) hs index := by
  intro hs hchar
  induction hs with
  | nil =>
      intro alpha _ index
      rcases index with ⟨⟩
      simp [DigitBox.zero, digitTensorCoefficient]
  | cons h hs ih =>
      intro alpha halpha index
      rcases index with ⟨m, tail⟩
      rcases halpha with ⟨hhead, htail⟩
      have hh : h < p := hchar h (by simp)
      have hslice := oneDigitRecurrence_eq_scalar_alternatingBinomial
        (K := K) hh (fun n => alpha (n, tail)) (hhead tail)
      have hheadValue := hslice m
      have htailChar : ∀ a ∈ hs, a < p := by
        intro a ha
        exact hchar a (List.mem_cons_of_mem h ha)
      have htailValue := ih htailChar (fun rest => alpha (⟨0, Nat.zero_lt_succ h⟩, rest))
        (htail ⟨0, Nat.zero_lt_succ h⟩) tail
      rw [hheadValue]
      change alpha (⟨0, Nat.zero_lt_succ h⟩, tail) *
          alternatingBinomialCoefficient (K := K) h m =
        alpha (⟨0, Nat.zero_lt_succ h⟩, DigitBox.zero hs) *
          (alternatingBinomialCoefficient (K := K) h m *
            digitTensorCoefficient (K := K) hs tail)
      rw [htailValue]
      ring

/-- For digit widths below the characteristic, the complete solution set of the coordinatewise
root equations is exactly the line spanned by the tensor alternating-binomial coefficient. -/
theorem satisfiesDigitRecurrences_iff_exists_scalar_digitTensorCoefficient
    {p : ℕ} [CharP K p] (hs : List ℕ) (hchar : ∀ h ∈ hs, h < p)
    (alpha : DigitBox hs → K) :
    SatisfiesDigitRecurrences hs alpha ↔
      ∃ c : K, alpha = fun index => c * digitTensorCoefficient (K := K) hs index := by
  constructor
  · intro halpha
    refine ⟨alpha (DigitBox.zero hs), ?_⟩
    funext index
    exact digitRecurrences_eq_scalar_digitTensorCoefficient
      (K := K) hs hchar alpha halpha index
  · rintro ⟨c, rfl⟩
    exact satisfiesDigitRecurrences_smul
      (K := K) c hs (digitTensorCoefficient (K := K) hs)
      (digitTensorCoefficient_satisfies (K := K) hs)

section FiniteFieldInterpolation

variable [Fintype K]

/-- Two polynomials of degree below the field cardinality are equal when they agree at every
element of the finite field.  This is the Vandermonde injectivity step for root-orbit matrices. -/
theorem polynomial_eq_of_eval_eq_of_natDegree_lt_card
    (P Q : K[X]) (hP : P.natDegree < Fintype.card K)
    (hQ : Q.natDegree < Fintype.card K)
    (heval : ∀ t : K, P.eval t = Q.eval t) : P = Q := by
  apply Polynomial.eq_of_natDegree_lt_card_of_eval_eq
    P Q Function.injective_id heval
  exact max_lt hP hQ

end FiniteFieldInterpolation

end

end RelativeConicArcs.ClebschLucasCoefficientBasis
