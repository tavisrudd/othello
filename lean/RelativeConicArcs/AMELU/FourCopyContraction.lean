import RelativeConicArcs.AMELU.Definitions
import Mathlib.Data.ZMod.Basic

/-!
# Permutation contractions and an exact four-copy separator

For `m` ket copies and `m` bra copies, a contraction pattern assigns a
permutation of the bra copies to each of the six parties.  Given a
`3 × 6` generator matrix `G`, the matching map sends ket and bra message
vectors to the differences

`(uₐG)ᵢ - (v_(σᵢ(a))G)ᵢ`.

Its rank is the exponent in the equal-phase contraction formula
`q^(3m-rank)`.  This module defines that matching map and rank, the explicit
four-copy pattern and two `𝔽₁₃` generator matrices used by the separator,
and the party-orbit sum of the rank formula.

`FourCopySeparatorInputs` exposes the remaining bridges: equality of the
complex tensor contraction with the rank formula, invariance of its
party-orbit sum under local unitaries, and the two exact finite rank
evaluations.  The terminal theorem proves local-unitary inequivalence from
the values `720·13⁻⁹` and `3024·13⁻⁹`.  The finite evaluations are explicit
certificate inputs; no certificate is hidden as an axiom or generated
declaration.

All definitions and deductions in this module are kernel checked.  It uses
no native evaluation, project-specific axioms, or admitted declarations.
-/

namespace RelativeConicArcs.AMELU

open scoped BigOperators
open Matrix

/-- A choice of one copy permutation at each party. -/
abbrev ContractionPattern (m : ℕ) := Party → Equiv.Perm (Fin m)

/-- The `m` message vectors used to parametrize ket or bra codewords. -/
abbrev CopyMessages (m : ℕ) (𝔽 : Type*) := Fin m → PlaneCoordinate → 𝔽

/-- The codeword generated by the row message `u` and generator matrix `G`. -/
def generatedWord [Semiring 𝔽]
    (G : Matrix PlaneCoordinate Party 𝔽) (u : PlaneCoordinate → 𝔽) :
    BasisLabel 𝔽 :=
  fun i => dotProduct u (fun r => G r i)

@[simp]
theorem generatedWord_add [Field 𝔽]
    (G : Matrix PlaneCoordinate Party 𝔽)
    (u v : PlaneCoordinate → 𝔽) :
    generatedWord G (u + v) = generatedWord G u + generatedWord G v := by
  ext i
  simp only [generatedWord, Pi.add_apply, dotProduct]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro r _
  ring

@[simp]
theorem generatedWord_smul [Field 𝔽]
    (G : Matrix PlaneCoordinate Party 𝔽) (a : 𝔽)
    (u : PlaneCoordinate → 𝔽) :
    generatedWord G (a • u) = a • generatedWord G u := by
  ext i
  simp only [generatedWord, Pi.smul_apply, smul_eq_mul, dotProduct]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  ring

/-- The linear map from row messages to words generated by `G`. -/
def generatorLinearMap [Field 𝔽]
    (G : Matrix PlaneCoordinate Party 𝔽) :
    (PlaneCoordinate → 𝔽) →ₗ[𝔽] BasisLabel 𝔽 where
  toFun := generatedWord G
  map_add' := by
    intro u v
    exact generatedWord_add G u v
  map_smul' := by
    intro a u
    exact generatedWord_smul G a u

/-- The length-six code generated by the rows of `G`. -/
def generatorCode [Field 𝔽]
    (G : Matrix PlaneCoordinate Party 𝔽) :
    Submodule 𝔽 (BasisLabel 𝔽) :=
  LinearMap.range (generatorLinearMap G)

/-- The homogeneous matching system for a permutation contraction. -/
def contractionMatchingMap [Field 𝔽] {m : ℕ}
    (G : Matrix PlaneCoordinate Party 𝔽) (σ : ContractionPattern m) :
    (CopyMessages m 𝔽 × CopyMessages m 𝔽) →ₗ[𝔽]
      (Party → Fin m → 𝔽) where
  toFun := fun x i a =>
    generatedWord G (x.1 a) i -
      generatedWord G (x.2 (σ i a)) i
  map_add' := by
    intro x y
    ext i a
    simp only [Prod.fst_add, Prod.snd_add, Pi.add_apply,
      generatedWord_add]
    ring
  map_smul' := by
    intro c x
    ext i a
    simp only [Prod.smul_fst, Prod.smul_snd, Pi.smul_apply,
      generatedWord_smul, smul_eq_mul]
    simp only [RingHom.id_apply]
    ring

/-- Rank of the `6m` matching equations for a generator and contraction
pattern. -/
noncomputable def contractionMatchingRank [Field 𝔽] [Fintype 𝔽] {m : ℕ}
    (G : Matrix PlaneCoordinate Party 𝔽) (σ : ContractionPattern m) : ℕ :=
  Module.finrank 𝔽 (LinearMap.range (contractionMatchingMap G σ))

/-- Relabel the parties of a contraction pattern. -/
def permuteContractionPattern {m : ℕ} (π : Equiv.Perm Party)
    (σ : ContractionPattern m) : ContractionPattern m :=
  fun i => σ (π.symm i)

/-- Successive party relabellings combine by permutation composition. -/
theorem permuteContractionPattern_trans {m : ℕ}
    (π ρ : Equiv.Perm Party) (σ : ContractionPattern m) :
    permuteContractionPattern π (permuteContractionPattern ρ σ) =
      permuteContractionPattern (ρ.trans π) σ := by
  rfl

/-- The rational value `q^(3m-rank)` supplied by the solution-counting
formula for a normalized equal-phase code state. -/
def contractionValueFromRank (q m rank : ℕ) : ℚ :=
  (q : ℚ) ^ (3 * m) / (q : ℚ) ^ rank

/-- Party-symmetrized rank-formula value of a contraction pattern. -/
noncomputable def contractionRankOrbitSum [Field 𝔽] [Fintype 𝔽]
    (q m : ℕ) (G : Matrix PlaneCoordinate Party 𝔽)
    (σ : ContractionPattern m) : ℚ :=
  ∑ π : Equiv.Perm Party,
    contractionValueFromRank q m
      (contractionMatchingRank G (permuteContractionPattern π σ))

/-- Summing over the complete party orbit removes the choice of a
party-labelled representative of the contraction pattern. -/
theorem contractionRankOrbitSum_permuteContractionPattern
    [Field 𝔽] [Fintype 𝔽]
    (q m : ℕ) (G : Matrix PlaneCoordinate Party 𝔽)
    (ρ : Equiv.Perm Party) (σ : ContractionPattern m) :
    contractionRankOrbitSum q m G (permuteContractionPattern ρ σ) =
      contractionRankOrbitSum q m G σ := by
  let e : Equiv.Perm Party ≃ Equiv.Perm Party := {
    toFun := fun π => ρ.trans π
    invFun := fun π => ρ.symm.trans π
    left_inv := by
      intro π
      ext i
      simp
    right_inv := by
      intro π
      ext i
      simp
  }
  rw [contractionRankOrbitSum, contractionRankOrbitSum]
  simp_rw [permuteContractionPattern_trans]
  simpa [e] using
    (Equiv.sum_comp e
      (fun π =>
        contractionValueFromRank q m
          (contractionMatchingRank G (permuteContractionPattern π σ))))

private noncomputable def finFourEquiv
    (f : Fin 4 → Fin 4) (h : Function.Bijective f) :
    Equiv.Perm (Fin 4) :=
  Equiv.ofBijective f h

/-- The normalized four-copy pattern.  The first party uses the identity;
the five displayed rows are the images of `0,1,2,3` at the remaining
parties. -/
noncomputable def q13FourCopyPattern : ContractionPattern 4 :=
  ![
    Equiv.refl (Fin 4),
    finFourEquiv ![3, 2, 1, 0] (by decide),
    finFourEquiv ![0, 1, 3, 2] (by decide),
    finFourEquiv ![2, 3, 0, 1] (by decide),
    finFourEquiv ![1, 0, 3, 2] (by decide),
    finFourEquiv ![2, 0, 1, 3] (by decide)
  ]

/-- A generator over `𝔽₁₃` for the admitted pencil class with `z=4`. -/
def q13ZFourGenerator : Matrix PlaneCoordinate Party (ZMod 13) :=
  !![
    12, 12, 12, 1, 0, 0;
    5, 7, 12, 0, 1, 0;
    7, 5, 12, 0, 0, 1
  ]

/-- A generator over `𝔽₁₃` for the admitted pencil class with `z=12`. -/
def q13ZTwelveGenerator : Matrix PlaneCoordinate Party (ZMod 13) :=
  !![
    11, 11, 12, 1, 0, 0;
    8, 3, 12, 0, 1, 0;
    3, 8, 12, 0, 0, 1
  ]

private instance primeThirteen : Fact (Nat.Prime 13) :=
  ⟨by decide⟩

/-- Exact mathematical and finite-certificate inputs for the q=13
four-copy separator.  The two `contractionOrbitSum` fields denote the
complex contractions after their common factor has been identified with
a rational number. -/
structure FourCopySeparatorInputs : Type where
  /-- Party-symmetrized four-copy contraction of the `z=4` state. -/
  sourceContractionOrbitSum : ℚ
  /-- Party-symmetrized four-copy contraction of the `z=12` state. -/
  targetContractionOrbitSum : ℚ
  /-- Solution counting identifies the source contraction with the matching
  rank orbit sum. -/
  source_contraction_eq_rankOrbitSum :
    sourceContractionOrbitSum =
      contractionRankOrbitSum 13 4 q13ZFourGenerator q13FourCopyPattern
  /-- Solution counting identifies the target contraction with the matching
  rank orbit sum. -/
  target_contraction_eq_rankOrbitSum :
    targetContractionOrbitSum =
      contractionRankOrbitSum 13 4 q13ZTwelveGenerator q13FourCopyPattern
  /-- Exact finite evaluation of all 720 source ranks. -/
  source_rankOrbitSum_evaluation :
    contractionRankOrbitSum 13 4 q13ZFourGenerator q13FourCopyPattern =
      720 / (13 : ℚ) ^ 9
  /-- Exact finite evaluation of the target histogram: 192 ranks are 20
  and 528 ranks are 21. -/
  target_rankOrbitSum_evaluation :
    contractionRankOrbitSum 13 4 q13ZTwelveGenerator q13FourCopyPattern =
      3024 / (13 : ℚ) ^ 9
  /-- A local-unitary equivalence, including a party permutation, preserves
  the party-symmetrized contraction. -/
  lu_implies_equal_contractionOrbitSum :
    LocallyUnitaryEquivalent
        (equalPhaseState (generatorCode q13ZFourGenerator))
        (equalPhaseState (generatorCode q13ZTwelveGenerator)) →
      sourceContractionOrbitSum = targetContractionOrbitSum

/-- The exact four-copy orbit-sum values rule out local-unitary equivalence
between the two admitted q=13 pencil states, even when party permutations
and a global phase are allowed. -/
theorem q13_zFour_not_locallyUnitaryEquivalent_zTwelve
    (inputs : FourCopySeparatorInputs) :
    ¬ LocallyUnitaryEquivalent
        (equalPhaseState (generatorCode q13ZFourGenerator))
        (equalPhaseState (generatorCode q13ZTwelveGenerator)) := by
  intro hlu
  have heq := inputs.lu_implies_equal_contractionOrbitSum hlu
  rw [inputs.source_contraction_eq_rankOrbitSum,
    inputs.target_contraction_eq_rankOrbitSum,
    inputs.source_rankOrbitSum_evaluation,
    inputs.target_rankOrbitSum_evaluation] at heq
  norm_num at heq

end RelativeConicArcs.AMELU
