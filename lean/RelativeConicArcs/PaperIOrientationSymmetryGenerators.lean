import RelativeConicArcs.PaperIOrientationSymmetryCore
import Mathlib.GroupTheory.IndexNormal

/-!
# Generators of the recovered orientation symmetry

Two permutations of the six-point frame induce a three-cycle and a five-cycle
on the five distinguished matchings.  These generate the alternating group on
the matchings.  A third, odd matching permutation reverses the support signs.
Thus the cubic-line correspondence is reduced to the action of three explicit
frame permutations rather than an enumeration of the full frame symmetric
group.
-/

namespace RelativeConicArcs.PaperIOrientationSymmetry

open Equiv Equiv.Perm
open PaperIOrientationHolonomy

/-- The three-cycle used to generate the even matching action. -/
def matchingThreeCycle : Equiv.Perm (Fin 5) where
  toFun := ![1, 2, 0, 3, 4]
  invFun := ![2, 0, 1, 3, 4]
  left_inv := by decide
  right_inv := by decide

/-- The five-cycle used to generate the even matching action. -/
def matchingFiveCycle : Equiv.Perm (Fin 5) where
  toFun := ![1, 2, 3, 4, 0]
  invFun := ![4, 0, 1, 2, 3]
  left_inv := by decide
  right_inv := by decide

/-- The subgroup generated by the displayed three-cycle and five-cycle. -/
def matchingEvenGenerators : Subgroup (Equiv.Perm (Fin 5)) :=
  Subgroup.closure {matchingThreeCycle, matchingFiveCycle}

private theorem matchingThreeCycle_mem_generators :
    matchingThreeCycle ∈ matchingEvenGenerators := by
  exact Subgroup.subset_closure (by simp)

private theorem matchingFiveCycle_mem_generators :
    matchingFiveCycle ∈ matchingEvenGenerators := by
  exact Subgroup.subset_closure (by simp)

private def generatedThree : matchingEvenGenerators :=
  ⟨matchingThreeCycle, matchingThreeCycle_mem_generators⟩

private def generatedFive : matchingEvenGenerators :=
  ⟨matchingFiveCycle, matchingFiveCycle_mem_generators⟩

private def generatedTwo : matchingEvenGenerators :=
  generatedFive ^ 2 * generatedThree

private theorem orderOf_generatedThree : orderOf generatedThree = 3 := by
  rw [← Subgroup.orderOf_coe generatedThree]
  apply orderOf_eq_prime
  · ext i
    fin_cases i <;> decide
  · intro h
    have h0 := Equiv.congr_fun h 0
    simp [generatedThree, matchingThreeCycle] at h0

private theorem orderOf_generatedFive : orderOf generatedFive = 5 := by
  rw [← Subgroup.orderOf_coe generatedFive]
  apply orderOf_eq_prime
  · ext i
    fin_cases i <;> decide
  · intro h
    have h0 := Equiv.congr_fun h 0
    simp [generatedFive, matchingFiveCycle] at h0

private theorem orderOf_generatedTwo : orderOf generatedTwo = 2 := by
  rw [← Subgroup.orderOf_coe generatedTwo]
  apply orderOf_eq_prime
  · ext i
    fin_cases i <;> decide
  · intro h
    have h0 := Equiv.congr_fun h 0
    simp [generatedTwo, generatedFive, generatedThree, pow_two,
      matchingFiveCycle, matchingThreeCycle] at h0

private theorem matchingEvenGenerators_le_alternating :
    matchingEvenGenerators ≤ alternatingGroup (Fin 5) := by
  apply (Subgroup.closure_le (alternatingGroup (Fin 5))).2
  intro g hg
  rcases hg with (rfl | rfl)
  · change Equiv.Perm.sign matchingThreeCycle = 1
    decide
  · change Equiv.Perm.sign matchingFiveCycle = 1
    decide

private theorem natCard_alternating_fin_five :
    Nat.card (alternatingGroup (Fin 5)) = 60 := by
  rw [Nat.card_eq_fintype_card, card_alternatingGroup]
  norm_num

/-- A three-cycle and a five-cycle in this relative position generate `A₅`.
The proof uses their orders together with simplicity of `A₅`, rather than an
enumeration of its elements. -/
theorem matchingEvenGenerators_eq_alternating :
    matchingEvenGenerators = alternatingGroup (Fin 5) := by
  let K : Subgroup (alternatingGroup (Fin 5)) :=
    matchingEvenGenerators.subgroupOf (alternatingGroup (Fin 5))
  have hcardEquiv : Nat.card K = Nat.card matchingEvenGenerators := by
    exact Nat.card_congr
      (Subgroup.subgroupOfEquivOfLe matchingEvenGenerators_le_alternating)
  have htwo : 2 ∣ Nat.card matchingEvenGenerators := by
    simpa [orderOf_generatedTwo] using orderOf_dvd_natCard generatedTwo
  have hthree : 3 ∣ Nat.card matchingEvenGenerators := by
    simpa [orderOf_generatedThree] using orderOf_dvd_natCard generatedThree
  have hfive : 5 ∣ Nat.card matchingEvenGenerators := by
    simpa [orderOf_generatedFive] using orderOf_dvd_natCard generatedFive
  have hsix : 6 ∣ Nat.card matchingEvenGenerators :=
    Nat.Coprime.mul_dvd_of_dvd_of_dvd (by decide) htwo hthree
  have hthirty : 30 ∣ Nat.card matchingEvenGenerators := by
    exact Nat.Coprime.mul_dvd_of_dvd_of_dvd (by decide) hsix hfive
  have hdvd : Nat.card matchingEvenGenerators ∣ 60 := by
    have h := K.card_subgroup_dvd_card
    rw [hcardEquiv] at h
    rw [natCard_alternating_fin_five] at h
    exact h
  have hcardLe : Nat.card matchingEvenGenerators ≤ 60 :=
    Nat.le_of_dvd (by norm_num) hdvd
  obtain ⟨a, ha⟩ := hthirty
  obtain ⟨b, hb⟩ := hdvd
  have hcardPos : 0 < Nat.card matchingEvenGenerators := by
    rw [← hcardEquiv]
    exact Nat.card_pos
  have hcard_cases : Nat.card matchingEvenGenerators = 30 ∨
      Nat.card matchingEvenGenerators = 60 := by
    omega
  rcases hcard_cases with hcard | hcard
  · have hKcard : Nat.card K = 30 := by simpa [hcardEquiv]
    have hindex : K.index = 2 := by
      rw [Subgroup.index_eq_card]
      have hlagrange := K.card_eq_card_quotient_mul_card_subgroup
      have hA5card : Nat.card (alternatingGroup (Fin 5)) = 60 := by
        exact natCard_alternating_fin_five
      have hquotPos :
          0 < Nat.card ((alternatingGroup (Fin 5)) ⧸ K) := Nat.card_pos
      rw [hA5card, hKcard] at hlagrange
      omega
    letI : K.Normal := K.normal_of_index_eq_two hindex
    letI : IsSimpleGroup (alternatingGroup (Fin 5)) :=
      alternatingGroup.isSimpleGroup (by simp)
    rcases (show K.Normal from inferInstance).eq_bot_or_eq_top with hbot | htop
    · have : Nat.card K = 1 := by rw [hbot]; simp
      omega
    · have : Nat.card K = 60 := by
        rw [htop]
        rw [Subgroup.card_top]
        exact natCard_alternating_fin_five
      omega
  · apply Subgroup.eq_of_le_of_card_ge matchingEvenGenerators_le_alternating
    rw [natCard_alternating_fin_five, hcard]

/-- A six-frame permutation inducing `matchingThreeCycle`. -/
def frameThreeCycle : Equiv.Perm SixPointFrame where
  toFun := ![3, 5, 0, 2, 1, 4]
  invFun := ![2, 4, 3, 0, 5, 1]
  left_inv := by decide
  right_inv := by decide

/-- A six-frame permutation inducing `matchingFiveCycle`. -/
def frameFiveCycle : Equiv.Perm SixPointFrame where
  toFun := ![1, 4, 5, 3, 2, 0]
  invFun := ![5, 0, 4, 3, 1, 2]
  left_inv := by decide
  right_inv := by decide

/-- An odd matching permutation, used as the orientation reverser. -/
def frameOrientationReverser : Equiv.Perm SixPointFrame where
  toFun := ![0, 1, 4, 5, 3, 2]
  invFun := ![0, 1, 5, 4, 2, 3]
  left_inv := by decide
  right_inv := by decide

/-- The three-cycle frame permutation belongs to the matching normalizer. -/
def normalizerThreeCycle : SupportCubicProjectiveStabilizer :=
  ⟨frameThreeCycle, by
    rw [← normalizesDistinguishedMatchings_iff_mem_normalizer]
    decide⟩

/-- The five-cycle frame permutation belongs to the matching normalizer. -/
def normalizerFiveCycle : SupportCubicProjectiveStabilizer :=
  ⟨frameFiveCycle, by
    rw [← normalizesDistinguishedMatchings_iff_mem_normalizer]
    decide⟩

/-- The orientation reverser belongs to the matching normalizer. -/
def normalizerOrientationReverser : SupportCubicProjectiveStabilizer :=
  ⟨frameOrientationReverser, by
    rw [← normalizesDistinguishedMatchings_iff_mem_normalizer]
    decide⟩

/-- The displayed frame three-cycle induces the chosen matching three-cycle. -/
theorem matchingAction_normalizerThreeCycle :
    matchingAction normalizerThreeCycle = matchingThreeCycle := by
  ext i
  fin_cases i <;> decide

/-- The displayed frame five-cycle induces the chosen matching five-cycle. -/
theorem matchingAction_normalizerFiveCycle :
    matchingAction normalizerFiveCycle = matchingFiveCycle := by
  ext i
  fin_cases i <;> decide

/-- The displayed orientation reverser acts oddly on the five matchings. -/
theorem matchingSign_normalizerOrientationReverser :
    Equiv.Perm.sign (matchingAction normalizerOrientationReverser) = -1 := by
  decide

/-- Normalizer elements preserving every support sign form a subgroup. -/
def SupportSignPreservingNormalizer :
    Subgroup SupportCubicProjectiveStabilizer where
  carrier := {sigma | ∀ i j k,
    supportSign (sigma.1 i) (sigma.1 j) (sigma.1 k) = supportSign i j k}
  one_mem' := by intro i j k; rfl
  mul_mem' := by
    intro sigma tau hsigma htau i j k
    change supportSign (sigma.1 (tau.1 i)) (sigma.1 (tau.1 j))
      (sigma.1 (tau.1 k)) = supportSign i j k
    rw [hsigma, htau]
  inv_mem' := by
    intro sigma hsigma i j k
    have h := hsigma (sigma.1⁻¹ i) (sigma.1⁻¹ j) (sigma.1⁻¹ k)
    simpa using h.symm

private theorem normalizerThreeCycle_preservesSupportSign :
    normalizerThreeCycle ∈ SupportSignPreservingNormalizer := by
  intro i j k
  fin_cases i <;> fin_cases j <;> fin_cases k <;> decide

private theorem normalizerFiveCycle_preservesSupportSign :
    normalizerFiveCycle ∈ SupportSignPreservingNormalizer := by
  intro i j k
  fin_cases i <;> fin_cases j <;> fin_cases k <;> decide

/-- Every even permutation of the five matchings is induced by a normalizer
element preserving all support signs. -/
theorem alternating_le_supportSignPreservingNormalizer_map :
    alternatingGroup (Fin 5) ≤
      SupportSignPreservingNormalizer.map matchingAction := by
  rw [← matchingEvenGenerators_eq_alternating]
  apply (Subgroup.closure_le
    (SupportSignPreservingNormalizer.map matchingAction)).2
  intro q hq
  rcases hq with (rfl | rfl)
  · exact ⟨normalizerThreeCycle,
      normalizerThreeCycle_preservesSupportSign,
      matchingAction_normalizerThreeCycle⟩
  · exact ⟨normalizerFiveCycle,
      normalizerFiveCycle_preservesSupportSign,
      matchingAction_normalizerFiveCycle⟩

/-- Even matching action forces preservation of every support sign. -/
theorem preservesSupportSign_of_matchingSign_eq_one
    (sigma : SupportCubicProjectiveStabilizer)
    (hsign : Equiv.Perm.sign (matchingAction sigma) = 1) :
    sigma ∈ SupportSignPreservingNormalizer := by
  have hAlt : matchingAction sigma ∈ alternatingGroup (Fin 5) := by
    rw [alternatingGroup_eq_sign_ker]
    exact hsign
  obtain ⟨tau, htau, hmap⟩ :=
    alternating_le_supportSignPreservingNormalizer_map hAlt
  have heq : tau = sigma := matchingAction_injective (hmap.trans rfl)
  simpa [heq] using htau

/-- The explicit odd normalizer reverses every support sign. -/
theorem normalizerOrientationReverser_reversesSupportSign :
    ∀ i j k, supportSign (normalizerOrientationReverser.1 i)
      (normalizerOrientationReverser.1 j)
      (normalizerOrientationReverser.1 k) = -supportSign i j k := by
  intro i j k
  fin_cases i <;> fin_cases j <;> fin_cases k <;> decide

/-- Odd matching action forces simultaneous reversal of all support signs. -/
theorem reversesSupportSign_of_matchingSign_eq_neg_one
    (sigma : SupportCubicProjectiveStabilizer)
    (hsign : Equiv.Perm.sign (matchingAction sigma) = -1) :
    ∀ i j k, supportSign (sigma.1 i) (sigma.1 j) (sigma.1 k) =
      -supportSign i j k := by
  let tau := normalizerOrientationReverser⁻¹ * sigma
  have htauSign : Equiv.Perm.sign (matchingAction tau) = 1 := by
    simp [tau, matchingSign_normalizerOrientationReverser, hsign]
  have htau := preservesSupportSign_of_matchingSign_eq_one tau htauSign
  have hsigma : normalizerOrientationReverser * tau = sigma := by
    simp [tau]
  intro i j k
  rw [← hsigma]
  change supportSign
    (normalizerOrientationReverser.1 (tau.1 i))
    (normalizerOrientationReverser.1 (tau.1 j))
    (normalizerOrientationReverser.1 (tau.1 k)) = -supportSign i j k
  rw [normalizerOrientationReverser_reversesSupportSign, htau]

/-- All permutations preserving the unoriented support cubic form a
subgroup of the six-frame symmetric group. -/
def SupportCubicLineStabilizer : Subgroup (Equiv.Perm SixPointFrame) where
  carrier := {sigma | PreservesSupportCubicLine sigma}
  one_mem' := Or.inl fun _ _ _ ↦ rfl
  mul_mem' := by
    intro sigma tau hsigma htau
    rcases hsigma with hsigma | hsigma <;>
      rcases htau with htau | htau
    · left
      intro i j k
      change supportSign (sigma (tau i)) (sigma (tau j)) (sigma (tau k)) =
        supportSign i j k
      rw [hsigma, htau]
    · right
      intro i j k
      change supportSign (sigma (tau i)) (sigma (tau j)) (sigma (tau k)) =
        -supportSign i j k
      rw [hsigma, htau]
    · right
      intro i j k
      change supportSign (sigma (tau i)) (sigma (tau j)) (sigma (tau k)) =
        -supportSign i j k
      rw [hsigma, htau]
    · left
      intro i j k
      change supportSign (sigma (tau i)) (sigma (tau j)) (sigma (tau k)) =
        supportSign i j k
      rw [hsigma, htau]
      simp
  inv_mem' := by
    intro sigma hsigma
    rcases hsigma with hsigma | hsigma
    · left
      intro i j k
      have h := hsigma (sigma⁻¹ i) (sigma⁻¹ j) (sigma⁻¹ k)
      simpa using h.symm
    · right
      intro i j k
      have h := hsigma (sigma⁻¹ i) (sigma⁻¹ j) (sigma⁻¹ k)
      simp at h
      have hn := congrArg Neg.neg h
      simpa using hn.symm

/-- The matching normalizer preserves the support cubic line. -/
theorem supportCubicProjectiveStabilizer_le_lineStabilizer :
    SupportCubicProjectiveStabilizer ≤ SupportCubicLineStabilizer := by
  intro sigma hsigma
  let tau : SupportCubicProjectiveStabilizer := ⟨sigma, hsigma⟩
  rcases Int.units_eq_one_or (Equiv.Perm.sign (matchingAction tau)) with h | h
  · left
    exact preservesSupportSign_of_matchingSign_eq_one tau h
  · right
    exact reversesSupportSign_of_matchingSign_eq_neg_one tau h

/-- Six elementary transpositions represent six different support-cubic-line
cosets. -/
def supportCubicLineCosetRepresentative (i : Fin 6) :
    Equiv.Perm SixPointFrame := Equiv.swap 0 i

private theorem supportCubicLineCosetRepresentative_injective :
    Function.Injective (fun i : Fin 6 ↦
      (supportCubicLineCosetRepresentative i :
        (Equiv.Perm SixPointFrame) ⧸ SupportCubicLineStabilizer)) := by
  intro i j hij
  have hmem :
      (supportCubicLineCosetRepresentative i)⁻¹ *
        supportCubicLineCosetRepresentative j ∈
          SupportCubicLineStabilizer :=
    QuotientGroup.eq.mp hij
  change PreservesSupportCubicLine
    ((supportCubicLineCosetRepresentative i)⁻¹ *
      supportCubicLineCosetRepresentative j) at hmem
  fin_cases i <;> fin_cases j
  all_goals first | rfl | exfalso
  all_goals
    revert hmem
    decide

private theorem supportCubicLineStabilizer_card_le :
    Nat.card SupportCubicLineStabilizer ≤ 120 := by
  have hindex : 6 ≤ Nat.card
      ((Equiv.Perm SixPointFrame) ⧸ SupportCubicLineStabilizer) := by
    simpa using Nat.card_le_card_of_injective _
      supportCubicLineCosetRepresentative_injective
  have hlagrange :=
    SupportCubicLineStabilizer.card_eq_card_quotient_mul_card_subgroup
  have hS6card : Nat.card (Equiv.Perm SixPointFrame) = 720 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
    norm_num [SixPointFrame]
  have hmul : 6 * Nat.card SupportCubicLineStabilizer ≤ 720 := by
    calc
      6 * Nat.card SupportCubicLineStabilizer ≤
          Nat.card ((Equiv.Perm SixPointFrame) ⧸ SupportCubicLineStabilizer) *
            Nat.card SupportCubicLineStabilizer :=
        Nat.mul_le_mul_right _ hindex
      _ = 720 := by omega
  omega

/-- The matching normalizer is exactly the support-cubic-line stabilizer. -/
theorem supportCubicProjectiveStabilizer_eq_lineStabilizer :
    SupportCubicProjectiveStabilizer = SupportCubicLineStabilizer := by
  apply Subgroup.eq_of_le_of_card_ge
    supportCubicProjectiveStabilizer_le_lineStabilizer
  have hcard : Nat.card SupportCubicProjectiveStabilizer = 120 := by
    rw [Nat.card_eq_fintype_card]
    exact supportCubicProjectiveStabilizer_card
  rw [hcard]
  exact supportCubicLineStabilizer_card_le

#print axioms matchingEvenGenerators_eq_alternating
#print axioms preservesSupportSign_of_matchingSign_eq_one
#print axioms reversesSupportSign_of_matchingSign_eq_neg_one
#print axioms supportCubicProjectiveStabilizer_eq_lineStabilizer

end RelativeConicArcs.PaperIOrientationSymmetry
