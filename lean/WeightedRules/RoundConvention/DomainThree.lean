import WeightedRules.TableProgram
import WeightedRules.IncrementalReflection
import WeightedRules.OutputConvergence

/-!
# Round conventions on domain 3: producer against synchronous iterate

Generated by `generate_round_convention.py` from `domain-3.json`, itself written by
the producer's `lean_boundary_fixtures` generator. Every source has domain
3, one binary input relation `edge`, one unary derived relation `dist`
with the rule `dist(y) :- dist(x), edge(x, y)`, and the fact `dist(0) = 0`; the
grounding has 13 scalar coordinates. All tables are read from the fixture
file by the elaborator; nothing numeric is transcribed here except the round
counts named in the statements.

For each case, kernel reduction establishes three facts about the producer's
numbers. First, the round count returned with the from-zero certificate is the
least index at which the synchronous iterate from the zero valuation equals
the certified values: the certificate is accepted at that count and rejected at
the preceding one. Second, the sweep count returned by the producer's
incremental update from the held solution is the least replay count at which
the warm iterate from the old values equals the new values, and it lies within
the rule-output bound. Third, three single mutations of each certificate, a
unit perturbation of one finite coordinate, a swap of two distinct values and
a dropped entry, are rejected by the same checker.
-/

namespace WeightedRules.RoundConvention

set_option maxRecDepth 32768
set_option maxHeartbeats 4000000

/-- Case `case0`: the producer's grounding of the base source. -/
def programThree0 : Program Cost 13 := programOfTables 13
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "grounding", "inputs"])
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "grounding", "products"])

/-- Case `case0`: the certified from-zero values. -/
def valuesThree0 : List Cost := costList
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "certificate", "values"])

example : checkCertificate programThree0 3 valuesThree0 = true := by decide +kernel
example : checkCertificate programThree0 2 valuesThree0 = false := by decide +kernel

/-- Case `case0`: the producer's grounding of the improved source. -/
def improvedThree0 : Program Cost 13 := programOfTables 13
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "improvement", "grounding", "inputs"])
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "improvement", "grounding", "products"])

/-- Case `case0`: the values after the incremental update. -/
def improvedValuesThree0 : List Cost := costList
  (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "improvement", "values"])

example : checkImprovementCertificate programThree0 improvedThree0 valuesThree0 1 improvedValuesThree0 = true := by
  decide +kernel
example : checkImprovementCertificate programThree0 improvedThree0 valuesThree0 0 improvedValuesThree0 = false := by
  decide +kernel
example : 1 ≤ ruleOutputBound improvedThree0 := by decide +kernel

example : checkCertificate programThree0 3
    (costList (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "rejected", "drop"])) = false := by
  decide +kernel

example : checkCertificate programThree0 3
    (costList (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "rejected", "perturb"])) = false := by
  decide +kernel

example : checkCertificate programThree0 3
    (costList (nat_table_from_json "../fixtures/round-convention/domain-3.json" at ["cases", "case0", "rejected", "swap"])) = false := by
  decide +kernel

