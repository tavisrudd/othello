import WeightedRules.TableProgram
import WeightedRules.Support

/-!
# Raw scalar programs: cycles, self products and reused outputs

Generated by `generate_round_convention.py` from `raw.json`. Each case is a
scalar program admitted through the producer's raw entry point: six to
twenty-four coordinates with the unit last, inputs drawn from `0..1000` or
absent, and products drawn uniformly, so that cyclic rules, products with
equal factors and outputs reused as factors all occur. For each case the
producer's from-zero round count is checked sharp by replay, the support
certificate is checked in one pass, and three single mutations are rejected
by both checkers.
-/

namespace WeightedRules.SupportConvention

set_option maxRecDepth 32768
set_option maxHeartbeats 4000000

/-- Raw case `case0`: 17 coordinates, 42 products. -/
def raw0 : Program Cost 17 := programOfTables 17
  (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "grounding", "inputs"])
  (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "grounding", "products"])

def rawValues0 : List Cost := costList
  (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "certificate", "values"])

example : checkCertificate raw0 4 rawValues0 = true := by decide +kernel
example : checkCertificate raw0 3 rawValues0 = false := by decide +kernel
example : checkSupportCertificate raw0 rawValues0
    (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "support", "ranks"])
    (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "support", "witnesses"]) = true := by
  decide +kernel

example : checkCertificate raw0 4
    (costList (nat_table_from_json "../fixtures/round-convention/raw.json" at ["cases", "case0", "rejected", "drop"])) = false := by
  decide +kernel
example : checkSupportCertificate raw0
