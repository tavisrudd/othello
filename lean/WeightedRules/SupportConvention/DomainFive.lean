import WeightedRules.TableProgram
import WeightedRules.Support

/-!
# Support certificates on domain 5: one-pass checking of producer output

Generated by `generate_round_convention.py` from `domain-5.json`, the same fixture
family as the round-convention checks. For each case the producer's support
certificate, values with a derivation rank and a rule witness per coordinate,
is checked by `checkSupportCertificate`: local fixedness and well-founded
support, one pass over the coordinates and one over the rules, without
replaying the iteration. The base and the improved program are both checked
from zero this way, so warm and cold witnesses cost the same to check. The
three single mutations of each base certificate are rejected with the base
ranks and witnesses. Statement counts mirror the round-convention module for
the same domain, so the two modules' elaboration times compare the replay
checker with the support checker on identical producer output.
-/

namespace WeightedRules.SupportConvention

set_option maxRecDepth 32768
set_option maxHeartbeats 4000000

/-- Case `case0`: the producer's grounding of the base source. -/
def programFive0 : Program Cost 31 := programOfTables 31
  (nat_table_from_json "../fixtures/round-convention/domain-5.json" at ["cases", "case0", "grounding", "inputs"])
  (nat_table_from_json "../fixtures/round-convention/domain-5.json" at ["cases", "case0", "grounding", "products"])

example : checkSupportCertificate programFive0
    (costList (nat_table_from_json "../fixtures/round-convention/domain-5.json" at ["cases", "case0", "certificate", "values"]))
    (nat_table_from_json "../fixtures/round-convention/domain-5.json" at ["cases", "case0", "support", "ranks"])
    (nat_table_from_json "../fixtures/round-convention/domain-5.json" at ["cases", "case0", "support", "witnesses"]) = true := by
  decide +kernel

