import ProjectiveCap.FiniteQuadraticIsotropy
import Mathlib.LinearAlgebra.BilinearForm.Orthogonal
import Mathlib.LinearAlgebra.QuadraticForm.Radical

/-!
# Quadratic null-cone rigidity infrastructure

Constructive linear-algebra lemmas used to replace the imported null-cone rigidity theorem.  The
first layer builds a normalized hyperbolic pair inside every nondegenerate isotropic quadratic
space in odd characteristic.
-/

namespace ProjectiveCap
namespace QuadraticNullCone

variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]

/-- A nondegenerate quadratic form of dimension at least three over an odd finite field contains
isotropic vectors `e,f` whose polar pairing is one. -/
theorem exists_normalized_isotropic_pair
    (hchar : ringChar K ≠ 2) (Q : QuadraticForm K V) (hQ : Q.Nondegenerate)
    (hdim : 3 ≤ Module.finrank K V) :
    ∃ e f : V, e ≠ 0 ∧ f ≠ 0 ∧ Q e = 0 ∧ Q f = 0 ∧ QuadraticMap.polar Q e f = 1 := by
  letI : Invertible (2 : K) := invertibleOfNonzero (Ring.two_ne_zero hchar)
  obtain ⟨e, he, hQe⟩ :=
    FiniteQuadraticIsotropy.exists_ne_zero_quadraticForm_eq_zero hchar Q hdim
  have hsep : Q.polarBilin.SeparatingLeft :=
    (QuadraticMap.nondegenerate_polar_iff.mpr hQ).1
  obtain ⟨g, hg⟩ : ∃ g : V, QuadraticMap.polar Q e g ≠ 0 := by
    by_contra! hall
    exact he (hsep e (by simpa only [QuadraticMap.polarBilin_apply_apply] using hall))
  let b := QuadraticMap.polar Q e g
  let g' := b⁻¹ • g
  have hb : b ≠ 0 := hg
  have heg' : QuadraticMap.polar Q e g' = 1 := by
    simp only [g', QuadraticMap.polar_smul_right, smul_eq_mul]
    change b⁻¹ * b = 1
    exact inv_mul_cancel₀ hb
  let f := g' - Q g' • e
  have hQf : Q f = 0 := by
    have hQsmul : Q ((-Q g') • e) = 0 := by
      rw [QuadraticMap.map_smul, hQe, smul_zero]
    have hpolar : QuadraticMap.polar Q g' ((-Q g') • e) = -Q g' := by
      rw [QuadraticMap.polar_smul_right, QuadraticMap.polar_comm Q g' e, heg']
      simp
    calc
      Q f = Q g' + Q ((-Q g') • e) +
          QuadraticMap.polar Q g' ((-Q g') • e) := by
        dsimp only [f]
        rw [sub_eq_add_neg, ← neg_smul, QuadraticMap.map_add Q]
      _ = 0 := by rw [hQsmul, hpolar]; ring
  have hef : QuadraticMap.polar Q e f = 1 := by
    simp only [f, QuadraticMap.polar_sub_right, QuadraticMap.polar_smul_right,
      smul_eq_mul, heg']
    have hee : QuadraticMap.polar Q e e = 0 := by
      rw [QuadraticMap.polar, ← two_smul K e, QuadraticMap.map_smul, hQe]
      simp
    rw [hee, mul_zero, sub_zero]
  have hf : f ≠ 0 := by
    intro hf0
    rw [hf0, QuadraticMap.polar_zero_right] at hef
    exact zero_ne_one hef
  exact ⟨e, f, he, hf, hQe, hQf, hef⟩

/-- The subspace generated by the isotropic vectors of a quadratic form. -/
def isotropicSpan (Q : QuadraticForm K V) : Submodule K V :=
  Submodule.span K {v | Q v = 0}

/-- In a nondegenerate isotropic quadratic space over an odd finite field, the isotropic vectors
span the whole space.  The proof is constructive: a normalized hyperbolic pair expresses every
vector as a linear combination of three isotropic vectors. -/
theorem isotropicSpan_eq_top
    (hchar : ringChar K ≠ 2) (Q : QuadraticForm K V) (hQ : Q.Nondegenerate)
    (hdim : 3 ≤ Module.finrank K V) : isotropicSpan Q = ⊤ := by
  obtain ⟨e, f, he, hf, hQe, hQf, hef⟩ :=
    exists_normalized_isotropic_pair hchar Q hQ hdim
  apply top_unique
  intro v _
  let a := QuadraticMap.polar Q v f
  let b := QuadraticMap.polar Q v e
  let w := v - a • e - b • f
  have hee : QuadraticMap.polar Q e e = 0 := by
    rw [QuadraticMap.polar, ← two_smul K e, QuadraticMap.map_smul, hQe]
    simp
  have hff : QuadraticMap.polar Q f f = 0 := by
    rw [QuadraticMap.polar, ← two_smul K f, QuadraticMap.map_smul, hQf]
    simp
  have hwe : QuadraticMap.polar Q w e = 0 := by
    simp only [w, QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left,
      smul_eq_mul, a, b, hee, mul_zero, sub_zero,
      QuadraticMap.polar_comm Q f e, hef, mul_one]
    ring
  have hwf : QuadraticMap.polar Q w f = 0 := by
    simp only [w, QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left,
      smul_eq_mul, a, b, hff, mul_zero, sub_zero, hef, mul_one]
    ring
  let u := e + w - Q w • f
  have hQew : Q (e + w) = Q w := by
    rw [QuadraticMap.map_add Q, hQe, QuadraticMap.polar_comm Q e w, hwe]
    simp
  have hewf : QuadraticMap.polar Q (e + w) f = 1 := by
    rw [QuadraticMap.polar_add_left, hef, hwf, add_zero]
  have hQu : Q u = 0 := by
    have hQsmul : Q ((-Q w) • f) = 0 := by
      rw [QuadraticMap.map_smul, hQf, smul_zero]
    have hpolar : QuadraticMap.polar Q (e + w) ((-Q w) • f) = -Q w := by
      rw [QuadraticMap.polar_smul_right, hewf]
      simp
    calc
      Q u = Q (e + w) + Q ((-Q w) • f) +
          QuadraticMap.polar Q (e + w) ((-Q w) • f) := by
        dsimp only [u]
        rw [sub_eq_add_neg, ← neg_smul, QuadraticMap.map_add Q]
      _ = 0 := by rw [hQew, hQsmul, hpolar]; ring
  have he_mem : e ∈ isotropicSpan Q := Submodule.subset_span hQe
  have hf_mem : f ∈ isotropicSpan Q := Submodule.subset_span hQf
  have hu_mem : u ∈ isotropicSpan Q := Submodule.subset_span hQu
  have hvrepr : v = (a - 1) • e + (b + Q w) • f + u := by
    dsimp only [u, w]
    module
  rw [hvrepr]
  exact (isotropicSpan Q).add_mem
    ((isotropicSpan Q).add_mem ((isotropicSpan Q).smul_mem _ he_mem)
      ((isotropicSpan Q).smul_mem _ hf_mem)) hu_mem

omit [Fintype K] in
/-- The orthogonal complement of a normalized hyperbolic pair in a nondegenerate quadratic space
is again nondegenerate.  In ambient dimension at least five it has dimension at least three. -/
theorem hyperbolicComplement_nondegenerate_and_three_le
    (hchar : ringChar K ≠ 2) (Q : QuadraticForm K V) (hQ : Q.Nondegenerate)
    (hdim : 5 ≤ Module.finrank K V) {e f : V}
    (hQe : Q e = 0) (hQf : Q f = 0) (hef : QuadraticMap.polar Q e f = 1) :
    let H := Submodule.span K ({e, f} : Set V)
    let W := LinearMap.BilinForm.orthogonal Q.polarBilin H
    (Q.restrict W).Nondegenerate ∧ 3 ≤ Module.finrank K W := by
  classical
  letI : Invertible (2 : K) := invertibleOfNonzero (Ring.two_ne_zero hchar)
  let B : LinearMap.BilinForm K V := Q.polarBilin
  let H := Submodule.span K ({e, f} : Set V)
  let W := B.orthogonal H
  have hsymm : B.IsSymm := ⟨fun x y => QuadraticMap.polar_comm Q x y⟩
  have hB : B.Nondegenerate := QuadraticMap.nondegenerate_polar_iff.mpr hQ
  have hee : QuadraticMap.polar Q e e = 0 := by
    rw [QuadraticMap.polar, ← two_smul K e, QuadraticMap.map_smul, hQe]
    simp
  have hff : QuadraticMap.polar Q f f = 0 := by
    rw [QuadraticMap.polar, ← two_smul K f, QuadraticMap.map_smul, hQf]
    simp
  have heH : e ∈ H := Submodule.subset_span (Set.mem_insert e {f})
  have hfH : f ∈ H := Submodule.subset_span (Set.mem_insert_of_mem e (Set.mem_singleton f))
  have hHnondeg : (B.restrict H).Nondegenerate := by
    apply B.nondegenerate_restrict_of_disjoint_orthogonal hsymm.isRefl
    rw [Submodule.disjoint_def]
    intro x hxH hxO
    obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp hxH
    have hb : b = 0 := by
      have ho := hxO e heH
      change QuadraticMap.polar Q e (a • e + b • f) = 0 at ho
      simpa [QuadraticMap.polar_add_right, QuadraticMap.polar_smul_right, hee, hef] using ho
    have ha : a = 0 := by
      have ho := hxO f hfH
      change QuadraticMap.polar Q f (a • e + b • f) = 0 at ho
      rw [QuadraticMap.polar_add_right, QuadraticMap.polar_smul_right,
        QuadraticMap.polar_smul_right, QuadraticMap.polar_comm Q f e, hef, hff, hb] at ho
      simpa using ho
    simp [ha, hb]
  have hcompl : IsCompl H W :=
    B.isCompl_orthogonal_of_restrict_nondegenerate hsymm.isRefl hHnondeg
  have horthorth : B.orthogonal W = H := by
    exact B.orthogonal_orthogonal hB hsymm.isRefl H
  have hWbilin : (B.restrict W).Nondegenerate := by
    apply (B.restrict_nondegenerate_iff_isCompl_orthogonal hsymm.isRefl).mpr
    rw [horthorth]
    exact hcompl.symm
  have hQW : (Q.restrict W).Nondegenerate := by
    apply QuadraticMap.nondegenerate_polar_iff.mp
    have hp : (Q.restrict W).polarBilin = B.restrict W := by
      ext x y
      rfl
    rw [hp]
    exact hWbilin
  have hHdim : Module.finrank K H ≤ 2 := by
    calc
      Module.finrank K H ≤ ({e, f} : Set V).toFinset.card := by
        exact finrank_span_le_card ({e, f} : Set V)
      _ ≤ 2 := by
        rw [Set.toFinset_insert, Set.toFinset_singleton]
        exact Finset.card_insert_le _ _
  have hWrank : Module.finrank K W = Module.finrank K V - Module.finrank K H :=
    B.finrank_orthogonal hB H
  refine ⟨hQW, ?_⟩
  change 3 ≤ Module.finrank K W
  omega

/-- Null-cone rigidity in the exact parabolic headline range.  If `Q` is nondegenerate in
dimension at least five and `R` has exactly the same isotropic vectors, then `R` is a nonzero
scalar multiple of `Q`. -/
theorem exists_nonzero_smul_eq_of_same_zeroLocus
    (hchar : ringChar K ≠ 2) (hdim : 5 ≤ Module.finrank K V)
    (Q : QuadraticForm K V) (hQ : Q.Nondegenerate) (R : QuadraticForm K V)
    (hzero : ∀ v, R v = 0 ↔ Q v = 0) :
    ∃ c : K, c ≠ 0 ∧ R = c • Q := by
  letI : Invertible (2 : K) := invertibleOfNonzero (Ring.two_ne_zero hchar)
  obtain ⟨e, f, he, hf, hQe, hQf, hef⟩ :=
    exists_normalized_isotropic_pair hchar Q hQ (by omega)
  let B : LinearMap.BilinForm K V := Q.polarBilin
  let H := Submodule.span K ({e, f} : Set V)
  let W := B.orthogonal H
  obtain ⟨hQW, hWdim⟩ :=
    hyperbolicComplement_nondegenerate_and_three_le hchar Q hQ hdim hQe hQf hef
  have hspanW : isotropicSpan (Q.restrict W) = ⊤ :=
    isotropicSpan_eq_top hchar (Q.restrict W) hQW hWdim
  have heH : e ∈ H := Submodule.subset_span (Set.mem_insert e {f})
  have hfH : f ∈ H := Submodule.subset_span (Set.mem_insert_of_mem e (Set.mem_singleton f))
  have hRe : R e = 0 := (hzero e).2 hQe
  have hRf : R f = 0 := (hzero f).2 hQf
  let c := QuadraticMap.polar R e f
  have hQef : Q (e + f) = 1 := by
    rw [QuadraticMap.map_add Q, hQe, hQf, hef]
    simp
  have hRef : R (e + f) ≠ 0 := by
    intro hzeroR
    have := (hzero (e + f)).1 hzeroR
    rw [hQef] at this
    exact one_ne_zero this
  have hRef_eq : R (e + f) = c := by
    rw [QuadraticMap.map_add R, hRe, hRf]
    simp [c]
  have hc : c ≠ 0 := by
    intro hc0
    apply hRef
    rw [hRef_eq, hc0]
  let alpha : W →ₗ[K] K := (R.polarBilin e).domRestrict W
  let beta : W →ₗ[K] K := (R.polarBilin f).domRestrict W
  have halpha_iso (w : W) (hw : Q.restrict W w = 0) : alpha w = 0 := by
    change Q (w : V) = 0 at hw
    have hQew : Q (e + (w : V)) = 0 := by
      rw [QuadraticMap.map_add Q, hQe, hw, zero_add]
      have hew : QuadraticMap.polar Q e (w : V) = 0 := w.property e heH
      simpa only [zero_add] using hew
    have hRw : R (w : V) = 0 := (hzero w).2 hw
    have hRew : R (e + (w : V)) = 0 := (hzero _).2 hQew
    rw [QuadraticMap.map_add R, hRe, hRw, zero_add] at hRew
    change QuadraticMap.polar R e (w : V) = 0
    simpa only [zero_add] using hRew
  have hbeta_iso (w : W) (hw : Q.restrict W w = 0) : beta w = 0 := by
    change Q (w : V) = 0 at hw
    have hQfw : Q (f + (w : V)) = 0 := by
      rw [QuadraticMap.map_add Q, hQf, hw, zero_add]
      have hfw : QuadraticMap.polar Q f (w : V) = 0 := w.property f hfH
      simpa only [zero_add] using hfw
    have hRw : R (w : V) = 0 := (hzero w).2 hw
    have hRfw : R (f + (w : V)) = 0 := (hzero _).2 hQfw
    rw [QuadraticMap.map_add R, hRf, hRw, zero_add] at hRfw
    change QuadraticMap.polar R f (w : V) = 0
    simpa only [zero_add] using hRfw
  have halpha : alpha = 0 := by
    apply LinearMap.ext
    intro w
    have hwspan : w ∈ isotropicSpan (Q.restrict W) := by rw [hspanW]; simp
    have hwker : w ∈ LinearMap.ker alpha := by
      apply (Submodule.span_le.mpr ?_) hwspan
      intro u hu
      exact LinearMap.mem_ker.mpr (halpha_iso u hu)
    simpa using LinearMap.mem_ker.mp hwker
  have hbeta : beta = 0 := by
    apply LinearMap.ext
    intro w
    have hwspan : w ∈ isotropicSpan (Q.restrict W) := by rw [hspanW]; simp
    have hwker : w ∈ LinearMap.ker beta := by
      apply (Submodule.span_le.mpr ?_) hwspan
      intro u hu
      exact LinearMap.mem_ker.mpr (hbeta_iso u hu)
    simpa using LinearMap.mem_ker.mp hwker
  have halpha_apply (w : W) : QuadraticMap.polar R e (w : V) = 0 := by
    have := LinearMap.congr_fun halpha w
    exact this
  have hbeta_apply (w : W) : QuadraticMap.polar R f (w : V) = 0 := by
    have := LinearMap.congr_fun hbeta w
    exact this
  have hR_on_W (w : W) : R (w : V) = c * Q (w : V) := by
    let u := e + (w : V) - Q w • f
    have hQew : Q (e + (w : V)) = Q w := by
      rw [QuadraticMap.map_add Q, hQe, zero_add]
      have hew : QuadraticMap.polar Q e (w : V) = 0 := w.property e heH
      rw [hew, add_zero]
    have hQewf : QuadraticMap.polar Q (e + (w : V)) f = 1 := by
      rw [QuadraticMap.polar_add_left, hef]
      have hfw : QuadraticMap.polar Q f (w : V) = 0 := w.property f hfH
      have hwf : QuadraticMap.polar Q (w : V) f = 0 := by
        rw [QuadraticMap.polar_comm Q w f]
        exact hfw
      rw [hwf, add_zero]
    have hQu : Q u = 0 := by
      have hQsmul : Q ((-Q w) • f) = 0 := by
        rw [QuadraticMap.map_smul, hQf, smul_zero]
      have hpolar : QuadraticMap.polar Q (e + (w : V)) ((-Q w) • f) = -Q w := by
        rw [QuadraticMap.polar_smul_right, hQewf]
        simp
      calc
        Q u = Q (e + (w : V)) + Q ((-Q w) • f) +
            QuadraticMap.polar Q (e + (w : V)) ((-Q w) • f) := by
          dsimp only [u]
          rw [sub_eq_add_neg, ← neg_smul, QuadraticMap.map_add Q]
        _ = 0 := by rw [hQew, hQsmul, hpolar]; ring
    have hRu : R u = 0 := (hzero u).2 hQu
    have hRew : R (e + (w : V)) = R w := by
      rw [QuadraticMap.map_add R, hRe, halpha_apply w]
      simp
    have hRewf : QuadraticMap.polar R (e + (w : V)) f = c := by
      rw [QuadraticMap.polar_add_left]
      have hbw : QuadraticMap.polar R (w : V) f = 0 := by
        rw [QuadraticMap.polar_comm R w f]
        exact hbeta_apply w
      rw [hbw, add_zero]
    have hRsmul : R ((-Q w) • f) = 0 := by
      rw [QuadraticMap.map_smul, hRf, smul_zero]
    have hRpolar : QuadraticMap.polar R (e + (w : V)) ((-Q w) • f) = -Q w * c := by
      rw [QuadraticMap.polar_smul_right, hRewf, smul_eq_mul]
    have hformula : R u = R w - Q w * c := by
      calc
        R u = R (e + (w : V)) + R ((-Q w) • f) +
            QuadraticMap.polar R (e + (w : V)) ((-Q w) • f) := by
          dsimp only [u]
          rw [sub_eq_add_neg, ← neg_smul, QuadraticMap.map_add R]
        _ = R w - Q w * c := by rw [hRew, hRsmul, hRpolar]; ring
    rw [hformula] at hRu
    linear_combination hRu
  have hpointwise (v : V) : R v = c * Q v := by
    let a := QuadraticMap.polar Q v f
    let b := QuadraticMap.polar Q v e
    let wv := v - a • e - b • f
    have hee : QuadraticMap.polar Q e e = 0 := by
      rw [QuadraticMap.polar, ← two_smul K e, QuadraticMap.map_smul, hQe]
      simp
    have hff : QuadraticMap.polar Q f f = 0 := by
      rw [QuadraticMap.polar, ← two_smul K f, QuadraticMap.map_smul, hQf]
      simp
    have hwe : QuadraticMap.polar Q wv e = 0 := by
      simp only [wv, QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left,
        smul_eq_mul, a, b, hee, mul_zero, sub_zero,
        QuadraticMap.polar_comm Q f e, hef, mul_one]
      ring
    have hwf : QuadraticMap.polar Q wv f = 0 := by
      simp only [wv, QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left,
        smul_eq_mul, a, b, hff, mul_zero, sub_zero, hef, mul_one]
      ring
    have hwv : wv ∈ W := by
      intro x hxH
      obtain ⟨p, q, rfl⟩ := Submodule.mem_span_pair.mp hxH
      change QuadraticMap.polar Q (p • e + q • f) wv = 0
      rw [QuadraticMap.polar_add_left, QuadraticMap.polar_smul_left,
        QuadraticMap.polar_smul_left, QuadraticMap.polar_comm Q e wv,
        QuadraticMap.polar_comm Q f wv, hwe, hwf]
      simp
    let w : W := ⟨wv, hwv⟩
    have hrepr : v = a • e + b • f + (w : V) := by
      dsimp only [w, wv]
      module
    have hQH : Q (a • e + b • f) = a * b := by
      rw [QuadraticMap.map_add Q, QuadraticMap.map_smul, QuadraticMap.map_smul,
        hQe, hQf, smul_zero, smul_zero, zero_add,
        QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right, hef]
      simp [smul_eq_mul]
    have hRH : R (a • e + b • f) = c * (a * b) := by
      rw [QuadraticMap.map_add R, QuadraticMap.map_smul, QuadraticMap.map_smul,
        hRe, hRf, smul_zero, smul_zero, zero_add,
        QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right]
      simp only [zero_add, smul_eq_mul]
      change a * (b * c) = c * (a * b)
      ring
    have hQcross : QuadraticMap.polar Q (a • e + b • f) w = 0 := by
      rw [QuadraticMap.polar_add_left, QuadraticMap.polar_smul_left,
        QuadraticMap.polar_smul_left]
      have hew : QuadraticMap.polar Q e (w : V) = 0 := w.property e heH
      have hfw : QuadraticMap.polar Q f (w : V) = 0 := w.property f hfH
      rw [hew, hfw]
      simp
    have hRcross : QuadraticMap.polar R (a • e + b • f) w = 0 := by
      rw [QuadraticMap.polar_add_left, QuadraticMap.polar_smul_left,
        QuadraticMap.polar_smul_left, halpha_apply w]
      rw [hbeta_apply w]
      simp
    rw [hrepr, QuadraticMap.map_add R, QuadraticMap.map_add Q, hRH, hQH,
      hR_on_W w, hRcross, hQcross]
    ring
  refine ⟨c, hc, QuadraticMap.ext ?_⟩
  intro v
  change R v = c * Q v
  exact hpointwise v

end QuadraticNullCone
end ProjectiveCap
