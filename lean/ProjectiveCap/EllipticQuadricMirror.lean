import ProjectiveCap.HyperbolicQuadricMirror
import ProjectiveCap.FiniteQuadraticIsotropy
import Mathlib.Algebra.QuadraticDiscriminant

/-!
# Elliptic-quadric norm-block mirror

The proposed elliptic exclusion is false already on the standard norm-block model.  For a
nonsquare `δ`, the binary norm form `x² - δ y²` is anisotropic, while the nonsplit block map
`(x,y) ↦ (δ y,x)` scales it by `-δ` and squares to `δ I`.  Applying the map on every block
therefore gives a fixed-point-free projective involution preserving the zero locus of the sum of
the norm forms.

An odd orthogonal sum of these anisotropic planes is the standard elliptic type.  This file keeps
the formal headline coordinate-exact; transport to an arbitrary presentation of `Q⁻` is a separate
quadratic-form classification interface.
-/

open scoped LinearAlgebra.Projectivization

namespace ProjectiveCap
namespace Projective

open scoped BigOperators

variable {K : Type*} [Field K]
variable {iota : Type*} [Fintype iota]

section Transport

variable {V W : Type*} [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
variable [Fintype (Point K V)] [DecidableEq (Point K V)]
  [Fintype (Point K W)] [DecidableEq (Point K W)]

/-- Cap games on projectively equivalent sub-boards have the same P/N value.  This is the exact
transport interface needed to move the coordinate elliptic theorem to another presentation. -/
theorem isP_subCap_mapLinearEquiv (e : V ≃ₗ[K] W)
    (Q₀ : Point K V → Prop) (Q : Point K W → Prop)
    (hQ : ∀ p, Q (mapLinearEquiv e p) ↔ Q₀ p) (S : Finset (Point K V)) :
    FiniteBuildGame.IsP (SubCap Q) (S.map (mapLinearEquiv e).toEmbedding) ↔
      FiniteBuildGame.IsP (SubCap Q₀) S := by
  apply FiniteBuildGame.isP_equiv (mapLinearEquiv e) _ S
  intro U
  unfold SubCap
  rw [cap_map_mapLinearEquiv]
  apply and_congr Iff.rfl
  constructor
  · intro ht p hp
    apply (hQ p).mp
    exact ht (mapLinearEquiv e p) (by simp [hp])
  · intro hs y hy
    rw [Finset.mem_map] at hy
    obtain ⟨p, hp, rfl⟩ := hy
    exact (hQ p).mpr (hs p hp)

end Transport

/-- The binary norm form for the quadratic algebra generated by a square root of `δ`. -/
def anisotropicPlaneForm (delta : K) (v : K × K) : K :=
  v.1 ^ 2 - delta * v.2 ^ 2

/-- A nonsquare parameter makes the binary norm form anisotropic. -/
theorem anisotropicPlaneForm_eq_zero_iff (delta : K) (hnonsquare : ¬ IsSquare delta)
    (v : K × K) : anisotropicPlaneForm delta v = 0 ↔ v = 0 := by
  constructor
  · intro hv
    by_cases hy : v.2 = 0
    · have hx : v.1 = 0 := by
        have hxpow : v.1 ^ 2 = 0 := by
          simpa [anisotropicPlaneForm, hy] using hv
        by_contra hx
        exact (pow_ne_zero 2 hx) hxpow
      exact Prod.ext hx hy
    · exfalso
      apply hnonsquare
      refine ⟨v.1 / v.2, ?_⟩
      rw [anisotropicPlaneForm, sub_eq_zero] at hv
      field_simp [hy]
      simpa [pow_two] using hv.symm
  · rintro rfl
    simp [anisotropicPlaneForm]

/-- A finite-field norm plane represents every prescribed nonsquare.  This three-variable
Chevalley--Warning argument is the elementary existence input for the even-parity elliptic model. -/
theorem exists_twistedPlane_coefficients [Fintype K]
    (hchar : ringChar K ≠ 2) (delta : K) (hnonsquare : ¬ IsSquare delta) :
    ∃ u w : K, u ≠ 0 ∧ discrim u w (u * delta) = delta := by
  let weights : Fin 3 → K := ![1, -delta, -delta]
  obtain ⟨x, hxne, hx⟩ :=
    FiniteQuadraticIsotropy.exists_ne_zero_weightedSumSquares_eq_zero
      (K := K) (ι := Fin 3) (by decide) weights
  have hxeq : x 0 ^ 2 - delta * x 1 ^ 2 - delta * x 2 ^ 2 = 0 := by
    simp [weights, QuadraticMap.weightedSumSquares_apply, Fin.sum_univ_succ] at hx
    linear_combination hx
  have hx2 : x 2 ≠ 0 := by
    intro hx2
    have hpair : anisotropicPlaneForm delta (x 0, x 1) = 0 := by
      simp only [anisotropicPlaneForm]
      rw [hx2] at hxeq
      norm_num at hxeq
      exact hxeq
    have hzero := (anisotropicPlaneForm_eq_zero_iff delta hnonsquare (x 0, x 1)).1 hpair
    apply hxne
    funext i
    fin_cases i <;> simp_all
  let w := x 0 / x 2
  let z := x 1 / x 2
  have hnorm : w ^ 2 - delta * z ^ 2 = delta := by
    dsimp only [w, z]
    field_simp [hx2]
    linear_combination hxeq
  have hz : z ≠ 0 := by
    intro hz
    apply hnonsquare
    refine ⟨w, ?_⟩
    rw [hz] at hnorm
    norm_num at hnorm
    simpa [pow_two] using hnorm.symm
  let u := z / 2
  have htwo : (2 : K) ≠ 0 := Ring.two_ne_zero hchar
  have hu : u ≠ 0 := div_ne_zero hz htwo
  refine ⟨u, w, hu, ?_⟩
  dsimp only [u]
  rw [discrim]
  have hscale : (4 : K) * (z / 2) * (z / 2 * delta) = delta * z ^ 2 := by
    field_simp [htwo]
    ring
  rw [hscale]
  exact hnorm

/-- The binary tail used in the standard elliptic form.  The coefficient relation from
`exists_twistedPlane_coefficients` makes its discriminant equal to `delta`. -/
def twistedPlaneForm (delta u w : K) (v : K × K) : K :=
  u * v.1 ^ 2 + w * v.1 * v.2 + u * delta * v.2 ^ 2

/-- A binary quadratic form with nonzero leading coefficient and nonsquare discriminant is
anisotropic. -/
theorem twistedPlaneForm_eq_zero_iff (delta u w : K) (hu : u ≠ 0)
    (hdisc : ¬ IsSquare (discrim u w (u * delta))) (v : K × K) :
    twistedPlaneForm delta u w v = 0 ↔ v = 0 := by
  constructor
  · intro hv
    by_cases hy : v.2 = 0
    · have hx : v.1 = 0 := by
        rw [twistedPlaneForm, hy] at hv
        norm_num at hv
        exact hv.resolve_left hu
      exact Prod.ext hx hy
    · let t := v.1 / v.2
      have hroot : u * (t * t) + w * t + u * delta = 0 := by
        simp only [twistedPlaneForm] at hv
        dsimp only [t]
        field_simp [hy]
        linear_combination hv
      have hsquare := discrim_eq_sq_of_quadratic_eq_zero hroot
      exfalso
      apply hdisc
      exact ⟨2 * u * t + w, by simpa [pow_two] using hsquare⟩
  · rintro rfl
    simp [twistedPlaneForm]

/-- The nonsplit block map scales the anisotropic tail by `delta`. -/
theorem twistedPlaneForm_ellipticBlock (delta u w : K) (v : K × K) :
    twistedPlaneForm delta u w (delta * v.2, v.1) =
      delta * twistedPlaneForm delta u w v := by
  simp only [twistedPlaneForm]
  ring

/-- Standard elliptic quadratic expression: hyperbolic pairs plus one anisotropic binary tail. -/
def standardEllipticForm (delta u w : K) (v : Option iota → K × K) : K :=
  (∑ i, (v (some i)).1 * (v (some i)).2) + twistedPlaneForm delta u w (v none)

theorem standardEllipticForm_smul (delta u w c : K) (v : Option iota → K × K) :
    standardEllipticForm delta u w (c • v) =
      c ^ 2 * standardEllipticForm delta u w v := by
  simp only [standardEllipticForm, twistedPlaneForm, Pi.smul_apply, Prod.smul_fst,
    Prod.smul_snd, smul_eq_mul]
  rw [mul_add, Finset.mul_sum]
  congr 1
  · refine Finset.sum_congr rfl (fun i _ => ?_)
    ring
  · ring

/-- The uniform nonsplit block map is a factor-`delta` similarity of the standard elliptic form. -/
theorem standardEllipticForm_ellipticBlock (delta u w : K) (hdelta : delta ≠ 0)
    (v : Option iota → K × K) :
    standardEllipticForm delta u w
        (ellipticBlockLinearEquiv (K := K) (ι := Option iota) delta hdelta v) =
      delta * standardEllipticForm delta u w v := by
  simp only [standardEllipticForm, ellipticBlockLinearEquiv, LinearEquiv.coe_mk,
    LinearMap.coe_mk, AddHom.coe_mk]
  rw [mul_add, Finset.mul_sum]
  congr 1
  · refine Finset.sum_congr rfl (fun i _ => ?_)
    ring
  · exact twistedPlaneForm_ellipticBlock delta u w (v none)

/-- The projective standard elliptic quadric with the displayed coefficients. -/
def OnStandardEllipticQuadric (delta u w : K)
    (p : Point K (Option iota → K × K)) : Prop :=
  standardEllipticForm delta u w p.rep = 0

variable [Fintype (Point K (Option iota → K × K))]
  [DecidableEq (Point K (Option iota → K × K))]

omit [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
theorem onStandardEllipticQuadric_map (delta u w : K) (hdelta : delta ≠ 0)
    {x : Point K (Option iota → K × K)}
    (hx : OnStandardEllipticQuadric (iota := iota) delta u w x) :
    OnStandardEllipticQuadric (iota := iota) delta u w
      (mapEquiv (ellipticBlockLinearEquiv (K := K) (ι := Option iota) delta hdelta) x) := by
  set g := ellipticBlockLinearEquiv (K := K) (ι := Option iota) delta hdelta
  have hrep_eq :
      Projectivization.mk K ((mapEquiv g x).rep) (mapEquiv g x).rep_nonzero =
        Projectivization.mk K (g x.rep) (by simp [x.rep_nonzero]) := by
    rw [Projectivization.mk_rep, ← mapEquiv_mk g x.rep_nonzero,
      Projectivization.mk_rep]
  obtain ⟨c, hc⟩ :=
    (Projectivization.mk_eq_mk_iff' K ((mapEquiv g x).rep) (g x.rep)
      (mapEquiv g x).rep_nonzero (by simp [x.rep_nonzero])).mp hrep_eq
  unfold OnStandardEllipticQuadric at hx ⊢
  calc
    standardEllipticForm delta u w ((mapEquiv g x).rep) =
        standardEllipticForm delta u w (c • g x.rep) := by rw [hc]
    _ = c ^ 2 * standardEllipticForm delta u w (g x.rep) :=
      standardEllipticForm_smul delta u w c (g x.rep)
    _ = c ^ 2 * (delta * standardEllipticForm delta u w x.rep) := by
      rw [standardEllipticForm_ellipticBlock delta u w hdelta x.rep]
    _ = 0 := by rw [hx]; ring

/-- Every displayed standard elliptic quadric with nonsquare discriminant parameter has a
fixed-point-free mirror, hence its cap game is P. -/
theorem initialSubCapP_standardEllipticQuadric_of_nonsquare
    (delta u w : K) (hnonsquare : ¬ IsSquare delta) :
    FiniteBuildGame.IsP (SubCap (OnStandardEllipticQuadric (iota := iota) delta u w))
      (∅ : Finset (Point K (Option iota → K × K))) := by
  have hdelta : delta ≠ 0 := by
    intro hzero
    exact hnonsquare (by simp [hzero])
  refine initialSubCapP_of_linearEquiv_sq_scalar_nonsquare
    (ellipticBlockLinearEquiv (K := K) (ι := Option iota) delta hdelta) delta
    (OnStandardEllipticQuadric (iota := iota) delta u w)
    (ellipticBlockLinearEquiv_sq (K := K) (ι := Option iota) delta hdelta)
    hnonsquare ?_
  intro x hx
  exact onStandardEllipticQuadric_map delta u w hdelta hx

/-- Over every odd finite field, coefficients exist for a standard elliptic tail and its quadric
cap game is P.  The tail's discriminant is the same nonsquare that squares the mirror. -/
theorem exists_standardEllipticQuadric_initialSubCapP [Fintype K]
    (hchar : ringChar K ≠ 2) :
    ∃ delta u w : K, ¬ IsSquare delta ∧ u ≠ 0 ∧
      discrim u w (u * delta) = delta ∧
      (∀ v : K × K, twistedPlaneForm delta u w v = 0 ↔ v = 0) ∧
      FiniteBuildGame.IsP (SubCap (OnStandardEllipticQuadric (iota := iota) delta u w))
        (∅ : Finset (Point K (Option iota → K × K))) := by
  letI : Finite K := Fintype.finite (α := K) inferInstance
  obtain ⟨delta, hdelta⟩ := FiniteField.exists_nonsquare (F := K) hchar
  obtain ⟨u, w, hu, hdisc⟩ := exists_twistedPlane_coefficients hchar delta hdelta
  have htail : ∀ v : K × K, twistedPlaneForm delta u w v = 0 ↔ v = 0 :=
    twistedPlaneForm_eq_zero_iff delta u w hu (by simpa [hdisc] using hdelta)
  exact ⟨delta, u, w, hdelta, hu, hdisc, htail,
    initialSubCapP_standardEllipticQuadric_of_nonsquare delta u w hdelta⟩

/-- Orthogonal sum of binary norm forms. -/
def normBlockForm (delta : K) (v : iota → K × K) : K :=
  ∑ i, anisotropicPlaneForm delta (v i)

omit [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
theorem normBlockForm_smul (delta c : K) (v : iota → K × K) :
    normBlockForm delta (c • v) = c ^ 2 * normBlockForm delta v := by
  simp only [normBlockForm, anisotropicPlaneForm, Pi.smul_apply, Prod.smul_fst,
    Prod.smul_snd, smul_eq_mul]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  ring

omit [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
/-- The nonsplit block map scales each norm block, and hence their sum, by `-δ`. -/
theorem normBlockForm_ellipticBlock (delta : K) (hdelta : delta ≠ 0)
    (v : iota → K × K) :
    normBlockForm delta
        (ellipticBlockLinearEquiv (K := K) (ι := iota) delta hdelta v) =
      -delta * normBlockForm delta v := by
  simp only [normBlockForm, anisotropicPlaneForm]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  change (delta * (v i).2) ^ 2 - delta * (v i).1 ^ 2 =
    -delta * ((v i).1 ^ 2 - delta * (v i).2 ^ 2)
  ring

/-- Points on the projective zero locus of the norm-block form. -/
def OnNormBlockQuadric (delta : K) (p : Point K (iota → K × K)) : Prop :=
  normBlockForm delta p.rep = 0

variable [Fintype (Point K (iota → K × K))]
  [DecidableEq (Point K (iota → K × K))]

omit [Fintype (Point K (iota → K × K))]
    [DecidableEq (Point K (iota → K × K))]
    [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
/-- The nonsplit block map preserves the projective norm-block quadric. -/
theorem onNormBlockQuadric_map (delta : K) (hdelta : delta ≠ 0)
    {x : Point K (iota → K × K)} (hx : OnNormBlockQuadric (iota := iota) delta x) :
    OnNormBlockQuadric (iota := iota) delta
      (mapEquiv (ellipticBlockLinearEquiv (K := K) (ι := iota) delta hdelta) x) := by
  set g := ellipticBlockLinearEquiv (K := K) (ι := iota) delta hdelta
  have hrep_eq :
      Projectivization.mk K ((mapEquiv g x).rep) (mapEquiv g x).rep_nonzero =
        Projectivization.mk K (g x.rep) (by simp [x.rep_nonzero]) := by
    rw [Projectivization.mk_rep, ← mapEquiv_mk g x.rep_nonzero,
      Projectivization.mk_rep]
  obtain ⟨c, hc⟩ :=
    (Projectivization.mk_eq_mk_iff' K ((mapEquiv g x).rep) (g x.rep)
      (mapEquiv g x).rep_nonzero (by simp [x.rep_nonzero])).mp hrep_eq
  unfold OnNormBlockQuadric at hx ⊢
  calc
    normBlockForm delta ((mapEquiv g x).rep) =
        normBlockForm delta (c • g x.rep) := by rw [hc]
    _ = c ^ 2 * normBlockForm delta (g x.rep) := normBlockForm_smul delta c (g x.rep)
    _ = c ^ 2 * (-delta * normBlockForm delta x.rep) := by
      rw [normBlockForm_ellipticBlock delta hdelta x.rep]
    _ = 0 := by rw [hx]; ring

omit [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
/-- The norm-block quadric cap game is P for every nonsquare parameter.  When the number of
blocks is odd, this coordinate form has elliptic type. -/
theorem initialSubCapP_normBlockQuadric_of_nonsquare
    (delta : K) (hnonsquare : ¬ IsSquare delta) :
    FiniteBuildGame.IsP (SubCap (OnNormBlockQuadric (iota := iota) delta))
      (∅ : Finset (Point K (iota → K × K))) := by
  have hdelta : delta ≠ 0 := by
    intro hzero
    exact hnonsquare (by simp [hzero])
  refine initialSubCapP_of_linearEquiv_sq_scalar_nonsquare
    (ellipticBlockLinearEquiv (K := K) (ι := iota) delta hdelta) delta
    (OnNormBlockQuadric (iota := iota) delta)
    (ellipticBlockLinearEquiv_sq (K := K) (ι := iota) delta hdelta)
    hnonsquare ?_
  intro x hx
  exact onNormBlockQuadric_map delta hdelta hx

omit [Fintype (Point K (Option iota → K × K))]
    [DecidableEq (Point K (Option iota → K × K))] in
/-- Odd-cardinality finite fields supply the nonsquare parameter needed by the norm-block mirror. -/
theorem initialSubCapP_normBlockQuadric_of_odd_card [Fintype K]
    (hq : Odd (Fintype.card K)) :
    ∃ delta : K, ¬ IsSquare delta ∧
      FiniteBuildGame.IsP (SubCap (OnNormBlockQuadric (iota := iota) delta))
        (∅ : Finset (Point K (iota → K × K))) := by
  have hchar : ringChar K ≠ 2 := by
    intro hchar
    have hmod : Fintype.card K % 2 = 0 :=
      (FiniteField.even_card_iff_char_two (F := K)).mp hchar
    exact (Nat.not_odd_iff_even.mpr (by rw [Nat.even_iff]; exact hmod)) hq
  letI : Finite K := Fintype.finite (α := K) inferInstance
  obtain ⟨delta, hdelta⟩ := FiniteField.exists_nonsquare (F := K) hchar
  exact ⟨delta, hdelta, initialSubCapP_normBlockQuadric_of_nonsquare delta hdelta⟩

end Projective
end ProjectiveCap
