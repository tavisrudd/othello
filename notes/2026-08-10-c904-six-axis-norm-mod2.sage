#!/usr/bin/env sage
"""Exact mod-2 audit of the six D5 elliptic norm endomorphisms.

The principal lattice is imported without executing the owning script's
main routine.  All calculations are over ZZ/GF(2); no floating point occurs.
"""

from itertools import product


scope = dict(globals())
scope["__name__"] = "c904_import"
source_text = open(
    "notes/2026-08-10-c904-minimal-class-divisor-lattice.sage"
).read()
exec(preparse(source_text), scope)
principal_lattice = scope["principal_lattice"]
ns_integrality_matrix = scope["ns_integrality_matrix"]
congruence_kernel_lattice = scope["congruence_kernel_lattice"]
coefficient_matrix = scope["coefficient_matrix"]
generated_axis_group = scope["generated_axis_group"]


def coefficient_norms():
    """Six matrices N_i=5P_i in the first-five-axis basis."""
    gram = 6 * identity_matrix(ZZ, 5) - matrix(ZZ, 5, 5, [1] * 25)
    result = []
    for index in range(5):
        value = zero_matrix(ZZ, 5)
        value[index, :] = gram[index, :]
        result.append(value)
    result.append(matrix(ZZ, 5, 5, [1] * 25))
    identity = identity_matrix(ZZ, 5)
    assert sum(result, zero_matrix(ZZ, 5)) == 6 * identity
    assert all(value * value == 5 * value for value in result)
    assert all(
        result[i] * result[j] * result[i] == result[i]
        for i in range(6) for j in range(6) if i != j
    )
    assert all(value.transpose() * gram == gram * value for value in result)
    return gram, result


def principal_norms():
    gram, norms = coefficient_norms()
    actual_gram, _, basis, symplectic = principal_lattice("omega", 1)
    assert actual_gram == gram
    zero = zero_matrix(ZZ, 5)
    source_symplectic = block_matrix(ZZ, [[zero, gram], [-gram, zero]])
    assert basis * source_symplectic * basis.transpose() == symplectic

    # Rows of `basis` are principal-lattice vectors in source coordinates.
    # A column action diag(N_i,N_i) therefore acts on row vectors by its
    # transpose, giving M_i B = B diag(N_i,N_i)^t.
    transported = []
    for norm in norms:
        source_action = block_diagonal_matrix(norm, norm)
        value = basis * source_action.transpose() * basis.inverse()
        assert value.denominator() == 1
        value = value.change_ring(ZZ)
        transported.append(value)
    identity = identity_matrix(ZZ, 10)
    assert sum(transported, zero_matrix(ZZ, 10)) == 6 * identity
    assert all(value * value == 5 * value for value in transported)
    assert all(
        transported[i] * transported[j] * transported[i] == transported[i]
        for i in range(6) for j in range(6) if i != j
    )
    return basis, symplectic, transported


def combination_audit(norms):
    field = GF(2)
    identity2 = identity_matrix(field, 10)
    records = []
    invertible = []
    for bits in product((0, 1), repeat=6):
        integral = sum(
            (bit * norm for bit, norm in zip(bits, norms)),
            zero_matrix(ZZ, 10),
        )
        reduced = integral.change_ring(field)
        record = (bits, reduced.rank(), ZZ(integral.det()))
        assert reduced.rank() == 2 * min(sum(bits), 6 - sum(bits))
        records.append(record)
        if reduced.rank() == 10:
            assert reduced.is_invertible()
            assert integral.det() % 2
            invertible.append((bits, integral, integral.charpoly(), integral.det()))
    rank_histogram = {
        rank: sum(record[1] == rank for record in records)
        for rank in sorted(set(record[1] for record in records))
    }
    assert sum(rank_histogram.values()) == 64
    return rank_histogram, invertible, records


def fano_fibre_degree_audit(basis, coefficient_norms_values):
    """Degree ideal of divisor cuts of each D5 fibration on the Fano surface."""
    gram = 6 * identity_matrix(ZZ, 5) - matrix(ZZ, 5, 5, [1] * 25)
    positions, linear_map = ns_integrality_matrix(basis)
    _, ns_lattice = congruence_kernel_lattice(linear_map)
    ns_basis = ns_lattice.basis_matrix().LLL()
    degree_rows = []
    for axis_index, axis_norm in enumerate(coefficient_norms_values):
        degrees = []
        for coordinates in ns_basis.rows():
            divisor_coefficient = coefficient_matrix(coordinates, positions)
            divisor_norm = gram.inverse() * divisor_coefficient
            degree = (
                divisor_norm.trace() * axis_norm.trace()
                - (divisor_norm * axis_norm).trace()
            )
            assert degree.denominator() == 1
            degrees.append(ZZ(degree))
        # NS(F)/a^*NS(J)=Z/2 is generated by C_s, and C_s.F_H=10.
        degree_gcd = gcd(degrees + [ZZ(10)])
        # Compute the integral D5-fixed sublattice.  It is the only channel
        # in which a divisor cut can land purely on the marked elliptic axis.
        group = generated_axis_group()
        if axis_index < 5:
            axis_vector = vector(ZZ, [1 if i == axis_index else 0 for i in range(5)])
        else:
            axis_vector = vector(ZZ, [-1] * 5)
        stabilizer = [action for action in group if action * axis_vector == axis_vector]
        assert len(stabilizer) == 10
        relations = []
        for action in stabilizer:
            transform_rows = []
            for position_index in range(len(positions)):
                coordinate = vector(ZZ, [1 if i == position_index else 0
                                         for i in range(len(positions))])
                coefficient = coefficient_matrix(coordinate, positions)
                image = action.transpose() * coefficient * action
                transform_rows.append(vector(ZZ, [image[i, j] for i, j in positions]))
            transform = matrix(ZZ, transform_rows)
            relations.extend((ns_basis * transform - ns_basis).transpose().rows())
        fixed_coordinates = matrix(ZZ, relations).right_kernel().basis_matrix()
        fixed_ns = fixed_coordinates * ns_basis
        fixed_degrees = []
        for coordinates in fixed_ns.rows():
            divisor_coefficient = coefficient_matrix(coordinates, positions)
            divisor_norm = gram.inverse() * divisor_coefficient
            degree = (
                divisor_norm.trace() * axis_norm.trace()
                - (divisor_norm * axis_norm).trace()
            )
            assert degree.denominator() == 1
            fixed_degrees.append(ZZ(degree))
        fixed_degree_gcd = gcd(fixed_degrees + [ZZ(10)])
        degree_rows.append((degrees, degree_gcd, fixed_degrees, fixed_degree_gcd))
    assert all(item[1] == 2 for item in degree_rows)
    assert all(item[3] == 10 for item in degree_rows)
    return degree_rows


def main():
    _, coefficient_norms_values = coefficient_norms()
    basis, symplectic, norms = principal_norms()
    rank_histogram, invertible, records = combination_audit(norms)
    degree_rows = fano_fibre_degree_audit(basis, coefficient_norms_values)
    print("C904 six D5 norm mod-2 audit")
    print(f"  principal basis denominator={basis.denominator()}")
    print(f"  principal symplectic determinant={symplectic.det()}")
    print("  norm identities: N_i^2=5N_i; N_iN_jN_i=N_i; sum N_i=6I")
    print(f"  mod2 rank histogram={rank_histogram}")
    print(f"  invertible combinations={len(invertible)}")
    if invertible:
        for bits, value, polynomial, determinant in invertible:
            coefficients = list(polynomial)
            print(
                f"  invertible bits={''.join(map(str, bits))} "
                f"det={determinant} charpoly={polynomial} coeffs={coefficients}"
            )
            # Cayley--Hamilton supplies adj(A) as an integral polynomial.
            degree = value.nrows()
            adjugate_polynomial = zero_matrix(ZZ, degree)
            for exponent in range(degree):
                adjugate_polynomial += (
                    (-1) ** (degree - 1 - exponent)
                    * coefficients[exponent + 1]
                    * (value ** exponent)
                )
            assert adjugate_polynomial == value.adjugate()
            assert adjugate_polynomial * value == determinant * identity_matrix(ZZ, degree)
            bezout_two = (1 - determinant) // 2
            assert adjugate_polynomial * value + bezout_two * (2 * identity_matrix(ZZ, degree)) == identity_matrix(ZZ, degree)
            print(f"    identity=adj(A)A+({bezout_two})(2I)")
    else:
        max_rank = max(record[1] for record in records)
        witnesses = [record for record in records if record[1] == max_rank]
        print(f"  maximum mod2 rank={max_rank}; witnesses={len(witnesses)}")
        print(
            "  max-rank bitsets="
            + ",".join("".join(map(str, record[0])) for record in witnesses)
        )
    print(
        "  Fano divisor-cut degree ideals="
        + str(tuple(item[1] for item in degree_rows))
        + " (including C_s.F_H=10)"
    )
    print(
        "  D5-fixed divisor-cut degree ideals="
        + str(tuple(item[3] for item in degree_rows))
        + " (primitive axis channel)"
    )
    print("  graph-transpose alone has wrong codimension; incidence cut induces 2*i_H")
    print("PASS")


if __name__ == "__main__":
    main()
