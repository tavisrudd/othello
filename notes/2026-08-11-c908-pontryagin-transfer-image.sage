#!/usr/bin/env sage
"""Sub-B2 working certificate: Pontryagin transfer into the (1,5) escape group.

Scratchpad computation (NOT committed).

Objects, all on the exotic principal lattice Lambda of rank ten from
notes/2026-08-10-c904-minimal-class-divisor-lattice.sage:

  Theta         = two_form(symplectic) in ^2 Lambda (corpus convention)
  Theta^[k]     = Theta^k / k!, the divided powers, built two ways
  L_k           = Theta ^ (-) : ^k Lambda -> ^(k+2) Lambda
  Q_15          = ^7 Lambda / L_5(^5 Lambda) = (Z/2)^10, the escape group
  PD            = Poincare duality ^k -> ^(10-k) from the unimodular wedge
                  pairing ^k (x) ^(10-k) -> ^10 = Z, standard basis, fixed
                  orientation e_0^...^e_9
  x * y         = PD^{-1}(PD(x) ^ PD(y)), the Pontryagin product

Items:
 (a) 3*(Theta^[3] ^ a) lies in L_5(^5 Lambda) exactly, over Z, for every basis
     vector a; hence [Theta^[3] ^ a] = 0 in Q_15.
 (b) the H^2 (x) H^3 channel: E(u,z) = (u ^ Theta^[3]) * zeta_z with
     PD(zeta_z) = z; F_2-dimension of the span of all [E(u,z)] in Q_15.
 (c) elementary divisors of the lattice in ^7 Lambda generated by
     L_5(^5 Lambda) together with all classes from (a) and (b).
 (d) control: Theta ^ Theta^[2] = 3 Theta^[3] exactly, and wedged with each a.
 (e) rank profile of the bilinear map (u,z) -> [E(u,z)].

No randomness; canonical lexicographic enumeration throughout.
"""

from contextlib import redirect_stdout
from io import StringIO
from itertools import combinations
import argparse
import hashlib
import json
import sys

SCHEMA_VERSION = "subB2-pontryagin-transfer/1"
DIM = 10
TOP = tuple(range(DIM))

_saved_argv = list(sys.argv)
sys.argv = [sys.argv[0], "--export-constants"]
with redirect_stdout(StringIO()):
    load("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage")
sys.argv = _saved_argv


# ------------------------------------------------------- form arithmetic ----

def add_forms(left, right):
    result = dict(left)
    for indices, value in right.items():
        total = result.get(indices, 0) + value
        if total:
            result[indices] = total
        elif indices in result:
            del result[indices]
    return result


def scale_form(scalar, form):
    if scalar == 0:
        return {}
    return {indices: scalar * value for indices, value in form.items()}


def divide_form(form, divisor):
    for value in form.values():
        assert value % divisor == 0, "divided power is not integral"
    return {indices: value // divisor for indices, value in form.items()}


def form_vector(form, degree):
    index = list(combinations(range(DIM), degree))
    return vector(ZZ, [form.get(item, 0) for item in index])


def complement(indices):
    return tuple(i for i in range(DIM) if i not in indices)


def orientation_sign(indices):
    """e_I ^ e_{I^c} = sign * e_0^...^e_9."""
    return wedge({tuple(indices): ZZ.one()},
                 {complement(indices): ZZ.one()}).get(TOP, 0)


def poincare_dual(form):
    result = {}
    for indices, value in form.items():
        result[complement(indices)] = orientation_sign(indices) * value
    return {k: v for k, v in result.items() if v}


def poincare_dual_inverse(form):
    result = {}
    for indices, value in form.items():
        result[complement(indices)] = orientation_sign(complement(indices)) * value
    return {k: v for k, v in result.items() if v}


def pontryagin(left, right):
    return poincare_dual_inverse(wedge(poincare_dual(left),
                                       poincare_dual(right)))


def basis_form(indices):
    return {tuple(indices): ZZ.one()}


def lefschetz_matrix(theta, source_degree):
    """Verbatim from notes/2026-08-11-c908-m-cross-m-exceptional-residue.sage."""
    source = list(combinations(range(DIM), source_degree))
    target = list(combinations(range(DIM), source_degree + 2))
    position = {J: n for n, J in enumerate(target)}
    result = zero_matrix(ZZ, len(source), len(target))
    for row, I in enumerate(source):
        for indices, value in wedge(theta, basis_form(I)).items():
            result[row, position[indices]] = value
    return source, target, result


def elementary_divisor_counts(matrix_value):
    counts = {}
    for value in matrix_value.elementary_divisors():
        if value == 0:
            continue
        key = str(abs(value))
        counts[key] = counts.get(key, 0) + 1
    return dict(sorted(counts.items(), key=lambda item: int(item[0])))


def canonicalize(value):
    if value is None or isinstance(value, (bool, str)):
        return value
    if isinstance(value, dict):
        return {str(key): canonicalize(entry) for key, entry in value.items()}
    if isinstance(value, (list, tuple)):
        return [canonicalize(entry) for entry in value]
    if isinstance(value, int):
        return int(value)
    try:
        return int(value)
    except (TypeError, ValueError):
        return str(value)


def sha256_of(path):
    with open(path, "rb") as stream:
        return hashlib.sha256(stream.read()).hexdigest()


# ------------------------------------------------------------------- main ----

def main(json_path=None, out_path=None):
    record = {"schema": SCHEMA_VERSION}
    field = GF(2)

    _, _, basis, symplectic = principal_lattice("omega", 1)
    assert abs(symplectic.det()) == 1
    theta = two_form(symplectic)

    # ---- 1. divided powers -------------------------------------------------
    powers = {1: theta}
    for degree in range(2, 6):
        powers[degree] = wedge(powers[degree - 1], theta)
    divided = {degree: divide_form(powers[degree], factorial(degree))
               for degree in powers}
    for degree in divided:
        assert scale_form(factorial(degree), divided[degree]) == powers[degree]
    record["divided_powers"] = {
        "integrality_verified_for_k": sorted(int(k) for k in divided),
        "check_k_factorial_times_divided_equals_power": True,
        "support_sizes": {str(k): int(len(divided[k])) for k in sorted(divided)},
        "content_gcd_of_theta_power_k":
            {str(k): int(gcd(list(powers[k].values()))) for k in sorted(powers)},
        "top_divided_power_is_the_orientation":
            bool(divided[5] == {TOP: divided[5].get(TOP, 0)}
                 and abs(divided[5].get(TOP, 0)) == 1),
    }

    # symplectic-pair construction, as an independent build of Theta^[k]
    pair_check = {"available": False}
    try:
        standard, change = symplectic.symplectic_form()
        transform = (change.transpose()).inverse()
        assert transform.denominator() == 1
        transform = transform.change_ring(ZZ)
        pairs = [(a, b) for a in range(DIM) for b in range(a + 1, DIM)
                 if standard[a, b] != 0]
        vectors = [{(i,): ZZ(transform[a, i]) for i in range(DIM)
                    if transform[a, i]} for a in range(DIM)]
        pair_forms = [scale_form(ZZ(standard[a, b]),
                                 wedge(vectors[a], vectors[b]))
                      for a, b in pairs]
        rebuilt = {}
        for item in pair_forms:
            rebuilt = add_forms(rebuilt, item)
        pair_check = {
            "available": True,
            "number_of_symplectic_pairs": int(len(pairs)),
            "theta_equals_sum_of_pair_products": bool(rebuilt == theta),
        }
        for degree in (2, 3, 4):
            assembled = {}
            for subset in combinations(range(len(pairs)), degree):
                term = {(): ZZ.one()}
                for index in subset:
                    term = wedge(term, pair_forms[index])
                assembled = add_forms(assembled, term)
            pair_check[f"divided_power_{degree}_matches"] = \
                bool(assembled == divided[degree])
    except Exception as error:                        # pragma: no cover
        pair_check = {"available": False, "reason": str(error)}
    record["divided_powers"]["symplectic_pair_construction"] = pair_check

    # ---- 2. the escape group Q_15 -----------------------------------------
    _, septics, lefschetz_57 = lefschetz_matrix(theta, 5)
    image_lattice = span(ZZ, lefschetz_57.rows())
    ambient = VectorSpace(field, len(septics))
    image_mod_two = ambient.subspace(
        [vector(field, row) for row in lefschetz_57.rows()])
    quotient = ambient.quotient(image_mod_two)
    record["escape_group"] = {
        "septic_rank": int(len(septics)),
        "image_rank_over_Z": int(image_lattice.rank()),
        "elementary_divisors_of_L5": elementary_divisor_counts(lefschetz_57),
        "f2_dimension_of_Q15": int(quotient.dimension()),
    }
    assert quotient.dimension() == 10

    def project(form):
        return quotient(vector(field, form_vector(form, 7)))

    def span_dimension(classes):
        if not classes:
            return 0
        return matrix(field, [list(item) for item in classes]).rank()

    # ---- (a) the Theta^[3] ^ a channel ------------------------------------
    a_vectors = []
    a_classes = []
    a_membership = []
    for index in range(DIM):
        form = wedge(divided[3], basis_form((index,)))
        vector_value = form_vector(form, 7)
        a_vectors.append(vector_value)
        a_membership.append(bool(3 * vector_value in image_lattice))
        a_classes.append(project(form))
    record["a_theta3_wedge_lambda"] = {
        "three_times_class_lies_in_image_of_L5_over_Z_for_every_a":
            bool(all(a_membership)),
        "individual_membership": [bool(v) for v in a_membership],
        "class_itself_in_image_over_Z":
            [bool(v in image_lattice) for v in a_vectors],
        "f2_dimension_of_the_span_in_Q15": int(span_dimension(a_classes)),
        "reason": "Theta ^ Theta^[2] = 3 Theta^[3], so 3 Theta^[3] ^ a = "
                  "L_5(Theta^[2] ^ a); since Q_15 has exponent two, 3[x] = [x] "
                  "= 0",
    }

    # ---- (d) the integral control identity --------------------------------
    control = wedge(theta, divided[2])
    control_ok = bool(control == scale_form(3, divided[3]))
    per_vector = all(
        wedge(control, basis_form((index,)))
        == scale_form(3, wedge(divided[3], basis_form((index,))))
        for index in range(DIM))
    record["d_control_identity"] = {
        "theta_wedge_theta2_equals_three_theta3": control_ok,
        "identity_holds_after_wedging_with_every_basis_vector": bool(per_vector),
        "theta_wedge_theta3_equals_four_theta4":
            bool(wedge(theta, divided[3]) == scale_form(4, divided[4])),
    }
    assert control_ok and per_vector

    # ---- (b) the H^2 (x) H^3 channel --------------------------------------
    two_indices = list(combinations(range(DIM), 2))
    zeta = []
    for index in range(DIM):
        dual_form = poincare_dual_inverse(basis_form((index,)))
        assert poincare_dual(dual_form) == basis_form((index,))
        zeta.append(dual_form)

    e_classes = []
    e_vectors = []
    by_z = {index: [] for index in range(DIM)}
    by_u = {position: [] for position in range(len(two_indices))}
    for position, pair in enumerate(two_indices):
        eight = wedge(basis_form(pair), divided[3])
        for index in range(DIM):
            value = pontryagin(eight, zeta[index])
            vector_value = form_vector(value, 7)
            e_vectors.append(vector_value)
            cls = project(value)
            e_classes.append(cls)
            by_z[index].append(cls)
            by_u[position].append(cls)
    total_dimension = span_dimension(e_classes)
    span_basis = matrix(field, [list(item) for item in e_classes]).row_space()
    record["b_h2_h3_channel"] = {
        "number_of_pairs": int(len(e_classes)),
        "u_ranges_over": "all 45 basis bivectors e_i ^ e_j",
        "z_ranges_over": "all 10 basis vectors, via zeta with PD(zeta)=z",
        "f2_dimension_of_the_span_in_Q15": int(total_dimension),
        "span_is_all_of_Q15": bool(total_dimension == 10),
        "span_basis_in_Q15_coordinates":
            [[int(v) for v in row] for row in span_basis.basis()],
        "integral_rank_of_the_E_lattice":
            int(matrix(ZZ, e_vectors).rank()),
    }

    # (b)(iii) the u = Theta subfamily
    theta_eight = wedge(theta, divided[3])
    theta_classes = [project(pontryagin(theta_eight, zeta[index]))
                     for index in range(DIM)]
    record["b_h2_h3_channel"]["u_equals_theta_subfamily"] = {
        "theta_wedge_theta3_equals_four_theta4":
            bool(theta_eight == scale_form(4, divided[4])),
        "content_gcd_of_theta_wedge_theta3":
            int(gcd(list(theta_eight.values()))),
        "f2_dimension_of_the_span_in_Q15": int(span_dimension(theta_classes)),
        "reading": "Theta ^ Theta^[3] = 4 Theta^[4] is divisible by four, so the "
                   "whole u = Theta subfamily is even and dies in Q_15",
    }

    # ---- (c) the combined transfer lattice --------------------------------
    combined_rows = ([list(row) for row in lefschetz_57.rows()]
                     + [list(v) for v in a_vectors]
                     + [list(v) for v in e_vectors])
    combined = matrix(ZZ, combined_rows)
    combined_lattice = span(ZZ, combined.rows())
    counts = elementary_divisor_counts(combined)
    record["c_combined_transfer_lattice"] = {
        "generator_count": int(combined.nrows()),
        "rank": int(combined.rank()),
        "elementary_divisor_counts": counts,
        "is_all_of_wedge7": bool(counts == {"1": 120}),
        "index_in_wedge7": str(combined_lattice.index_in(ZZ ** len(septics)))
            if combined.rank() == len(septics) else "infinite",
        "escape_dimension_still_unhit":
            int(sum(count for key, count in counts.items() if int(key) > 1)),
    }

    # ---- (e) rank profile --------------------------------------------------
    per_z = [int(span_dimension(by_z[index])) for index in range(DIM)]
    per_u = [int(span_dimension(by_u[position]))
             for position in range(len(two_indices))]
    histogram = {}
    for value in per_u:
        histogram[str(value)] = histogram.get(str(value), 0) + 1

    # does the per-u dimension track the vanishing of the polarization entry?
    cross_tabulation = {}
    for position, pair in enumerate(two_indices):
        key = (f"dim{per_u[position]}",
               "S_ij nonzero" if symplectic[pair[0], pair[1]] != 0
               else "S_ij zero")
        cross_tabulation[str(key)] = cross_tabulation.get(str(key), 0) + 1
    parity_tabulation = {}
    for position, pair in enumerate(two_indices):
        key = (f"dim{per_u[position]}",
               f"S_ij mod 2 = {int(symplectic[pair[0], pair[1]]) % 2}")
        parity_tabulation[str(key)] = parity_tabulation.get(str(key), 0) + 1

    # for each z the span is a hyperplane in Q_15; are the ten hyperplanes
    # distinct, and do their annihilators span the dual?
    annihilators = []
    for index in range(DIM):
        rows = matrix(field, [list(item) for item in by_z[index]])
        annihilators.extend(list(rows.right_kernel().basis()))
    annihilator_rank = (int(matrix(field, annihilators).rank())
                        if annihilators else 0)
    record["e_rank_profile"] = {
        "dimension_of_span_over_u_for_each_z": per_z,
        "histogram_of_dimension_of_span_over_z_for_each_u":
            dict(sorted(histogram.items(), key=lambda item: int(item[0]))),
        "max_single_u_dimension": int(max(per_u)) if per_u else 0,
        "max_single_z_dimension": int(max(per_z)) if per_z else 0,
        "per_u_dimension_versus_vanishing_of_S_ij": cross_tabulation,
        "per_u_dimension_versus_parity_of_S_ij": parity_tabulation,
        "number_of_annihilator_vectors_of_the_per_z_spans":
            int(len(annihilators)),
        "rank_of_those_annihilators": annihilator_rank,
        "the_ten_per_z_hyperplanes_are_distinct":
            bool(annihilator_rank == DIM and len(annihilators) == DIM),
    }

    record["inputs"] = {
        "notes/2026-08-10-c904-minimal-class-divisor-lattice.sage":
            sha256_of("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage"),
    }

    a_block = record["a_theta3_wedge_lambda"]
    b_block = record["b_h2_h3_channel"]
    c_block = record["c_combined_transfer_lattice"]
    lines = [
        "Sub-B2 Pontryagin transfer into the (1,5) escape group Q_15",
        f"divided powers: integral for k={record['divided_powers']['integrality_verified_for_k']}"
        f"; k! * Theta^[k] = Theta^k verified"
        f"; symplectic-pair build={record['divided_powers']['symplectic_pair_construction']}",
        f"Q_15: septic rank={record['escape_group']['septic_rank']}"
        f"; L_5 divisors={record['escape_group']['elementary_divisors_of_L5']}"
        f"; dim_F2 Q_15={record['escape_group']['f2_dimension_of_Q15']}",
        f"(d) Theta ^ Theta^[2] = 3 Theta^[3]: "
        f"{record['d_control_identity']['theta_wedge_theta2_equals_three_theta3']}"
        f"; after wedging with every basis vector: "
        f"{record['d_control_identity']['identity_holds_after_wedging_with_every_basis_vector']}"
        f"; Theta ^ Theta^[3] = 4 Theta^[4]: "
        f"{record['d_control_identity']['theta_wedge_theta3_equals_four_theta4']}",
        f"(a) 3*(Theta^[3] ^ a) in L_5(^5) over Z for every a: "
        f"{a_block['three_times_class_lies_in_image_of_L5_over_Z_for_every_a']}"
        f"; dim_F2 span in Q_15={a_block['f2_dimension_of_the_span_in_Q15']}",
        f"(b) E(u,z) over {b_block['number_of_pairs']} pairs:"
        f" dim_F2 span in Q_15={b_block['f2_dimension_of_the_span_in_Q15']}"
        f"; is all of Q_15={b_block['span_is_all_of_Q15']}"
        f"; integral rank of the E lattice="
        f"{b_block['integral_rank_of_the_E_lattice']}",
        f"(b-iii) u = Theta subfamily: Theta ^ Theta^[3] = 4 Theta^[4]="
        f"{b_block['u_equals_theta_subfamily']['theta_wedge_theta3_equals_four_theta4']}"
        f"; content gcd="
        f"{b_block['u_equals_theta_subfamily']['content_gcd_of_theta_wedge_theta3']}"
        f"; dim_F2 span="
        f"{b_block['u_equals_theta_subfamily']['f2_dimension_of_the_span_in_Q15']}",
        f"(c) combined transfer lattice: generators={c_block['generator_count']}"
        f" rank={c_block['rank']} divisors={c_block['elementary_divisor_counts']}"
        f"; equals ^7 Lambda={c_block['is_all_of_wedge7']}"
        f"; unhit escape dimension={c_block['escape_dimension_still_unhit']}",
        f"(e) dim span_u [E(u,z)] for each z={record['e_rank_profile']['dimension_of_span_over_u_for_each_z']}",
        f"(e) histogram of dim span_z [E(u,z)] over the 45 u="
        f"{record['e_rank_profile']['histogram_of_dimension_of_span_over_z_for_each_u']}",
        f"(e) per-u dimension vs vanishing of S_ij="
        f"{record['e_rank_profile']['per_u_dimension_versus_vanishing_of_S_ij']}"
        f"; vs parity of S_ij="
        f"{record['e_rank_profile']['per_u_dimension_versus_parity_of_S_ij']}",
        f"(e) the ten per-z hyperplanes are distinct and their annihilators have "
        f"rank {record['e_rank_profile']['rank_of_those_annihilators']}: "
        f"{record['e_rank_profile']['the_ten_per_z_hyperplanes_are_distinct']}",
        "PASS",
    ]
    output = "\n".join(lines) + "\n"

    if json_path:
        with open(json_path, "w", encoding="utf-8") as stream:
            json.dump(canonicalize(record), stream, indent=2, sort_keys=True)
            stream.write("\n")
    if out_path:
        with open(out_path, "w", encoding="utf-8") as stream:
            stream.write(output)
    print(output, end="")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--json")
    parser.add_argument("--out")
    arguments = parser.parse_args()
    main(arguments.json, arguments.out)
