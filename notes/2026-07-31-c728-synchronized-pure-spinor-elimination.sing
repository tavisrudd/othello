// Exact elimination and base-scheme check for C728.
// Run from /home/tavis/src/othello with:
// nix shell nixpkgs#singular --command Singular -q notes/2026-07-31-c728-synchronized-pure-spinor-elimination.sing

ring image_ring=0,(x0,x1,x2,x3,x4,z0,z1,z2,z3,z4,z5),(dp(5),dp(6));

// Translation gauge x5=0.  These are Pf([D_x,C_T])=4 Z_T(x).
poly f0=-4*x2*x3*x4-4*x1*x3*x4+4*x1*x2*x4+4*x1*x2*x3+4*x0*x3*x4-4*x0*x2*x4+4*x0*x2*x3+4*x0*x1*x4-4*x0*x1*x3-4*x0*x1*x2;
poly f1=4*x2*x3*x4-4*x1*x3*x4+4*x1*x2*x4-4*x1*x2*x3+4*x0*x3*x4-4*x0*x2*x4-4*x0*x2*x3-4*x0*x1*x4+4*x0*x1*x3+4*x0*x1*x2;
poly f2=4*x2*x3*x4+4*x1*x3*x4-4*x1*x2*x4-4*x1*x2*x3-4*x0*x3*x4-4*x0*x2*x4+4*x0*x2*x3+4*x0*x1*x4-4*x0*x1*x3+4*x0*x1*x2;
poly f3=-4*x2*x3*x4+4*x1*x3*x4+4*x1*x2*x4-4*x1*x2*x3-4*x0*x3*x4+4*x0*x2*x4+4*x0*x2*x3-4*x0*x1*x4+4*x0*x1*x3-4*x0*x1*x2;
poly f4=4*x2*x3*x4-4*x1*x3*x4-4*x1*x2*x4+4*x1*x2*x3-4*x0*x3*x4+4*x0*x2*x4-4*x0*x2*x3+4*x0*x1*x4+4*x0*x1*x3-4*x0*x1*x2;
poly f5=-4*x2*x3*x4+4*x1*x3*x4-4*x1*x2*x4+4*x1*x2*x3+4*x0*x3*x4+4*x0*x2*x4-4*x0*x2*x3-4*x0*x1*x4-4*x0*x1*x3+4*x0*x1*x2;

ideal graph=z0-f0,z1-f1,z2-f2,z3-f3,z4-f4,z5-f5;
ideal projected=eliminate(graph,x0*x1*x2*x3*x4);
ideal segre=z0+z1+z2+z3+z4+z5,z0^3+z1^3+z2^3+z3^3+z4^3+z5^3;
ideal projected_std=std(projected);
ideal segre_std=std(segre);

ideal projected_mod_segre=simplify(reduce(projected_std,segre_std),2);
ideal segre_mod_projected=simplify(reduce(segre_std,projected_std),2);
if (size(projected_mod_segre) != 0 || size(segre_mod_projected) != 0)
{
  ERROR("projected ideal is not the Segre ideal");
}

setring image_ring;
ring base_ring=0,(x0,x1,x2,x3,x4),dp;
LIB "primdec.lib";

poly f0=imap(image_ring,f0);
poly f1=imap(image_ring,f1);
poly f2=imap(image_ring,f2);
poly f3=imap(image_ring,f3);
poly f4=imap(image_ring,f4);
poly f5=imap(image_ring,f5);
ideal base=f0,f1,f2,f3,f4,f5;
ideal base_std=std(base);
ideal base_radical=radical(base);
ideal base_radical_std=std(base_radical);
ideal base_mod_radical=simplify(reduce(base_std,base_radical_std),2);
ideal radical_mod_base=simplify(reduce(base_radical_std,base_std),2);
if (size(base_mod_radical) != 0 || size(radical_mod_base) != 0)
{
  ERROR("base scheme is not reduced");
}
list components=minAssGTZ(base);
if (size(components) != 15)
{
  ERROR("base scheme does not have 15 components");
}
ideal component_std;
for (int k=1;k<=size(components);k++)
{
  component_std=std(components[k]);
  if (dim(component_std) != 2 || size(component_std) != 3)
  {
    ERROR("a base component is not a codimension-three linear space");
  }
}

print("C728_ELIMINATION_OK");
print("projected_ideal_generators=linear_plus_cubic");
print("base_scheme=reduced_union_of_15_projective_lines");
print("base_projective_degree=15");
quit;
