#!/usr/bin/env sage
"""Exact saturated-NS(F) parity audit for the C904 mixed Fano architecture.

For the actual exotic A5 principal lattice, reconstruct NS(J), use

    alpha(i^*D) = Tr_C(phi_Theta^-1 phi_D) Theta - D,
    alpha(C_inc) = 2 Theta,

and evaluate integral alpha beta gamma Theta^2/2 on generators of the full
Fourier image of NS(F).  Roulleau's theorem says that NS(F) is generated by
i^*NS(J) and C_inc, with 2 C_inc = i^*Theta.
"""

from contextlib import redirect_stdout
from io import StringIO
from itertools import combinations_with_replacement
from math import gcd
import sys


saved_argv = list(sys.argv)
sys.argv = [sys.argv[0], "--export-constants"]
with redirect_stdout(StringIO()):
    load("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage")
sys.argv = saved_argv


def form_dict(matrix_value):
    return {
        (i, j): ZZ(matrix_value[i, j])
        for i in range(matrix_value.nrows())
        for j in range(i + 1, matrix_value.ncols())
        if matrix_value[i, j]
    }


def wedge(left, right):
    result = {}
    for left_indices, left_value in left.items():
        left_set = set(left_indices)
        for right_indices, right_value in right.items():
            if left_set.intersection(right_indices):
                continue
            inversions = sum(
                1 for i in left_indices for j in right_indices if i > j
            )
            indices = tuple(sorted(left_indices + right_indices))
            sign = -1 if inversions % 2 else 1
            result[indices] = (
                result.get(indices, 0) + sign * left_value * right_value
            )
            if not result[indices]:
                del result[indices]
    return result


def divided_by(value, divisor):
    assert all(coefficient % divisor == 0 for coefficient in value.values())
    return {
        indices: coefficient // divisor
        for indices, coefficient in value.items()
    }


def main():
    _, _, basis, theta = principal_lattice("omega", 1)
    positions, linear_map = ns_integrality_matrix(basis)
    _, ns_lattice = congruence_kernel_lattice(linear_map)

    zero = zero_matrix(QQ, 5)
    divisors = []
    for coordinates in ns_lattice.basis_matrix().rows():
        coefficient = coefficient_matrix(coordinates, positions)
        source = block_matrix(
            QQ, [[zero, coefficient], [-coefficient, zero]]
        )
        divisor = basis * source * basis.transpose()
        assert divisor.denominator() == 1
        divisors.append(divisor.change_ring(ZZ))
    assert len(divisors) == 15

    theta_inverse = theta.inverse()
    alpha_forms = []
    for divisor in divisors:
        rational_endomorphism = divisor * theta_inverse
        assert rational_endomorphism.denominator() == 1
        assert rational_endomorphism.trace() % 2 == 0
        analytic_trace = ZZ(rational_endomorphism.trace()) // 2
        alpha_forms.append(analytic_trace * theta - divisor)

    # The missing generator of NS(F)/i^*NS(J) is the incidence class
    # C_inc=i^*Theta/2.  Since [F]=Theta^3/3!,
    # i_*C_inc=2 Theta^4/4!, whose Fourier transform is 2 Theta.
    alpha_forms.append(2 * theta)

    sparse_alphas = [form_dict(value) for value in alpha_forms]
    sparse_theta = form_dict(theta)
    theta_squared_over_two = divided_by(
        wedge(sparse_theta, sparse_theta), 2
    )

    top = tuple(range(10))
    values = []
    for i, j, k in combinations_with_replacement(
        range(len(sparse_alphas)), 3
    ):
        product_value = wedge(
            wedge(
                wedge(sparse_alphas[i], sparse_alphas[j]),
                sparse_alphas[k],
            ),
            theta_squared_over_two,
        )
        values.append(ZZ(product_value.get(top, 0)))

    value_gcd = 0
    for value in values:
        value_gcd = gcd(value_gcd, abs(int(value)))

    assert len(values) == binomial(18, 3)
    assert all(value % 2 == 0 for value in values)
    assert value_gcd == 2

    print("C904 saturated Fano mixed-parity audit")
    print(f"NS(J) rank={len(divisors)}; alpha generators={len(alpha_forms)}")
    print(f"unordered triple products={len(values)}")
    print("odd triple products=0")
    print(f"triple-degree ideal={value_gcd}Z")
    print("PASS")


main()
