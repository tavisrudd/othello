R = Pol([100,125,40,0], 'x);
E = ellinit(ellfromeqn(y^2 - R));
E = ellminimalmodel(E);
gr = ellglobalred(E);
print("m5triv cond=", gr[1], " fact=", factor(gr[1]), " ap=", [[p, ellap(E,p)] | p <- primes(12), gr[1]%p != 0]);
