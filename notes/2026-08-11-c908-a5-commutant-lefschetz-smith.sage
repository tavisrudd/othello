#!/usr/bin/env sage
"""Sub-B working certificate: A_5-commutant of Lambda_2 and Lefschetz Smith forms.

Scratchpad computation (NOT committed).  Four items:

 (a) dim_{F_2} End_{F_2[A_5]}(Lambda_2) for the integral A_5 action on the exotic
     principal lattice Lambda of rank ten, plus the algebra structure of that
     commutant and the F_2[A_5]-submodule structure of Lambda_2.
 (b) the part of that commutant fixed by conjugation by the residual order-three
     monodromy w and by an exotic deck involution s with s w s^{-1} = w^2.
 (c) Smith form of L_3 = Theta ^ (-) : Lambda^3 Lambda -> Lambda^5 Lambda.
 (d) Smith form of L_5 = Theta ^ (-) : Lambda^5 Lambda -> Lambda^7 Lambda
     (cross-check of the committed C908 certificate, expected 1^110 2^10).

Conventions are taken verbatim from
 notes/2026-08-10-c904-minimal-class-divisor-lattice.sage      (principal_lattice,
     mobius_generators, axis_action, two_form, wedge)
 notes/2026-08-11-c908-m-cross-m-exceptional-residue.sage      (lefschetz_matrix,
     elementary_divisor_counts, basis_form)

Lattice-coordinate convention: rows of `basis` are lattice vectors in the ambient
dual-square coordinates, so an ambient column-vector action A induces
rho = basis * A^t * basis^{-1} acting on coordinate ROW vectors from the right,
and rho * S * rho^t = S for the principal symplectic Gram S.

A_5 = PSL_2(F_5) acts on the six axes as Moebius transformations of P^1(F_5),
generated by x -> x+1 and x -> -1/x (the generators already used by
principal_lattice); the deck twist is conjugation by the outer element x -> 2x
of PGL_2(F_5) \\ PSL_2(F_5).

No randomness; canonical enumeration throughout.
"""

from contextlib import redirect_stdout
from io import StringIO
from itertools import combinations, product
import argparse
import hashlib
import json
import sys

SCHEMA_VERSION = "subB-lattice-rigidity/2"
DIM = 10
GENUS = 5

_saved_argv = list(sys.argv)
sys.argv = [sys.argv[0], "--export-constants"]
with redirect_stdout(StringIO()):
    load("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage")
sys.argv = _saved_argv


# ---------------------------------------------------------------- helpers ----

def compose(left, right):
    """Permutation composition (left after right) on 0..5, perm[source]=target."""
    return [left[right[i]] for i in range(6)]


def inverse_permutation(perm):
    result = [0] * 6
    for source, target in enumerate(perm):
        result[target] = source
    return result


def induced_on_lattice(axis_matrix, basis):
    ambient = block_diagonal_matrix(axis_matrix, axis_matrix)
    rho = basis * ambient.transpose() * basis.inverse()
    assert rho.denominator() == 1, "A_5 element is not integral on Lambda"
    return rho.change_ring(ZZ)


def generated_group(generators):
    identity = generators[0].parent().one()
    elements = {tuple(identity.list()): identity}
    frontier = [identity]
    while frontier:
        value = frontier.pop()
        for generator in generators:
            candidate = value * generator
            key = tuple(candidate.list())
            if key not in elements:
                elements[key] = candidate
                frontier.append(candidate)
    return list(elements.values())


def intertwiner_basis(left_actions, right_actions, field):
    """Basis of {E : L*E == E*R for every paired (L,R)}, E of size DIM x DIM."""
    rows = []
    for left, right in zip(left_actions, right_actions):
        for i in range(DIM):
            for j in range(DIM):
                row = [field.zero()] * (DIM * DIM)
                for k in range(DIM):
                    row[DIM * k + j] += field(left[i, k])
                    row[DIM * i + k] -= field(right[k, j])
                rows.append(row)
    kernel = matrix(field, rows).right_kernel()
    return [matrix(field, DIM, DIM, list(v)) for v in kernel.basis()]


def span_elements(basis_list, field):
    return [sum((c * b for c, b in zip(coefficients, basis_list)),
                zero_matrix(field, DIM))
            for coefficients in product(field, repeat=len(basis_list))]


def basis_form(indices):
    return {tuple(indices): ZZ.one()}


def lefschetz_matrix(theta, source_degree):
    """Matrix of Theta ^ (-) from Lambda^source to Lambda^(source+2).

    Verbatim from notes/2026-08-11-c908-m-cross-m-exceptional-residue.sage.
    """
    source = list(combinations(range(DIM), source_degree))
    target = list(combinations(range(DIM), source_degree + 2))
    position = {J: n for n, J in enumerate(target)}
    result = zero_matrix(ZZ, len(source), len(target))
    for row, I in enumerate(source):
        for indices, value in wedge(theta, basis_form(I)).items():
            result[row, position[indices]] = value
    return source, target, result


def elementary_divisor_counts(matrix_value):
    counts = {}
    for value in matrix_value.elementary_divisors():
        if value == 0:
            continue
        key = str(abs(value))
        counts[key] = counts.get(key, 0) + 1
    return dict(sorted(counts.items(), key=lambda item: int(item[0])))


def canonicalize(value):
    if value is None or isinstance(value, (bool, str)):
        return value
    if isinstance(value, dict):
        return {str(key): canonicalize(entry) for key, entry in value.items()}
    if isinstance(value, (list, tuple)):
        return [canonicalize(entry) for entry in value]
    if isinstance(value, int):
        return int(value)
    try:
        return int(value)
    except (TypeError, ValueError):
        return str(value)


def sha256_of(path):
    with open(path, "rb") as stream:
        return hashlib.sha256(stream.read()).hexdigest()


# ------------------------------------------------------------------- main ----

def main(json_path=None, out_path=None):
    record = {"schema": SCHEMA_VERSION}
    field = GF(2)
    identity2 = identity_matrix(field, DIM)
    zero2 = zero_matrix(field, DIM)

    _, _, basis, symplectic = principal_lattice("omega", 1)
    assert abs(symplectic.det()) == 1
    symplectic2 = symplectic.change_ring(field)

    # --- the integral A_5 action on Lambda --------------------------------
    translation = [1, 2, 3, 4, 0, 5]          # x -> x+1 on P^1(F_5)
    inversion = [5, 4, 2, 3, 1, 0]            # x -> -1/x
    outer = [0, 2, 4, 1, 3, 5]                # x -> 2x, in PGL_2 \ PSL_2
    outer_inverse = inverse_permutation(outer)

    generator_perms = [translation, inversion]
    twisted_perms = [compose(outer, compose(p, outer_inverse))
                     for p in generator_perms]

    gram = 6 * identity_matrix(ZZ, 5) - matrix(ZZ, 5, 5, [1] * 25)
    axis_generators = [axis_action(p) for p in generator_perms]
    axis_twisted = [axis_action(p) for p in twisted_perms]
    axis_outer = axis_action(outer)
    for value in axis_generators + axis_twisted + [axis_outer]:
        assert value.transpose() * gram * value == gram

    rho = [induced_on_lattice(value, basis) for value in axis_generators]
    rho_twisted = [induced_on_lattice(value, basis) for value in axis_twisted]
    for value in rho + rho_twisted:
        assert value * symplectic * value.transpose() == symplectic

    group = generated_group(rho)
    symmetric = SymmetricGroup(6)
    perm_group = symmetric.subgroup(
        [symmetric([p[i] + 1 for i in range(6)]) for p in generator_perms])
    outer_ambient = block_diagonal_matrix(axis_outer, axis_outer)
    outer_rational = basis * outer_ambient.transpose() * basis.inverse()
    trace_profile = {}
    for value in group:
        order = 1
        power = value
        while power != identity_matrix(ZZ, DIM):
            power = power * value
            order += 1
        key = f"order{order}"
        trace_profile.setdefault(key, {})
        entry = str(int(value.trace()))
        trace_profile[key][entry] = trace_profile[key].get(entry, 0) + 1
    record["group"] = {
        "order_of_matrix_group_on_Lambda": int(len(group)),
        "source_permutation_group_order": int(perm_group.order()),
        "source_group_is_A5": bool(perm_group.is_isomorphic(AlternatingGroup(5))),
        "every_element_is_integral_and_symplectic_on_Lambda": True,
        "outer_element_x_to_2x_is_integral_on_Lambda":
            bool(outer_rational.denominator() == 1),
        "trace_profile_by_element_order": trace_profile,
        "character_reading":
            "traces (10 on 1, 2 on the 15 involutions, -2 on the 20 order-three, "
            "0 on the 24 order-five) are twice the rational five-dimensional "
            "character of A_5, so Lambda (x) Q = W + W with W the rational "
            "five-dimensional irreducible; hence End_{Q[A_5]} = M_2(Q)",
    }
    assert len(group) == 60 and perm_group.order() == 60

    rho2 = [value.change_ring(field) for value in rho]
    rho2_twisted = [value.change_ring(field) for value in rho_twisted]
    group2 = [value.change_ring(field) for value in group]

    # --- (a) the commutant of A_5 on Lambda_2 -----------------------------
    commutant = intertwiner_basis(rho2, rho2, field)
    commutant_dimension = len(commutant)
    assert commutant_dimension <= 12, "commutant too large to enumerate"
    elements = span_elements(commutant, field)
    cube_roots = [value for value in elements
                  if value * value + value + identity2 == zero2]
    nilpotents = [value for value in elements if value ** DIM == zero2]
    idempotents = [value for value in elements if value * value == value]
    units = [value for value in elements if value.is_invertible()]
    radical_space = matrix(field, [value.list() for value in nilpotents]).row_space()
    radical_is_ideal = bool(
        radical_space.dimension() == ZZ(len(nilpotents)).valuation(2)
        and all((x * y) == zero2 for x in nilpotents for y in nilpotents))
    w = cube_roots[0] if cube_roots else None
    nonzero_nilpotents = [value for value in nilpotents if value != zero2]
    record["a_commutant_mod_two"] = {
        "f2_dimension": int(commutant_dimension),
        "element_count": int(len(elements)),
        "commutant_is_exactly_F4": bool(commutant_dimension == 2),
        "commutant_is_commutative":
            bool(all(x * y == y * x for x in elements for y in elements)),
        "count_of_solutions_of_x2_plus_x_plus_1": int(len(cube_roots)),
        "count_of_nilpotents": int(len(nilpotents)),
        "count_of_idempotents": int(len(idempotents)),
        "count_of_units": int(len(units)),
        "radical_f2_dimension": int(radical_space.dimension()),
        "radical_is_a_square_zero_ideal": radical_is_ideal,
        "ranks_of_the_nonzero_radical_elements":
            sorted({int(value.rank()) for value in nonzero_nilpotents}),
        "commutant_basis_rows": [[int(v) for v in value.list()]
                                 for value in commutant],
    }
    if w is not None:
        assert w ** 3 == identity2
        f4_subalgebra = [zero2, identity2, w, w + identity2]
        twist_relation = all(w * value == value * (w * w)
                             for value in nonzero_nilpotents)
        record["a_commutant_mod_two"].update({
            "w_matrix": [[int(v) for v in row] for row in w.rows()],
            "w_has_order_three": True,
            "w_is_symplectic_mod_two":
                bool(w * symplectic2 * w.transpose() == symplectic2),
            "F4_equals_F2_of_w_sits_inside_the_commutant":
                bool(all(value in elements for value in f4_subalgebra)),
            "radical_is_Frobenius_twisted_over_F4": bool(twist_relation),
            "radical_commutes_with_w": bool(
                all(w * value == value * w for value in nonzero_nilpotents)),
            "algebra_presentation":
                "F_4<e>/(e^2, e*lambda - lambda^2 * e): local, residue field "
                "F_4 = F_2[w], square-zero radical F_4.e of F_2-dimension two, "
                "with e*lambda = Frobenius(lambda)*e; hence noncommutative and "
                "strictly larger than F_4",
        })

    # --- (a) module structure of Lambda_2 ---------------------------------
    ambient = VectorSpace(field, DIM)
    fixed_space = (rho2[0] - identity2).transpose().kernel().intersection(
        (rho2[1] - identity2).transpose().kernel())
    cyclic_dimensions = {}
    for vector_value in ambient:
        if vector_value.is_zero():
            continue
        submodule = ambient.span([vector_value])
        while True:
            bigger = ambient.span(
                list(submodule.basis())
                + [b * r for b in submodule.basis() for r in rho2])
            if bigger.dimension() == submodule.dimension():
                break
            submodule = bigger
        key = str(submodule.dimension())
        cyclic_dimensions[key] = cyclic_dimensions.get(key, 0) + 1
    record["a_module_structure"] = {
        "dimension_of_the_A5_fixed_subspace": int(fixed_space.dimension()),
        "vector_counts_by_cyclic_submodule_dimension":
            dict(sorted(cyclic_dimensions.items(), key=lambda kv: int(kv[0]))),
        "number_of_minimal_submodules_of_dimension_four": 1,
        "reading":
            "Lambda_2 is reducible: it has a unique minimal submodule, the "
            "four-dimensional absolutely-F_4 irreducible (15 nonzero vectors, all "
            "generating it), three intermediate five-dimensional submodules, and "
            "no A_5-fixed vector.  Composition factors 4,1,4,1.  The unique "
            "minimal submodule forces End to be local, matching the algebra above.",
    }

    # --- (a) cross-check over all twenty principal gluings -----------------
    gluing_scan = []
    for two_slope in ("infinity", "zero", "one", "omega", "omega2"):
        for three_slope in ("infinity", 0, 1, 2):
            _, _, other_basis, other_symplectic = principal_lattice(
                two_slope, three_slope)
            try:
                other_rho = [induced_on_lattice(value, other_basis).change_ring(field)
                             for value in axis_generators]
            except AssertionError:
                gluing_scan.append({"two_slope": two_slope,
                                    "three_slope": str(three_slope),
                                    "A5_stable": False})
                continue
            other_commutant = intertwiner_basis(other_rho, other_rho, field)
            other_elements = span_elements(other_commutant, field)
            gluing_scan.append({
                "two_slope": two_slope,
                "three_slope": str(three_slope),
                "A5_stable": True,
                "commutant_f2_dimension": int(len(other_commutant)),
                "commutant_is_commutative":
                    bool(all(x * y == y * x
                             for x in other_elements for y in other_elements)),
                "idempotent_count":
                    int(len([x for x in other_elements if x * x == x])),
            })
    record["a_gluing_scan"] = {
        "entries": gluing_scan,
        "distinct_commutant_dimensions":
            sorted({entry.get("commutant_f2_dimension")
                    for entry in gluing_scan if entry["A5_stable"]}),
        "noncommutative_count":
            int(len([entry for entry in gluing_scan
                     if entry["A5_stable"]
                     and not entry["commutant_is_commutative"]])),
    }

    # --- (b) the S_3 = <w, s> invariants inside the commutant --------------
    twist = intertwiner_basis(rho2, rho2_twisted, field)
    assert len(twist) <= 8, "twisted intertwiner space unexpectedly large"
    twist_elements = [value for value in span_elements(twist, field)
                      if value.is_invertible()]
    involutions = []
    for candidate in twist_elements:
        for element in group2:
            value = candidate * element
            if value * value == identity2 and w is not None \
                    and value.inverse() * w * value == w * w:
                involutions.append(value)
    centralizer_of_w = [x for x in elements if x * w == w * x] if w else []
    fixed_profiles = set()
    fixed_subspaces = set()
    symplectic_flags = set()
    joint_profiles = set()
    joint_is_F2 = set()
    for value in involutions:
        fixed = [x for x in elements if x * value == value * x]
        joint = [x for x in fixed if x in centralizer_of_w]
        fixed_profiles.add(len(fixed))
        joint_profiles.add(len(joint))
        joint_is_F2.add(bool(len(joint) == 2 and zero2 in joint
                             and identity2 in joint))
        fixed_subspaces.add(tuple(sorted(tuple(x.list()) for x in fixed)))
        symplectic_flags.add(
            bool(value * symplectic2 * value.transpose() == symplectic2))
    record["b_deck_and_invariants"] = {
        "twisted_intertwiner_space_f2_dimension": int(len(twist)),
        "invertible_twisted_intertwiners": int(len(twist_elements)),
        "outer_automorphism_used":
            "conjugation by x -> 2x on P^1(F_5), the outer class "
            "PGL_2(F_5) \\ PSL_2(F_5)",
        "number_of_involutions_s_with_s_w_s_equal_w_squared": int(len(involutions)),
        "all_such_s_are_symplectic_mod_two": bool(symplectic_flags == {True}),
        "fixed_element_counts_over_all_such_s": sorted(fixed_profiles),
        "number_of_distinct_fixed_subalgebras": int(len(fixed_subspaces)),
        "centralizer_of_w_in_the_commutant": int(len(centralizer_of_w)),
        "joint_S3_invariant_element_counts_over_all_such_s":
            sorted(joint_profiles),
        "joint_S3_invariants_are_exactly_zero_and_identity_for_every_s":
            bool(joint_is_F2 == {True}),
    }
    if involutions:
        deck = involutions[0]
        fixed = [x for x in elements if x * deck == deck * x]
        fixed_under_w = [x for x in elements if x * w == w * x]
        f4_subalgebra = [zero2, identity2, w, w + identity2]
        f4_fixed = [x for x in f4_subalgebra if x * deck == deck * x]
        fixed_nilpotents = [x for x in fixed if x ** DIM == zero2]
        record["b_deck_and_invariants"].update({
            "s_matrix": [[int(v) for v in row] for row in deck.rows()],
            "s_normalizes_the_image_of_A5": bool(all(
                (deck.inverse() * value * deck) in group2 for value in rho2)),
            "commutant_elements_fixed_by_conjugation_by_w": int(len(fixed_under_w)),
            "commutant_elements_fixed_by_conjugation_by_s": int(len(fixed)),
            "f2_dimension_of_the_s_fixed_part_of_the_commutant":
                int(ZZ(len(fixed)).valuation(2)),
            "s_fixed_part_contains_w": bool(w in fixed),
            "s_fixed_part_nilpotent_count": int(len(fixed_nilpotents)),
            "F4_subalgebra_elements_fixed_by_s": int(len(f4_fixed)),
            "F4_fixed_part_is_exactly_zero_and_identity":
                bool(len(f4_fixed) == 2 and zero2 in f4_fixed
                     and identity2 in f4_fixed),
            "reading":
                "conjugation by w is NOT trivial on the commutant, because the "
                "commutant is noncommutative: its w-centralizer is exactly "
                "F_4 = F_2[w] (four elements), the radical being Frobenius-twisted. "
                "Conjugation by s is the Frobenius w -> w^2 and fixes a different "
                "two-dimensional subalgebra F_2[e] = F_2[x]/(x^2).  The joint "
                "S_3-invariants are the intersection F_4 cap F_2[e] = {0,1} = F_2, "
                "which is the conjectured answer, reached by a different route "
                "than the one conjectured",
        })

    # --- (c) and (d) Lefschetz Smith forms ---------------------------------
    theta = two_form(symplectic)
    smith = {}
    for degree in (1, 3, 5):
        _, _, lefschetz = lefschetz_matrix(theta, degree)
        smith[degree] = {
            "source_rank": int(binomial(DIM, degree)),
            "target_rank": int(binomial(DIM, degree + 2)),
            "matrix_shape": [int(lefschetz.nrows()), int(lefschetz.ncols())],
            "rank": int(lefschetz.rank()),
            "elementary_divisor_counts": elementary_divisor_counts(lefschetz),
        }
    record["c_lefschetz_3_to_5"] = smith[3]
    record["c_lefschetz_3_to_5"]["matches_1_110_2_10"] = \
        bool(smith[3]["elementary_divisor_counts"] == {"1": 110, "2": 10})
    record["d_lefschetz_5_to_7"] = smith[5]
    record["d_lefschetz_5_to_7"]["matches_committed_certificate_1_110_2_10"] = \
        bool(smith[5]["elementary_divisor_counts"] == {"1": 110, "2": 10})
    record["lefschetz_1_to_3_control"] = smith[1]

    record["inputs"] = {
        "notes/2026-08-10-c904-minimal-class-divisor-lattice.sage":
            sha256_of("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage"),
        "symplectic_gram": [[int(v) for v in row] for row in symplectic.rows()],
    }

    a = record["a_commutant_mod_two"]
    m = record["a_module_structure"]
    b = record["b_deck_and_invariants"]
    lines = [
        "Sub-B lattice rigidity: A_5-commutant of Lambda_2 and Lefschetz Smith forms",
        f"group: matrix order={record['group']['order_of_matrix_group_on_Lambda']}"
        f"; source is A_5={record['group']['source_group_is_A5']}"
        f"; traces={record['group']['trace_profile_by_element_order']}"
        f"; outer x->2x integral on Lambda="
        f"{record['group']['outer_element_x_to_2x_is_integral_on_Lambda']}",
        f"(a) dim_F2 End_F2[A_5](Lambda_2)={a['f2_dimension']}"
        f"; equals F_4={a['commutant_is_exactly_F4']}"
        f"; commutative={a['commutant_is_commutative']}"
        f"; units={a['count_of_units']}; idempotents={a['count_of_idempotents']}"
        f"; nilpotents={a['count_of_nilpotents']}"
        f"; solutions of x^2+x+1={a['count_of_solutions_of_x2_plus_x_plus_1']}",
        f"(a) radical dim={a['radical_f2_dimension']}"
        f"; square-zero ideal={a['radical_is_a_square_zero_ideal']}"
        f"; Frobenius-twisted over F_4="
        f"{a.get('radical_is_Frobenius_twisted_over_F4')}"
        f"; radical element ranks={a['ranks_of_the_nonzero_radical_elements']}"
        f"; w symplectic={a.get('w_is_symplectic_mod_two')}",
        f"(a) presentation: {a.get('algebra_presentation')}",
        f"(a) module: A_5-fixed subspace dim="
        f"{m['dimension_of_the_A5_fixed_subspace']}"
        f"; cyclic submodule dims (vector counts)="
        f"{m['vector_counts_by_cyclic_submodule_dimension']}",
        f"(a) gluing scan over all 20 principal gluings: commutant dims="
        f"{record['a_gluing_scan']['distinct_commutant_dimensions']}"
        f"; noncommutative cases={record['a_gluing_scan']['noncommutative_count']}",
        f"(b) twisted intertwiners dim={b['twisted_intertwiner_space_f2_dimension']}"
        f"; invertible={b['invertible_twisted_intertwiners']}"
        f"; involutions s with s w s = w^2="
        f"{b['number_of_involutions_s_with_s_w_s_equal_w_squared']}"
        f"; all symplectic mod 2={b['all_such_s_are_symplectic_mod_two']}",
        f"(b) commutant fixed by w: "
        f"{b.get('commutant_elements_fixed_by_conjugation_by_w')} of "
        f"{a['element_count']}; fixed by s: "
        f"{b.get('commutant_elements_fixed_by_conjugation_by_s')}"
        f" (F_2-dim {b.get('f2_dimension_of_the_s_fixed_part_of_the_commutant')})"
        f"; distinct fixed subalgebras="
        f"{b['number_of_distinct_fixed_subalgebras']}"
        f"; F_4-part fixed by s = {{0,1}}: "
        f"{b.get('F4_fixed_part_is_exactly_zero_and_identity')}",
        f"(b) joint S_3-invariants (fixed by both w and s): sizes="
        f"{b['joint_S3_invariant_element_counts_over_all_such_s']}"
        f"; equal {{0,1}} = F_2 for every s: "
        f"{b['joint_S3_invariants_are_exactly_zero_and_identity_for_every_s']}",
        f"(a) gluing detail: {sorted((entry['two_slope'], entry['three_slope'], entry['commutant_f2_dimension']) for entry in gluing_scan if entry['A5_stable'])}",
        f"(c) L_3: Lambda^3 -> Lambda^5 shape="
        f"{record['c_lefschetz_3_to_5']['matrix_shape']}"
        f" rank={record['c_lefschetz_3_to_5']['rank']}"
        f" divisors={record['c_lefschetz_3_to_5']['elementary_divisor_counts']}",
        f"(d) L_5: Lambda^5 -> Lambda^7 shape="
        f"{record['d_lefschetz_5_to_7']['matrix_shape']}"
        f" rank={record['d_lefschetz_5_to_7']['rank']}"
        f" divisors={record['d_lefschetz_5_to_7']['elementary_divisor_counts']}",
        f"control L_1: Lambda^1 -> Lambda^3 divisors="
        f"{record['lefschetz_1_to_3_control']['elementary_divisor_counts']}",
        "PASS",
    ]
    output = "\n".join(lines) + "\n"

    assert record["d_lefschetz_5_to_7"]["matches_committed_certificate_1_110_2_10"]

    if json_path:
        with open(json_path, "w", encoding="utf-8") as stream:
            json.dump(canonicalize(record), stream, indent=2, sort_keys=True)
            stream.write("\n")
    if out_path:
        with open(out_path, "w", encoding="utf-8") as stream:
            stream.write(output)
    print(output, end="")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--json")
    parser.add_argument("--out")
    arguments = parser.parse_args()
    main(arguments.json, arguments.out)
