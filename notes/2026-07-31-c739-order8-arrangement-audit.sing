// Exact irreducibility and interior-smoothness audit for one C739 Paley section.

LIB "elim.lib";
ring r=0,(x0,x1,x2,x3,x4,x5,x6,x7),dp;

poly f=
 -x0*x1*x2*x4+x0*x1*x3*x4-x0*x2*x3*x5+x1*x2*x3*x5
 +x0*x2*x4*x5-x1*x3*x4*x5+x0*x1*x2*x6-x1*x2*x3*x6
 -x0*x3*x4*x6+x2*x3*x4*x6-x0*x1*x5*x6+x0*x3*x5*x6
 +x1*x4*x5*x6-x2*x4*x5*x6-x0*x1*x3*x7+x0*x2*x3*x7
 +x1*x2*x4*x7-x2*x3*x4*x7+x0*x1*x5*x7-x1*x2*x5*x7
 -x0*x4*x5*x7+x3*x4*x5*x7-x0*x2*x6*x7+x1*x3*x6*x7
 +x0*x4*x6*x7-x1*x4*x6*x7+x2*x5*x6*x7-x3*x5*x6*x7;

list full_factor=factorize(f);
poly pair_collision=subst(f,x1,x0);
list pair_factor=factorize(pair_collision);
poly triple_collision=subst(pair_collision,x2,x0);
poly triple_expected=-(x3-x0)*(x5-x0)*(x6-x4)*(x7-x0);

if (size(full_factor[1])!=2 || full_factor[2][2]!=1)
{
  ERROR("Paley quartic is unexpectedly reducible");
}
if (size(pair_factor[1])!=2 || pair_factor[2][2]!=1)
{
  ERROR("pair-collision restriction is unexpectedly reducible");
}
if (triple_collision-triple_expected!=0)
{
  ERROR("unexpected triple-collision factorization");
}

// Fix three distinct ordered points to 0, 1, -1.  This is a quotient chart.
// Its Jacobian scheme has six points in the affine closure, all removed after
// saturation by the collision discriminant.
ring q=0,(x3,x4,x5,x6,x7),dp;
poly section=
 -x3*x4*x5*x7+x3*x5*x6*x7+x3*x4*x5+x3*x4*x6
 -2*x4*x5*x6-x3*x4*x7-x3*x6*x7+x4*x6*x7+x5*x6*x7
 +x3*x5-x3*x6+x4*x7-x5*x7;
ideal singular_scheme=section,jacob(section);
ideal singular_std=std(singular_scheme);
poly collision_discriminant=
 (x3)*(x3-1)*(x3+1)*(x4)*(x4-1)*(x4+1)
 *(x5)*(x5-1)*(x5+1)*(x6)*(x6-1)*(x6+1)
 *(x7)*(x7-1)*(x7+1)
 *(x3-x4)*(x3-x5)*(x3-x6)*(x3-x7)
 *(x4-x5)*(x4-x6)*(x4-x7)
 *(x5-x6)*(x5-x7)*(x6-x7);
ideal interior_singular=sat(singular_scheme,collision_discriminant)[1];
ideal interior_std=std(interior_singular);

if (dim(singular_std)!=0 || vdim(singular_std)!=6)
{
  ERROR("unexpected singular scheme in the quotient-chart closure");
}
if (size(interior_std)!=1 || interior_std[1]!=1)
{
  ERROR("Paley section is unexpectedly singular on M_0,8");
}

print("C739_ORDER8_ARRANGEMENT_CAS_AUDIT_OK");
print("primitive_Paley_section=irreducible");
print("pair_collision_restriction=irreducible");
print("triple_collision_restriction=four_linear_factors");
print("interior_hyperplane_section=smooth");
quit;
