#!/usr/bin/env sage
"""Exact A5-invariant divisor and degree-one twist lattice for C904.

This checks the two finite lattices used in the universal-sheaf parity wall:
the invariant part of the actual rank-15 NS lattice of the exotic ppav, and
the reductions of the integral degree-one twist-invariant determinant
combinations for ranks (0,0,2,3).
"""

from contextlib import redirect_stdout
from io import StringIO
from itertools import combinations
import sys


_saved_argv = list(sys.argv)
sys.argv = [sys.argv[0], "--export-constants"]
with redirect_stdout(StringIO()):
    load("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage")
sys.argv = _saved_argv

PAIRS = list(combinations(range(10), 2))


def ns_action(generator, positions, ns_basis):
    rows = []
    for coordinates in ns_basis.rows():
        coefficient = coefficient_matrix(coordinates, positions)
        image = generator.transpose() * coefficient * generator
        image_coordinates = vector(ZZ, [image[i, j] for i, j in positions])
        ns_coordinates = ns_basis.solve_left(image_coordinates)
        assert ns_coordinates.denominator() == 1
        rows.append(vector(ZZ, ns_coordinates))
    return matrix(ZZ, rows)


def induced_principal(basis, generator):
    ambient = block_diagonal_matrix(generator, generator)
    induced = basis * ambient.transpose() * basis.inverse()
    assert induced.denominator() == 1
    return induced.change_ring(ZZ)


def wedge_action(linear):
    columns = []
    for source_i, source_j in PAIRS:
        form = zero_matrix(ZZ, 10)
        form[source_i, source_j] = 1
        form[source_j, source_i] = -1
        image = linear * form * linear.transpose()
        columns.append(vector(ZZ, [image[i, j] for i, j in PAIRS]))
    return matrix(ZZ, columns).transpose()


def main():
    gram, _, basis, symplectic = principal_lattice("omega", 1)
    positions, linear_map = ns_integrality_matrix(basis)
    _, ns_lattice = congruence_kernel_lattice(linear_map)
    ns_basis = ns_lattice.basis_matrix().LLL()
    assert ns_basis.nrows() == 15

    actions = [ns_action(generator, positions, ns_basis)
               for generator in mobius_generators()]
    equations = block_matrix(ZZ, len(actions), 1,
                             [action.transpose() - identity_matrix(ZZ, 15)
                              for action in actions])
    fixed = equations.right_kernel()
    assert fixed.rank() == 1
    fixed_generator = vector(ZZ, fixed.basis_matrix().row(0))

    theta_ambient = vector(ZZ, [gram[i, j] for i, j in positions])
    theta_coordinates = vector(ZZ, ns_basis.solve_left(theta_ambient))
    assert theta_coordinates.denominator() == 1
    assert gcd(theta_coordinates) == 1
    assert theta_coordinates in fixed
    multiplier = fixed.basis_matrix().solve_left(theta_coordinates)
    assert multiplier.denominator() == 1 and abs(ZZ(multiplier[0])) == 1

    # Stronger topological check: the full integral H^2 invariant lattice,
    # not only its algebraic rank-15 sublattice, is generated by Theta.
    h1_actions = [induced_principal(basis, generator)
                  for generator in mobius_generators()]
    h2_actions = [wedge_action(action) for action in h1_actions]
    h2_equations = block_matrix(
        ZZ, len(h2_actions), 1,
        [action - identity_matrix(ZZ, 45)
         for action in h2_actions],
    )
    h2_fixed = h2_equations.right_kernel()
    assert h2_fixed.rank() == 1
    theta_h2 = vector(ZZ, [symplectic[i, j] for i, j in PAIRS])
    assert gcd(theta_h2) == 1 and theta_h2 in h2_fixed
    h2_multiplier = h2_fixed.basis_matrix().solve_left(theta_h2)
    assert h2_multiplier.denominator() == 1 and abs(ZZ(h2_multiplier[0])) == 1

    # Integral degree-one invariants are ker(0,0,2,3).  Their reductions
    # exhaust the mod-two invariant kernel ker(0,0,0,1).
    ranks = matrix(ZZ, 1, 4, [0, 0, 2, 3])
    integral_twist_kernel = ranks.right_kernel()
    assert integral_twist_kernel.rank() == 3
    reduced = span(GF(2), [vector(GF(2), row)
                           for row in integral_twist_kernel.basis_matrix().rows()])
    mod_two_kernel = matrix(GF(2), 1, 4, [0, 0, 0, 1]).right_kernel()
    assert reduced == mod_two_kernel and reduced.dimension() == 3

    print("C904 universal determinant divisor invariant audit")
    print(f"rank NS(J)={ns_basis.nrows()}; rank NS(J)^A5={fixed.rank()}")
    print("NS(J)^A5=Z*Theta and Theta is primitive: PASS")
    print("H^2(J,Z)^A5=Z*Theta integrally: PASS")
    print(f"integral degree-one twist kernel basis={list(integral_twist_kernel.basis_matrix().rows())}")
    print("reduction maps integral twist kernel onto full mod-2 invariant space: PASS")
    print("on M, H^2(M,Z)=f^*H^2(J,Z) direct_sum Z*e; hence <h,e> is saturated")
    print("PASS")


if __name__ == "__main__":
    main()
