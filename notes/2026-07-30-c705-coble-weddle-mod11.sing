ring r=11,(z0,z1,z2,z3),dp;
poly F =
  566*z0^3*z1 - 44*z0^3*z2 + 241*z0^3*z3
  - 250*z0*z1^3 - 545*z0*z1*z2*z3
  - 250*z0*z2^3 - 250*z0*z3^3
  + 44*z1^3*z2 + 241*z1^3*z3
  + 566*z1*z2^3 - 566*z1*z3^3
  - 241*z2^3*z3 - 44*z2*z3^3;
list L = factorize(F);
if (size(L[1]) != 2)
{
  ERROR("expected unit and one nonconstant factor");
}
if ((deg(L[1][1]) != 0) || (deg(L[1][2]) != 4))
{
  ERROR("expected factor degrees 0 and 4");
}
if ((L[2][1] != 1) || (L[2][2] != 1))
{
  ERROR("expected both multiplicities to be one");
}
"PASS mod-11 irreducibility certificate: one primitive quartic factor";

ring s=7,(z0,z1,z2,z3),dp;
poly F7 =
  566*z0^3*z1 - 44*z0^3*z2 + 241*z0^3*z3
  - 250*z0*z1^3 - 545*z0*z1*z2*z3
  - 250*z0*z2^3 - 250*z0*z3^3
  + 44*z1^3*z2 + 241*z1^3*z3
  + 566*z1*z2^3 - 566*z1*z3^3
  - 241*z2^3*z3 - 44*z2*z3^3;
list L7 = factorize(F7);
if (size(L7[1]) != 5)
{
  ERROR("expected unit and four linear factors modulo 7");
}
if ((deg(L7[1][1]) != 0)
    || (deg(L7[1][2]) != 1)
    || (deg(L7[1][3]) != 1)
    || (deg(L7[1][4]) != 1)
    || (deg(L7[1][5]) != 1))
{
  ERROR("expected factor degrees 0,1,1,1,1 modulo 7");
}
"PASS parameter-specific mod-7 split: four linear factors";
quit;
