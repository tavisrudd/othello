#!/usr/bin/env sage
"""Relative divisor-generation check for the exotic A5 cubic quotient.

This imports the exact principal-lattice construction and tests whether the
full integral Neron--Severi lattice is generated by pullbacks of the relative
principal theta bundle along integral A5-group-ring endomorphisms.  Such
pullbacks are honest relative line bundles, so equality removes a possible
relative Picard obstruction from the minimal-class argument.
"""

from contextlib import redirect_stdout
from io import StringIO
import sys

_saved_argv = list(sys.argv)
sys.argv = [sys.argv[0], "--export-constants"]
with redirect_stdout(StringIO()):
    load("notes/2026-08-10-c904-minimal-class-divisor-lattice.sage")
sys.argv = _saved_argv


def induced_action(source_action, basis, symplectic):
    """Integral action in the row-basis convention used by the certificate."""
    ambient = block_diagonal_matrix(source_action, source_action)
    candidate = basis * ambient.transpose() * basis.inverse()
    assert candidate.denominator() == 1
    candidate = candidate.change_ring(ZZ)
    assert candidate * symplectic * candidate.transpose() == symplectic
    return candidate


def pullback_theta_form(endomorphism, symplectic):
    return endomorphism * symplectic * endomorphism.transpose()


def ns_coordinates(form, linear_map, ns_basis):
    coefficients = linear_map.solve_right(vector(QQ, form.list()))
    assert linear_map * coefficients == vector(QQ, form.list())
    coordinates = ns_basis.solve_left(coefficients)
    assert coordinates.denominator() == 1
    return vector(ZZ, coordinates)


def full_endomorphism_lattice(basis):
    """Generic endomorphisms of the quotient inside M_5(Q).

    The principal lattice lies between the six-axis source and its one-sixth
    dilation, so it suffices to search coefficient matrices in (1/6)M_5(Z).
    """
    columns = []
    for i in range(5):
        for j in range(5):
            coefficient = zero_matrix(QQ, 5)
            coefficient[i, j] = QQ(1) / 6
            ambient = block_diagonal_matrix(coefficient, coefficient)
            induced = basis * ambient.transpose() * basis.inverse()
            columns.append(vector(QQ, induced.list()))
    linear_map = matrix(QQ, columns).transpose()
    denominator, scaled_lattice = congruence_kernel_lattice(linear_map)
    assert scaled_lattice.rank() == 25
    endomorphisms = []
    for scaled in scaled_lattice.basis_matrix().LLL().rows():
        coefficient = matrix(QQ, 5, 5, list(scaled)) / 6
        ambient = block_diagonal_matrix(coefficient, coefficient)
        induced = basis * ambient.transpose() * basis.inverse()
        assert induced.denominator() == 1
        endomorphisms.append(induced.change_ring(ZZ))
    return denominator, scaled_lattice, endomorphisms


def theta_pullback_index(endomorphisms, symplectic, linear_map, ns_basis):
    candidates = list(endomorphisms)
    for left_index in range(len(endomorphisms)):
        for right_index in range(left_index + 1, len(endomorphisms)):
            candidates.append(endomorphisms[left_index] + endomorphisms[right_index])

    rows = []
    seen = set()
    best = None
    for endomorphism in candidates:
        form = pullback_theta_form(endomorphism, symplectic)
        key = tuple(form.list())
        if key in seen:
            continue
        seen.add(key)
        rows.append(ns_coordinates(form, linear_map, ns_basis))
        lattice = span(ZZ, rows)
        if lattice.rank() == 15:
            index = lattice.index_in(ZZ ** 15)
            if best is None or index < best:
                best = index
            if index == 1:
                return index, len(rows), lattice
    return best, len(rows), span(ZZ, rows)


def symmetric_positions_matrix(coordinates, positions):
    value = zero_matrix(ZZ, 5)
    for coefficient, (i, j) in zip(coordinates, positions):
        value[i, j] = coefficient
        value[j, i] = coefficient
    return value


def axis_poincare_lattice(gram, positions):
    """Pullbacks of NS(E^5) through the five independent axis quotients."""
    rows = []
    for index in range(len(positions)):
        coordinates = vector(ZZ, [1 if j == index else 0
                                  for j in range(len(positions))])
        product_form = symmetric_positions_matrix(coordinates, positions)
        source_form = gram * product_form * gram
        rows.append(vector(ZZ, [source_form[i, j] for i, j in positions]))
    return span(ZZ, rows)


def quotient_invariants(sub_lattice, super_lattice):
    coordinates = matrix(
        ZZ,
        [super_lattice.coordinate_vector(row)
         for row in sub_lattice.basis_matrix().rows()],
    )
    diagonal = coordinates.smith_form(transformation=False).diagonal()
    return tuple(abs(value) for value in diagonal if abs(value) != 1)


def missing_parity_module(axis_generators, positions, ns_basis,
                          relative_coordinate_lattice):
    field = GF(2)
    missing_dual = matrix(
        field, relative_coordinate_lattice.basis_matrix()
    ).right_kernel()
    assert missing_dual.dimension() == 4
    kernel_basis = matrix(field, missing_dual.basis())

    representations = []
    for generator in axis_generators:
        image_rows = []
        for coefficient_row in ns_basis.rows():
            coefficient = coefficient_matrix(coefficient_row, positions)
            image = generator.transpose() * coefficient * generator
            image_coordinates = vector(
                ZZ, [image[i, j] for i, j in positions]
            )
            ns_coordinates_row = ns_basis.solve_left(image_coordinates)
            assert ns_coordinates_row.denominator() == 1
            image_rows.append(vector(ZZ, ns_coordinates_row))
        ns_action = matrix(field, image_rows)

        quotient_rows = []
        for functional in kernel_basis.rows():
            image_functional = functional * ns_action.transpose()
            quotient_coordinates = kernel_basis.solve_left(image_functional)
            quotient_rows.append(quotient_coordinates)
        representations.append(matrix(field, quotient_rows))

    fixed_rows = []
    identity = identity_matrix(field, 4)
    for representation in representations:
        fixed_rows.extend((representation - identity).rows())
    fixed_dimension = matrix(field, fixed_rows).right_kernel().dimension()
    commutant_dimension = len(commutant_basis(representations))

    heart = [quotient_action(generator, 2) for generator in axis_generators]
    equation_rows = []
    for source, target in zip(representations, heart):
        for i in range(4):
            for j in range(4):
                equation = [field.zero()] * 16
                for k in range(4):
                    equation[4 * k + j] += source[i, k]
                    equation[4 * i + k] -= target[k, j]
                equation_rows.append(equation)
    intertwiners = matrix(field, equation_rows).right_kernel().basis()
    isomorphic_to_heart = any(
        matrix(field, 4, 4, list(value)).is_invertible()
        for value in intertwiners
    )
    return fixed_dimension, commutant_dimension, isomorphic_to_heart


def exotic_deck_check(gram, omega, basis, symplectic):
    """The literal order-two outer deck involution exchanges omega and omega^2."""
    deck_permutation = (5, 2, 1, 4, 3, 0)  # x |-> 2/x on P^1(F_5)
    deck = axis_action(deck_permutation)
    assert deck * deck == identity_matrix(ZZ, 5)
    assert deck.det() == -1
    assert deck.transpose() * gram * deck == gram

    group = generated_axis_group()
    group_keys = {tuple(value.list()) for value in group}
    assert tuple(deck.list()) not in group_keys
    assert all(tuple((deck * value * deck).list()) in group_keys for value in group)

    deck_heart = quotient_action(deck, 2)
    assert deck_heart * omega * deck_heart.inverse() == (
        omega + identity_matrix(GF(2), 4)
    )

    _, _, conjugate_basis, conjugate_symplectic = principal_lattice("omega2", 1)
    ambient = block_diagonal_matrix(deck, deck)
    transition = basis * ambient.transpose() * conjugate_basis.inverse()
    assert transition.denominator() == 1
    transition = transition.change_ring(ZZ)
    assert abs(transition.det()) == 1
    assert transition * conjugate_symplectic * transition.transpose() == symplectic
    return deck_permutation


def main():
    gram, omega, basis, symplectic = principal_lattice()
    positions, linear_map = ns_integrality_matrix(basis)
    _, ns_lattice = congruence_kernel_lattice(linear_map)
    ns_basis = ns_lattice.basis_matrix().LLL()

    print("exotic deck permutation", exotic_deck_check(gram, omega, basis, symplectic),
          "exchanges omega and omega^2")

    group = generated_axis_group()
    actions = [induced_action(value, basis, symplectic) for value in group]
    assert len({tuple(value.list()) for value in actions}) == 60

    # Every f in the integral group ring is a relative endomorphism.  Search
    # theta pullbacks for short sums of group elements, growing the generated
    # Neron--Severi lattice until its rank and index stabilize.
    identity = identity_matrix(ZZ, 10)
    endomorphisms = [identity]
    endomorphisms.extend(actions)
    endomorphisms.extend(identity + value for value in actions)
    for left_index in range(len(actions)):
        for right_index in range(left_index + 1, len(actions)):
            endomorphisms.append(actions[left_index] + actions[right_index])

    rows = []
    seen = set()
    best = None
    for endomorphism in endomorphisms:
        form = pullback_theta_form(endomorphism, symplectic)
        key = tuple(form.list())
        if key in seen:
            continue
        seen.add(key)
        rows.append(ns_coordinates(form, linear_map, ns_basis))
        lattice = span(ZZ, rows)
        if lattice.rank() == 15:
            index = lattice.index_in(span(ZZ, identity_matrix(ZZ, 15).rows()))
            if best is None or index < best:
                best = index
                print("rank 15 index", index, "after", len(rows), "theta pullbacks")
            if index == 1:
                break

    print("A5 group-ring theta-pullback index", best)
    assert best == 16

    end_denominator, end_lattice, full_endomorphisms = full_endomorphism_lattice(basis)
    print("full endomorphism congruence denominator", end_denominator)
    print("full endomorphism scaled-lattice index", end_lattice.index_in(ZZ ** 25))
    full_index, full_count, relative_coordinate_lattice = theta_pullback_index(
        full_endomorphisms, symplectic, linear_map, ns_basis
    )
    print("full endomorphism theta-pullback index", full_index,
          "after", full_count, "distinct pullbacks")
    assert full_index == 16

    relative_ns_lattice = span(
        ZZ,
        [row * ns_basis for row in relative_coordinate_lattice.basis_matrix().rows()],
    )
    print("missing divisor quotient invariants",
          quotient_invariants(relative_ns_lattice, ns_lattice))
    assert quotient_invariants(relative_ns_lattice, ns_lattice) == (2, 2, 2, 2)
    print("relative divisor coordinates in the fixed NS basis=")
    print(relative_coordinate_lattice.basis_matrix().LLL())
    parity_fixed, parity_commutant, parity_is_heart = missing_parity_module(
        mobius_generators(), positions, ns_basis, relative_coordinate_lattice
    )
    print("missing parity A5-module fixed dimension", parity_fixed,
          "commutant dimension", parity_commutant,
          "is six-point heart", parity_is_heart)
    assert parity_fixed == 0 and parity_commutant == 2 and parity_is_heart

    (relative_products, relative_saturation, _, relative_order,
     relative_product_count, _, _, _, _) = divisor_product_lattice(
        basis, symplectic, positions, relative_ns_lattice, find_identity=False
    )
    print("relative divisor products", relative_product_count,
          "rank", relative_products.rank(),
          "saturation index", relative_products.index_in(relative_saturation),
          "minimal order", relative_order)
    assert relative_products.rank() == 15
    print("relative product quotient invariants",
          quotient_invariants(relative_products, relative_saturation))

    axis_lattice = axis_poincare_lattice(gram, positions)
    assert all(row in ns_lattice for row in axis_lattice.basis_matrix().rows())
    axis_index = axis_lattice.index_in(ns_lattice)
    (axis_products, axis_saturation, _, axis_order, axis_product_count,
     _, _, _, _) = divisor_product_lattice(
        basis, symplectic, positions, axis_lattice, find_identity=False
    )
    print("axis-Poincare NS index", axis_index,
          "products", axis_product_count,
          "rank", axis_products.rank(),
          "saturation index", axis_products.index_in(axis_saturation),
          "minimal order", axis_order)

    combined_lattice = span(
        ZZ,
        list(relative_ns_lattice.basis_matrix().rows())
        + list(axis_lattice.basis_matrix().rows()),
    )
    combined_index = combined_lattice.index_in(ns_lattice)
    (combined_products, combined_saturation, _, combined_order,
     combined_product_count, _, _, _, _) = divisor_product_lattice(
        basis, symplectic, positions, combined_lattice, find_identity=False
    )
    print("combined visible NS index", combined_index,
          "products", combined_product_count,
          "rank", combined_products.rank(),
          "saturation index", combined_products.index_in(combined_saturation),
          "minimal order", combined_order)
    print("PASS")
    print("PASS")


if __name__ == "__main__":
    main()
